{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="admin-scope">
    {% include 'admin_nav_bar/index.html.twig' %}
    <div class="admin-main-content p-4">
        <h1 class="mb-4">Historique des événements et participations</h1>

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <select name="entityType" class="form-select">
                    <option value="">Type (tous)</option>
                    <option value="event" {{ entityType == 'event' ? 'selected' : '' }}>Event</option>
                    <option value="participation" {{ entityType == 'participation' ? 'selected' : '' }}>Participation</option>
                </select>
            </div>
            <div class="col-md-4">
                <input name="action" value="{{ action|default('') }}" class="form-control" placeholder="Action (create/update/delete/register/cancel)">
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button class="btn btn-primary">Filtrer</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_admin_history') }}">Reset</a>
            </div>
        </form>

        <div class="table-responsive bg-white rounded-3 shadow-sm p-3">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Action</th>
                    <th>Event</th>
                    <th>Par</th>
                    <th>Avant</th>
                    <th>Après</th>
                </tr>
                </thead>
                <tbody>
                {% for h in histories %}
                    <tr>
                        <td>{{ h.createdAt|date('d/m/Y H:i') }}</td>
                        <td>{{ h.entityType }}</td>
                        <td><span class="badge bg-dark">{{ h.action }}</span></td>
                        <td>{{ h.event ? h.event.name : '-' }}</td>
                        <td>{{ h.performedBy ? h.performedBy.email : 'System' }}</td>
                        <td><pre class="m-0 small">{{ h.snapshotBefore ? h.snapshotBefore|json_encode(constant('JSON_PRETTY_PRINT')) : '-' }}</pre></td>
                        <td><pre class="m-0 small">{{ h.snapshotAfter ? h.snapshotAfter|json_encode(constant('JSON_PRETTY_PRINT')) : '-' }}</pre></td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center py-4">Aucun historique.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
