{% extends 'base.html.twig' %}

{% block title %}Evolia — Espace de sérénité et bien-être{% endblock %}

{% block stylesheets %}
    <!-- Force Turbo to never cache this page snapshot -->
    <meta name="turbo-cache-control" content="no-cache">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <!-- Custom styles -->
    <link rel="stylesheet" href="{{ asset('styles.css') }}?v={{ 'now'|date('U') }}">
{% endblock %}

{% block body %}

{# ——— BOOTSTRAP BACKGROUND CAROUSEL ——— #}
<div id="bgCarousel" class="carousel slide carousel-fade bg-carousel" data-bs-ride="carousel" data-bs-interval="1500">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/images/bg-2.jpg" class="d-block w-100" alt="Bien-être 2">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-3.jpg" class="d-block w-100" alt="Bien-être 3">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-4.jpg" class="d-block w-100" alt="Bien-être 4">
        </div>
    </div>
</div>

{# ——— DARK OVERLAY ——— #}
<div class="bg-dark-overlay"></div>

{# ——— PAGE CONTENT (overlaid on carousel) ——— #}
<div class="home-container">

    {# ——— PANEL 1: EDITORIAL HERO ——— #}
    <div class="side-hero">
        <div class="logo-badge animate__animated animate__fadeInLeft">
            <i class="fa-solid fa-leaf"></i>
            Evolia Platform
        </div>

        <h1 class="title animate__animated animate__fadeInLeft" style="animation-delay: 0.2s;">
            Bien‑être <span>&amp; Sérénité</span>
        </h1>

        <p class="subtitle animate__animated animate__fadeInLeft" style="animation-delay: 0.4s;">
            Votre écosystème digital dédié à la croissance personnelle et à l'harmonie intérieure. Accédez à vos outils d'expertise en toute simplicité.
        </p>
    </div>

    {# ——— PANEL 2: ACTION PANEL ——— #}
    <div class="action-panel animate__animated animate__fadeInRight">
        
        <div class="cards-wrapper">

            {# Administration Card #}
            <div class="card admin animate__animated animate__fadeInUp" style="animation-delay: 0.6s;">
                <div class="card-header">
                    <div class="card-icon-wrap">
                        <i class="fa-solid fa-seedling"></i>
                    </div>
                    <h2>Espace Admin</h2>
                </div>
                <p class="description">Pilotage stratégique et gestion des ressources.</p>
                <ul>
                    <li>Utilisateurs</li>
                    <li>Événements</li>
                    <li>Expertise</li>
                </ul>
                <a href="{{ path('app_admin_login') }}" class="btn btn-admin" data-turbo="false">Connexion Admin</a>
            </div>

            {# Personal Card #}
            <div class="card user animate__animated animate__fadeInUp" style="animation-delay: 0.8s;">
                <div class="card-header">
                    <div class="card-icon-wrap">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>
                    <h2>Mon Espace</h2>
                </div>
                <p class="description">Accédez à votre parcours bien-être personnalisé.</p>
                <ul>
                    <li>Méditations</li>
                    <li>Exercices</li>
                    <li>Suivi</li>
                </ul>
                <a href="{{ path('app_user_login') }}" class="btn btn-personal" data-turbo="false">Rejoindre l'espace</a>
            </div>

        </div>

        {# INTEGRATED FOOTER #}
        <footer class="animate__animated animate__fadeIn" style="animation-delay: 1s;">
            <div class="footer-quote">
                “ L'harmonie est la source de toute réussite. ”
            </div>
            <div class="footer-copy">© 2026 EVOLIA PLATFORM — ARCHITECTURE ÉPURÉE</div>
        </footer>

    </div>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
// ============================================================
// HOME PAGE — CHROME & TURBO DRIVE LAYOUT FIX
// Chrome caches Turbo snapshots aggressively. We force a full
// reload every time this page is visited via Turbo navigation.
// ============================================================

// 1) If Turbo is about to restore this page from its snapshot
//    cache → force a real server request instead
document.addEventListener('turbo:before-render', function(e) {
    if (e.detail.renderMethod === 'restore') {
        e.preventDefault();
        window.location.reload();
    }
});

// 2) On every load (first time, back button, link click)
function initHomePage() {
    // Force layout reflow so Chrome applies flex correctly
    var container = document.querySelector('.home-container');
    if (container) {
        container.style.display = 'none';
        void container.offsetHeight; // trigger reflow
        container.style.display = 'flex';
    }

    // Re-init Bootstrap carousel
    var carouselEl = document.getElementById('bgCarousel');
    if (carouselEl && typeof bootstrap !== 'undefined') {
        var old = bootstrap.Carousel.getInstance(carouselEl);
        if (old) old.dispose();
        new bootstrap.Carousel(carouselEl, { ride: 'carousel', interval: 1500 });
    }
}

// Run immediately AND on Turbo load
initHomePage();
document.addEventListener('turbo:load', initHomePage);

// 3) Before Turbo caches this page, neutralize the background
//    carousel so the snapshot doesn't contain a broken state
document.addEventListener('turbo:before-cache', function() {
    var carouselEl = document.getElementById('bgCarousel');
    if (carouselEl && typeof bootstrap !== 'undefined') {
        var instance = bootstrap.Carousel.getInstance(carouselEl);
        if (instance) instance.dispose();
    }
});
</script>

{% endblock %}
