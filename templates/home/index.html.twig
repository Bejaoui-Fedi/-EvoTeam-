{% extends 'base.html.twig' %}

{% block title %}Evolia — Espace de sérénité et bien-être{% endblock %}

{% block stylesheets %}
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom styles -->
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
{% endblock %}

{% block body %}

{# ——— BOOTSTRAP BACKGROUND CAROUSEL ——— #}
<div id="bgCarousel" class="carousel slide carousel-fade bg-carousel" data-bs-ride="carousel" data-bs-interval="1500">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/images/bg-2.jpg" class="d-block w-100" alt="Bien-être 2">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-3.jpg" class="d-block w-100" alt="Bien-être 3">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-4.jpg" class="d-block w-100" alt="Bien-être 4">
        </div>
    </div>
</div>

{# ——— DARK OVERLAY ——— #}
<div class="bg-dark-overlay"></div>

{# ——— PAGE CONTENT (overlaid on carousel) ——— #}
<div class="home-container">

    {# ——— HERO ——— #}
    <div class="hero">

        <div class="logo-badge">
            <i class="fa-solid fa-leaf"></i>
            Evolia Platform
        </div>

        <h1 class="title">
            Bien‑<span>être</span><br>
            &amp; Sérénité
        </h1>

        <p class="subtitle">Votre espace personnel de croissance et d'harmonie</p>

        <div class="hero-divider"></div>
    </div>

    {# ——— CARDS ——— #}
    <div class="cards-wrapper">

        {# Administration #}
        <div class="card admin">
            <div class="card-icon-wrap">
                <i class="fa-solid fa-seedling"></i>
            </div>
            <h2>Administration</h2>
            <p class="description">Gestion complète de la plateforme</p>
            <div class="card-divider"></div>
            <ul>
                <li><i class="fa-solid fa-check"></i> Gestion des utilisateurs</li>
                <li><i class="fa-solid fa-check"></i> Organisation des événements</li>
                <li><i class="fa-solid fa-check"></i> Suivi complet</li>
            </ul>
            <a href="{{ path('app_admin_login') }}" class="btn btn-admin">Accéder &nbsp;<i class="fa-solid fa-arrow-right"></i></a>
        </div>

        {# Espace Personnel #}
        <div class="card user">
            <div class="card-icon-wrap">
                <i class="fa-solid fa-heart-pulse"></i>
            </div>
            <h2>Espace Personnel</h2>
            <p class="description">Votre chemin vers le bien-être</p>
            <div class="card-divider"></div>
            <ul>
                <li><i class="fa-solid fa-check"></i> Tableau de bord personnalisé</li>
                <li><i class="fa-solid fa-check"></i> Exercices et journal</li>
                <li><i class="fa-solid fa-check"></i> Rendez-vous et suivi</li>
            </ul>
            <a href="{{ path('app_user_login') }}" class="btn btn-personal">Accéder &nbsp;<i class="fa-solid fa-arrow-right"></i></a>
        </div>

    </div>

    {# ——— FOOTER ——— #}
    <footer>
        <div class="footer-quote">
            <i class="fa-solid fa-leaf"></i>
            Grandissez en harmonie
            <i class="fa-solid fa-leaf"></i>
        </div>
        <div class="footer-copy">© 2026 PsyCoach Pro — Tous droits réservés</div>
    </footer>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}
