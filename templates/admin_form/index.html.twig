{% extends 'base.html.twig' %}

{% block title %}Evolia — Inscription Admin{% endblock %}

{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}?v={{ 'now'|date('U') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <style>
        .admin-theme .full-split-container {
            display: flex;
            height: 100vh;
            overflow: hidden;
            width: 100%;
            position: relative;
            z-index: 10;
        }

        .admin-theme .visual-side {
            flex: 1.2;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            padding: 80px 100px;
        }

        .admin-theme .form-side {
            flex: 1;
            background: rgba(255, 255, 255, 0.98);
            color: #1a202c;
            display: flex;
            flex-direction: column;
            padding: 80px 100px;
            box-shadow: -20px 0 60px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
            position: relative;
        }

        .admin-theme .form-container-inner {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
        }

        .admin-theme .visual-content {
            position: relative;
            z-index: 15;
            text-align: left;
            max-width: 500px;
            color: white;
        }

        .admin-theme .visual-content h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3.5rem;
            font-weight: 300;
            line-height: 1.1;
            margin-bottom: 24px;
        }

        .admin-theme .visual-content h2 span {
            display: block;
            font-style: italic;
            font-weight: 500;
            color: var(--green-light);
        }

        .admin-theme h1 {
            font-family: 'Cormorant Garamond', serif !important;
            font-size: 2.2rem !important;
            font-weight: 600 !important;
            color: var(--green-deep) !important;
            margin-bottom: 8px !important;
        }

        .admin-theme .form-control {
            border: 1.5px solid #e1e9f0 !important;
            border-radius: 12px !important;
            padding: 14px 18px !important;
            background: #f8fafc !important;
            transition: all 0.3s ease;
        }

        .admin-theme .form-control:focus {
            border-color: var(--green-mid) !important;
            box-shadow: 0 0 0 4px rgba(29, 77, 63, 0.1) !important;
        }

        .admin-theme #toast-error { position: fixed; top: 30px; right: 30px; z-index: 9999; display: none; }

        @media (max-width: 1200px) {
            .admin-theme .form-side { padding: 60px 40px; }
        }

        @media (max-width: 992px) {
            .admin-theme .full-split-container { flex-direction: column; }
            .admin-theme .visual-side { display: none; }
            .admin-theme .form-side { min-height: 100vh; }
        }
    </style>
{% endblock %}

{% block body %}

{# --- GLOBAL BG FIXED --- #}
<div id="bgCarousel" class="carousel slide carousel-fade bg-carousel" data-bs-ride="carousel" data-bs-interval="3500">
    <div class="carousel-inner">
        <div class="carousel-item active"><img src="/images/bg-2.jpg" class="d-block w-100" alt="BG"></div>
        <div class="carousel-item"><img src="/images/bg-4.jpg" class="d-block w-100" alt="BG"></div>
    </div>
</div>
<div class="bg-dark-overlay"></div>

<div class="full-split-container">

    {# ——— LEFT: VISUAL ——— #}
    <div class="visual-side">
        <div class="visual-content animate__animated animate__fadeInLeft">
            <div class="logo-badge mb-4">
                <i class="fa-solid fa-shield-halved me-2"></i> Administration
            </div>
            <h2>Pilotez avec <span>Excellence</span></h2>
            <p class="subtitle mt-3">Créez votre accès administrateur sécurisé pour guider la communauté Evolia.</p>
        </div>
    </div>

    {# ——— RIGHT: FORM ——— #}
    <div class="form-side animate__animated animate__fadeInRight">
        
        <div class="form-container-inner" style="max-width: 480px; width: 100%; margin: 0 auto;">
            
            <div class="brand-header mb-5">
                <h1>Inscription Admin</h1>
                <p class="text-muted small">Accès restreint au personnel autorisé.</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} rounded-4 border-0 mb-4 animate__animated animate__fadeIn">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('app_admin_form') }}" novalidate autocomplete="off">
                {% if error is defined and error %}
                    <div class="alert alert-danger px-4 py-3 border-0 rounded-4 mb-4" style="background: rgba(229, 62, 62, 0.1); color: #e53e3e; font-size: 0.9rem;">
                        <i class="fa-solid fa-circle-exclamation me-2"></i> {{ error }}
                    </div>
                {% endif %}
                <input type="hidden" name="_token" value="{{ csrf_token('admin_registration') }}">
                
                <div class="form-group mb-4">
                    <label class="form-label fw-bold small text-uppercase">Code d'autorisation</label>
                    <input type="password" id="a-code" class="form-control" name="auth_code"
                        placeholder="Entrez le code secret admin"
                        autocomplete="new-password"
                        style="letter-spacing: 3px;">
                    <div class="field-error-msg" id="err-code" style="display:none; color: #e53e3e; font-size: 0.75rem; margin-top: 5px;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i><span></span>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold small text-uppercase">Nom complet</label>
                    <input type="text" id="a-fullname" class="form-control" name="fullname" placeholder="Ex: Marc Lefebvre">
                    <div class="field-error-msg" id="err-fullname" style="display:none; color: #e53e3e; font-size: 0.75rem; margin-top: 5px;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i><span></span>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold small text-uppercase">Email Professionnel</label>
                    <input type="email" id="a-email" class="form-control" name="email" placeholder="admin@evolia.com" autocomplete="new-password">
                    <div class="field-error-msg" id="err-email" style="display:none; color: #e53e3e; font-size: 0.75rem; margin-top: 5px;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i><span></span>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold small text-uppercase">Téléphone <span style="font-size:0.7rem;opacity:0.6;">(8 chiffres)</span></label>
                    <input type="tel" id="a-phone" class="form-control" name="phone" placeholder="Ex: 22123456" maxlength="8" autocomplete="off" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                    <div class="field-error-msg" id="err-phone" style="display:none; color: #e53e3e; font-size: 0.75rem; margin-top: 5px;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i><span></span>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold small text-uppercase">Mot de passe</label>
                    <input type="password" id="a-password" class="form-control" name="password" placeholder="8 caractères minimum" autocomplete="new-password">
                    <div class="strength-bar mt-2" style="height: 4px; background: #edf2f7; border-radius: 10px; overflow: hidden;">
                        <div class="strength-fill" style="height: 100%; width: 0; transition: width 0.3s; background: #e53e3e;"></div>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold small text-uppercase">Confirmation</label>
                    <input type="password" id="a-confirm" class="form-control" name="confirm_password" placeholder="Répétez le mot de passe">
                    <div class="field-error-msg" id="err-confirm" style="display:none; color: #e53e3e; font-size: 0.75rem; margin-top: 5px;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i><span></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-admin w-100 py-3 rounded-4 shadow-sm mt-3">
                    Finaliser l'inscription
                </button>

                <div class="text-center mt-5">
                    <span class="text-muted small">Déjà un compte ?</span>
                    <a href="{{ path('app_admin_login') }}" class="fw-bold text-decoration-none ms-2" style="color: var(--green-deep);">Connexion Admin</a>
                </div>

                 <div class="text-center mt-4 pt-4 border-top">
                    <a href="{{ path('app_home') }}" class="text-muted text-decoration-none small" data-turbo="false">
                        <i class="fa-solid fa-house me-2"></i> Accueil
                    </a>
                </div>
            </form>

            <footer class="mt-auto pt-5">
                <div class="footer-copy small text-muted">© 2026 EVOLIA ADMIN CONSOLE</div>
            </footer>
        </div>
    </div>
</div>

<div id="toast-error" style="display: none; position: fixed; top: 20px; right: 20px; z-index: 9999;">
    <div class="toast-card" style="background: white; border-radius: 16px; padding: 16px 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.1); border: 1px solid rgba(0,0,0,0.05); display: flex; align-items: center; gap: 12px; animation: slideInRight 0.4s ease forwards;">
        <div class="toast-icon" style="color: #e53e3e;"><i class="fa-solid fa-circle-exclamation"></i></div>
        <div id="toast-text" style="color: #4a5568; font-size: 0.9rem; font-weight: 500;"></div>
    </div>
</div>

<script>
(function() {
    function init() {
        const form = document.querySelector('form');
        if (!form) return;

        const showToast = (msg) => {
            const toast = document.getElementById('toast-error');
            document.getElementById('toast-text').textContent = msg;
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 4000);
        };

        form.addEventListener('submit', function(e) {
            const code = document.getElementById('a-code');
            const fullname = document.getElementById('a-fullname');
            const email = document.getElementById('a-email');
            const phone = document.getElementById('a-phone');
            const password = document.getElementById('a-password');
            const confirm = document.getElementById('a-confirm');

            document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
            document.querySelectorAll('.field-error-msg').forEach(el => el.style.display = 'none');

            let valid = true;

            const showError = (input, msgId, msg) => {
                if(input) input.classList.add('is-invalid');
                const errDiv = document.getElementById(msgId);
                if (errDiv) {
                    errDiv.style.display = 'block';
                    errDiv.querySelector('span').textContent = msg;
                }
                valid = false;
            };

            if (!code.value.trim()) showError(code, 'err-code', 'Code requis.');
            if (!fullname.value.trim()) showError(fullname, 'err-fullname', 'Le nom est requis.');
            if (!email.value.trim() || !email.value.includes('@')) showError(email, 'err-email', 'Un email valide est requis.');
            if (!phone || !phone.value.trim() || !/^[0-9]{8}$/.test(phone.value.trim())) showError(phone, 'err-phone', 'Téléphone : 8 chiffres requis.');
            if (password.value.length < 8) showError(password, 'err-password', 'Mot de passe trop court.');
            if (confirm && confirm.value !== password.value) showError(confirm, 'err-confirm', 'Les mots de passe ne correspondent pas.');

            if (!valid) { 
                e.preventDefault(); 
                showToast('Veuillez remplir tous les champs correctement.'); 
            }
        });

        const pass = document.getElementById('a-password');
        const fill = document.querySelector('.strength-fill');
        if (pass && fill) {
            pass.addEventListener('input', () => {
                const v = pass.value;
                let s = v.length >= 8 ? 40 : 10;
                if (/[A-Z]/.test(v)) s += 30;
                if (/[0-9]/.test(v)) s += 30;
                fill.style.width = s + '%';
                fill.style.background = s < 50 ? '#e53e3e' : s < 100 ? '#ecc94b' : '#48bb78';
            });
        }
    }
    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('turbo:load', init);
    if (document.readyState !== 'loading') init();
})();
</script>
{% endblock %}
