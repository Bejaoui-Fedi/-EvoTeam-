{% extends 'base.html.twig' %}

{% block title %}Evolia — Inscription Administrateur{% endblock %}

{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_form.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <style>
        .modern-alert {
            display: flex; align-items: center; padding: 1rem; margin-bottom: 2rem;
            border-radius: 1.25rem; background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2);
            color: white; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
        }
        .alert-error {
            background: #842029 !important;
            border: 1px solid #721c24 !important;
            color: #ffffff !important;
            box-shadow: 0 4px 15px rgba(114, 28, 36, 0.3) !important;
            opacity: 1 !important;
        }
        .alert-icon-circle { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 1rem; background: rgba(255, 255, 255, 0.2) !important; color: #ffffff !important; font-size: 1.25rem; }
        .alert-message { font-size: 0.95rem; text-align: left; }
        .alert-message strong { display: block; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; margin-bottom: 2px; opacity: 0.8; }
    </style>
{% endblock %}

{% block body %}

{# ——— BOOTSTRAP BACKGROUND CAROUSEL ——— #}
<div id="bgCarousel" class="carousel slide carousel-fade bg-carousel" data-bs-ride="carousel" data-bs-interval="1500">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/images/bg-2.jpg" class="d-block w-100" alt="Bien-être 1">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-3.jpg" class="d-block w-100" alt="Bien-être 2">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-4.jpg" class="d-block w-100" alt="Bien-être 3">
        </div>
    </div>
</div>

{# ——— DARK OVERLAY ——— #}
<div class="bg-dark-overlay"></div>

<div class="registration-card">

    <h1>Inscription Administrateur</h1>
    <p class="subtitle">Créez un compte administrateur</p>
    
    {% if error is defined and error %}
        <div class="modern-alert alert-error animate__animated animate__shakeX">
            <div class="alert-icon-circle">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>
            <div class="alert-message">
                <strong>Erreur</strong> {{ error }}
            </div>
        </div>
    {% endif %}

    <hr class="section-divider">

    <form method="post" action="{{ path('app_admin_form') }}" autocomplete="off">

        <div class="section-title">Code d'autorisation</div>
        <input type="text" class="form-control" name="auth_code" placeholder="Entrez le code secret administrateur" required>

        <div class="section-title">Informations personnelles</div>
        <input type="text" class="form-control" name="fullname" placeholder="Nom complet" required>
        <input type="email" class="form-control" name="email" placeholder="Email (admin@exemple.com)" required>
        <input type="tel" class="form-control" name="phone" placeholder="Téléphone (8 chiffres)" pattern="[0-9]{8}" maxlength="8" required>

        <div class="section-title">Sécurité</div>
        <input type="password" class="form-control" name="password" placeholder="Mot de passe (min. 8 caractères)" required autocomplete="new-password">
        <input type="password" class="form-control" name="confirm_password" placeholder="Confirmer le mot de passe" required autocomplete="new-password">

        <div class="strength-container">
            <div class="strength-bar">
                <div class="strength-fill"></div>
            </div>
            <div class="strength-label"></div>
        </div>

        <div class="form-options">
            <label>
                <input type="checkbox" name="terms" required> J'accepte les <a href="#">conditions générales</a> et la <a href="#">politique de confidentialité</a>
            </label>
        </div>

        <button type="submit" class="btn-submit" style="border: none; width: 100%;">
            <i class="fa-solid fa-check"></i> Créer le compte administrateur
        </button>

    </form>

    <p class="login-link">
        Déjà un compte admin ? <a href="{{ path('app_admin_login') }}">Connectez-vous</a>
    </p>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function() {
    const initStrength = () => {
        const password = document.querySelector('input[name="password"]');
        const strengthFill = document.querySelector('.strength-fill');
        const strengthLabel = document.querySelector('.strength-label');

        if (!password || !strengthFill || !strengthLabel) return;

        password.addEventListener('input', function() {
            const val = password.value;
            let score = 0;

            if (!val) {
                strengthFill.style.width = '0%';
                strengthLabel.textContent = '';
                return;
            }

            // More granular scoring
            if (val.length >= 8) score += 25;
            if (/[A-Z]/.test(val)) score += 25;
            if (/[0-9]/.test(val)) score += 25;
            if (/[^A-Za-z0-9]/.test(val)) score += 25;

            let color = '#ff6b6b';
            let label = 'Très Faible';

            if (score === 25) {
                color = '#ff6b6b';
                label = 'Faible';
            } else if (score === 50) {
                color = '#ffd166';
                label = 'Moyen';
            } else if (score === 75) {
                color = '#06d6a0';
                label = 'Fort';
            } else if (score === 100) {
                color = '#118ab2';
                label = 'Excellent';
            }

            strengthFill.style.width = score + '%';
            strengthFill.style.background = color;
            strengthLabel.style.color = color;
            strengthLabel.textContent = label;
        });
    };

    document.addEventListener('DOMContentLoaded', initStrength);
    document.addEventListener('turbo:load', initStrength);
})();
</script>
{% endblock %}
