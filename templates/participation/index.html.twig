{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    {% if isAdmin %}
        <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    {% else %}
        <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    {% endif %}
{% endblock %}

{% block body %}
{% if isAdmin %}
    <div class="admin-scope">
        {% include 'admin_nav_bar/index.html.twig' %}
        <div class="admin-main-content p-4">
{% else %}
    <div class="user-scope">
        {% include 'user_nav_bar/index.html.twig' %}
        <div class="user-main-content p-4">
{% endif %}
    <h1 class="mb-4">{{ isAdmin ? 'Toutes les participations' : 'Mes participations' }}</h1>
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="alert alert-danger">{{ message }}</div>{% endfor %}

    <div class="table-responsive bg-white rounded-3 shadow-sm p-3">
        <table class="table align-middle">
            <thead>
            <tr>
                {% if isAdmin %}<th>Utilisateur</th>{% endif %}
                <th>Evenement</th>
                <th>Date evenement</th>
                <th>Statut</th>
                <th>Date inscription</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for participation in participations %}
                <tr>
                    {% if isAdmin %}<td>{{ participation.user.nom }} ({{ participation.user.email }})</td>{% endif %}
                    <td>{{ participation.event.name }}</td>
                    <td>{{ participation.event.startDate|date('d/m/Y') }}</td>
                    <td><span class="badge {{ participation.status == 'registered' ? 'bg-success' : 'bg-secondary' }}">{{ participation.status }}</span></td>
                    <td>{{ participation.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="d-flex gap-2">
                        <a href="{{ path('app_participation_show_safe', {id: participation.id}) }}" class="btn btn-sm btn-outline-dark">Voir</a>
                        <a href="{{ path('app_participation_edit', {id: participation.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                        <a href="{{ path('app_participation_qr', {id: participation.id}) }}" class="btn btn-sm btn-outline-success">QR evenement</a>
                        {% if not isAdmin %}
                            <form method="post" action="{{ path('app_participation_calendar_add', {id: participation.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('calendar_participation_' ~ participation.id) }}">
                                <button class="btn btn-sm btn-outline-primary" type="submit">Google Calendar</button>
                            </form>
                        {% endif %}
                        {% if participation.status == 'registered' %}
                            <form method="post" action="{{ path('app_participation_cancel', {id: participation.id}) }}" onsubmit="return confirm('Annuler la participation ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_participation_' ~ participation.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Annuler</button>
                            </form>
                        {% endif %}
                        <form method="post" action="{{ path('app_participation_delete', {id: participation.id}) }}" onsubmit="return confirm('Supprimer cette participation ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_participation_' ~ participation.id) }}">
                            <button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="{{ isAdmin ? 6 : 5 }}" class="text-center py-4">Aucune participation.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    </div></div>
{% endblock %}
