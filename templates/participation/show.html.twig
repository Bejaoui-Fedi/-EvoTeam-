{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset(isAdmin ? 'admin_dashboard.css' : 'user_dashboard.css') }}">
{% endblock %}

{% block body %}
{% if isAdmin %}
<div class="admin-scope">
    {% include 'admin_nav_bar/index.html.twig' %}
    <div class="admin-main-content p-4">
{% else %}
<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}
    <div class="user-main-content p-4">
{% endif %}
        <h1 class="mb-3">Détails participation</h1>
        <ul class="list-group">
            <li class="list-group-item"><strong>Evenement:</strong> {{ participation.event.name }}</li>
            <li class="list-group-item"><strong>Date:</strong> {{ participation.event.startDate|date('d/m/Y') }}</li>
            <li class="list-group-item"><strong>Statut:</strong> {{ participation.status }}</li>
            <li class="list-group-item"><strong>Places:</strong> {{ participation.seats }}</li>
            <li class="list-group-item"><strong>Téléphone:</strong> {{ participation.contactPhone ?: '-' }}</li>
            <li class="list-group-item"><strong>Paiement:</strong> {{ participation.paymentMethod == 'online' ? 'En ligne (Stripe)' : 'Sur place' }}</li>
            <li class="list-group-item"><strong>Statut Paiement:</strong> 
                <span class="badge {{ participation.paymentStatus == 'paid' ? 'bg-success' : 'bg-warning' }}">
                    {{ participation.paymentStatus == 'paid' ? 'Payé' : 'En attente' }}
                </span>
            </li>
            <li class="list-group-item"><strong>Note:</strong> {{ participation.note ?: '-' }}</li>
            <li class="list-group-item"><strong>Inscrit le:</strong> {{ participation.createdAt|date('d/m/Y H:i') }}</li>
        </ul>
        <div class="mt-3 d-flex gap-2">
            <a href="{{ path('app_participation_edit', {id: participation.id}) }}" class="btn btn-warning">Modifier</a>
            <a href="{{ path('app_participation_qr', {id: participation.id}) }}" class="btn btn-success">QR</a>
            <a href="{{ isAdmin ? path('app_participation_index') : path('app_participation_my') }}" class="btn btn-secondary">Retour</a>
        </div>
    </div>
</div>
{% endblock %}
