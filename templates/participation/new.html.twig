{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <style>
        .participation-wrapper {
            max-width: 800px;
            margin: 0 auto;
        }
        .event-banner {
            background: linear-gradient(135deg, #2c3e50, #3498db);
            color: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .form-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.05);
            padding: 30px;
            border: none;
            margin-bottom: 30px;
        }
        .form-group-custom {
            margin-bottom: 1.5rem;
        }
        .form-label-custom {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }
        .btn-submit-custom {
            background: linear-gradient(135deg, #00b09b, #96c93d);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: bold;
            font-size: 1.1rem;
            box-shadow: 0 8px 15px rgba(0, 176, 155, 0.3);
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 20px;
        }
        .btn-submit-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(0, 176, 155, 0.4);
            color: white;
        }
    </style>
{% endblock %}

{% block body %}
<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}
    <div class="user-main-content p-4" style="background-color: #f8f9fa;">
        <div class="participation-wrapper">
            
            <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-dark mb-4">
                <i class="fas fa-arrow-left"></i> Retour aux événements
            </a>

            <div class="event-banner">
                <h2 class="fw-bold mb-2"><i class="fas fa-calendar-check"></i> Inscription à l'événement</h2>
                <h4 class="mb-3" style="color: #f1c40f;">{{ event.name }}</h4>
                <div class="d-flex gap-4 opacity-75">
                    <span><i class="far fa-clock"></i> {{ event.startDate|date('d/m/Y') }}</span>
                    <span><i class="fas fa-map-marker-alt"></i> {{ event.location }}</span>
                    <span><i class="fas fa-tag"></i> {{ event.fee }} € / place</span>
                </div>
            </div>

            <div class="form-card">
                <h4 class="mb-4 text-center" style="color: #2c3e50;">Formulaire de Participation</h4>
                
                {{ form_start(form) }}
                    
                    {# On cache le statut qui n'a pas a etre gere par l'utilisateur #}
                    <div class="d-none">
                        {{ form_row(form.status) }}
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group-custom">
                            <label class="form-label-custom"><i class="fas fa-ticket-alt text-primary"></i> Nombre de places</label>
                            {{ form_widget(form.seats, {'attr': {'class': 'form-control form-control-lg'}}) }}
                            {{ form_errors(form.seats) }}
                        </div>
                        <div class="col-md-6 form-group-custom">
                            <label class="form-label-custom"><i class="fas fa-phone text-primary"></i> Téléphone de contact</label>
                            {{ form_widget(form.contactPhone, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Ex: 98765432'}}) }}
                            {{ form_errors(form.contactPhone) }}
                        </div>
                    </div>

                    <div class="form-group-custom">
                        <label class="form-label-custom"><i class="fas fa-comment-dots text-primary"></i> Note ou demande spéciale</label>
                        {{ form_widget(form.note, {'attr': {'class': 'form-control', 'rows': '3', 'placeholder': 'Une alergie ? Une question ?'}}) }}
                        {{ form_errors(form.note) }}
                    </div>

                    <hr class="my-4">

                    <div class="form-group-custom bg-light p-4 rounded border">
                        <label class="form-label-custom fs-5 mb-3"><i class="fas fa-credit-card text-success"></i> Méthode de paiement</label>
                        {{ form_widget(form.paymentMethod, {'attr': {'class': 'form-select form-select-lg border-success'}}) }}
                        {{ form_errors(form.paymentMethod) }}
                        <small class="text-muted mt-2 d-block"><i class="fas fa-info-circle"></i> Le paiement en ligne est sécurisé par Stripe.</small>
                    </div>

                    <button type="submit" class="btn-submit-custom">
                        <i class="fas fa-check-circle"></i> Confirmer & Finaliser l'inscription
                    </button>
                    
                    {# S'il y a d'autres champs non gérés manuellement, on les rend à la fin invisible ou non pour eviter des erreurs #}
                    <div class="d-none">
                        {{ form_rest(form) }}
                    </div>

                {{ form_end(form) }}
            </div>
            
        </div>
    </div>
</div>
{% endblock %}
