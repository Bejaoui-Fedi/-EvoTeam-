{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h3 mb-3">Informations de participation</h1>
            <p><strong>Participant :</strong> {{ participation.user.nom }} ({{ participation.user.email }})</p>
            <p><strong>Evenement :</strong> {{ participation.event.name }}</p>
            <p><strong>Date evenement :</strong> {{ participation.event.startDate|date('d/m/Y') }} - {{ participation.event.endDate|date('d/m/Y') }}</p>
            <p><strong>Lieu :</strong> {{ participation.event.location }}</p>
            <p><strong>Statut :</strong> <span class="badge {{ participation.status == 'registered' ? 'bg-success' : 'bg-secondary' }}">{{ participation.status }}</span></p>
            <p><strong>Date inscription :</strong> {{ participation.createdAt|date('d/m/Y H:i') }}</p>
        </div>
    </div>
</div>
{% endblock %}
