{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset(isAdmin ? 'admin_dashboard.css' : 'user_dashboard.css') }}">
{% endblock %}

{% block body %}
{% if isAdmin %}
<div class="admin-scope">
    {% include 'admin_nav_bar/index.html.twig' %}
    <div class="admin-main-content p-4">
{% else %}
<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}
    <div class="user-main-content p-4">
{% endif %}
        <h1 class="mb-3">Modifier participation</h1>
        <div class="card shadow-sm border-0">
            <div class="card-body">
                {{ form_start(form) }}
                    {% if form.event is defined %}{{ form_row(form.event) }}{% endif %}
                    {{ form_row(form.status) }}
                    {{ form_row(form.seats) }}
                    {{ form_row(form.contactPhone) }}
                    {{ form_row(form.note) }}
                    {{ form_row(form.save) }}
                {{ form_end(form) }}
            </div>
        </div>
        <a href="{{ isAdmin ? path('app_participation_index') : path('app_participation_my') }}" class="btn btn-secondary mt-3">Retour</a>
    </div>
</div>
{% endblock %}
