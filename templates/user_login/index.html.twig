{% extends 'base.html.twig' %}

{% block title %}Evolia — Espace Utilisateur{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <link rel="stylesheet" href="{{ asset('styles.css') }}?v={{ 'now'|date('U') }}">
    <link rel="stylesheet" href="{{ asset('user_login.css') }}">
    <style>
        :root {
            --primary-navy: #1e4d6b;
            --secondary-blue: #4a87a8;
            --accent-azure: #f0f7fb;
            --text-dark: #1a2a3a;
            --premium-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        }

        body, html {
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            background: #fff;
        }

        .split-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }

        /* Left Visual Panel */
        .visual-panel {
            flex: 1.2;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            background: var(--primary-navy);
            padding: 80px 40px;
        }

        .visual-content {
            position: relative;
            z-index: 5;
            text-align: center;
            color: white;
            width: 100%;
        }

        .visual-content h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 20px;
            text-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .visual-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(30, 77, 107, 0.8), rgba(30, 77, 107, 0.4));
            z-index: 2;
        }

        /* Right Form Panel */
        .form-panel {
            flex: 1;
            background: white;
            display: flex;
            flex-direction: column;
            padding: 80px 60px;
            box-shadow: -10px 0 50px rgba(0,0,0,0.05);
            overflow-y: auto;
        }

        .form-container {
            max-width: 460px; /* Slightly wider */
            margin: auto; /* Uses flex margin auto for safe centering */
            width: 100%;
        }

        .brand-header {
            text-align: left;
            margin-bottom: 40px;
        }

        .card-icon-wrap {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 22px;
            background: #e8f3f9;
            color: var(--primary-navy);
            box-shadow: 0 8px 20px rgba(30, 77, 107, 0.08);
        }

        .user-theme h1 {
            font-family: 'Cormorant Garamond', serif !important;
            font-size: 2.6rem !important;
            font-weight: 600 !important;
            color: var(--primary-navy) !important;
            margin-bottom: 4px !important;
            line-height: 1.1 !important;
        }

        .user-theme .subtitle {
            font-family: 'Inter', sans-serif !important;
            color: var(--secondary-blue) !important;
            font-size: 1rem !important;
            margin-top: 5px !important;
            font-style: italic;
            opacity: 0.85;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .user-theme .form-label {
            font-weight: 600 !important;
            font-size: 0.9rem !important;
            color: var(--primary-navy) !important;
            margin-bottom: 8px !important;
            display: block;
        }

        .user-theme .form-control {
            border: 1.5px solid #e1e9f0 !important;
            border-radius: 12px !important;
            padding: 14px 20px !important;
            font-size: 1rem !important;
            background: #f8fafc !important;
            transition: all 0.3s ease !important;
        }

        .form-control:focus {
            border-color: var(--primary-navy) !important;
            background: white !important;
            box-shadow: 0 0 0 4px rgba(30, 77, 107, 0.1) !important;
        }

        .password-container {
            position: relative;
            overflow: visible;
        }

        .password-container .form-control.is-invalid {
            border-color: #fc8181 !important;
            background: #fff5f5 !important;
            box-shadow: 0 0 0 4px rgba(252, 129, 129, 0.15) !important;
        }

        .password-toggle-btn {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: var(--secondary-blue);
            cursor: pointer;
            font-size: 1.1rem;
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 20px 0 30px;
            font-size: 0.9rem;
        }

        .form-options a {
            color: var(--primary-navy);
            text-decoration: none;
            font-weight: 600;
        }

        .captcha-area {
            display: flex;
            justify-content: center;
            margin-bottom: 25px;
            padding: 10px;
            background: transparent;
            border-radius: 12px;
            border: none;
        }

        .btn-login {
            width: 100%;
            height: 56px;
            background: var(--primary-navy) !important;
            color: white !important;
            border: none !important;
            border-radius: 12px !important;
            font-weight: 700 !important;
            font-size: 1.1rem !important;
            box-shadow: 0 10px 25px rgba(30, 77, 107, 0.2) !important;
            transition: all 0.3s ease !important;
            cursor: pointer;
        }

        .btn-login:disabled {
            background: #a0aec0 !important;
            color: rgba(255, 255, 255, 0.8) !important;
            box-shadow: none !important;
            cursor: not-allowed;
            opacity: 0.6;
        }

        .premium-divider {
            margin: 30px 0;
            text-align: center;
            position: relative;
            color: #a0aec0;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 1.5px;
        }

        .premium-divider::before {
            content: "";
            position: absolute;
            top: 50%; left: 0; right: 0;
            height: 1px; background: #e2e8f0;
            z-index: 1;
        }

        .premium-divider span {
            position: relative;
            z-index: 2;
            background: white;
            padding: 0 15px;
        }

        .btn-google {
            width: 100%;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            border: 1.5px solid #e2e8f0 !important;
            border-radius: 12px !important;
            background: white !important;
            color: var(--primary-navy) !important;
            text-decoration: none !important;
            font-weight: 600 !important;
            transition: all 0.3s ease !important;
        }

        .btn-google:hover {
            border-color: var(--primary-navy) !important;
            background: #f8fafc !important;
        }

        .register-footer {
            margin-top: 40px;
            text-align: center;
            font-size: 0.95rem;
            color: var(--secondary-blue);
        }

        .register-footer a {
            color: var(--primary-navy);
            font-weight: 700;
            text-decoration: none;
        }

        @media (max-width: 992px) {
            .visual-panel { display: none; }
            .form-panel { padding: 40px 20px; }
        }

        .modern-alert {
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            font-size: 0.95rem;
        }

        .alert-error {
            background: #fff5f5;
            color: #c53030;
            border: 1px solid #feb2b2;
        }

        /* Toast notification */
        #toast-error {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 9999;
            display: none;
            min-width: 300px;
            max-width: 420px;
        }

        .toast-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15), 0 0 0 1px rgba(197,48,48,0.12);
            padding: 18px 20px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            animation: slideInRight 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(60px) scale(0.9); }
            to   { opacity: 1; transform: translateX(0)   scale(1);   }
        }

        @keyframes slideOutRight {
            from { opacity: 1; transform: translateX(0)   scale(1);   }
            to   { opacity: 0; transform: translateX(60px) scale(0.9); }
        }

        .toast-icon {
            width: 40px; height: 40px; border-radius: 12px;
            background: linear-gradient(135deg, #ff6b6b, #ee5a24);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1.1rem; flex-shrink: 0;
        }

        .toast-body { flex: 1; }
        .toast-title { font-weight: 700; font-size: 0.9rem; color: #1a202c; margin-bottom: 3px; }
        .toast-msg   { font-size: 0.85rem; color: #718096; line-height: 1.4; }

        .toast-close {
            background: none; border: none; color: #a0aec0;
            font-size: 1rem; cursor: pointer; padding: 0;
            transition: color 0.2s;
        }
        .toast-close:hover { color: #1a202c; }

        .toast-progress {
            height: 3px; border-radius: 0 0 16px 16px;
            background: linear-gradient(90deg, #ff6b6b, #ee5a24);
            margin: 10px -20px -18px -20px;
            transform-origin: left;
            animation: shrink 4s linear forwards;
        }

        @keyframes shrink { from { transform: scaleX(1); } to { transform: scaleX(0); } }

        .field-error-msg {
            font-size: 0.8rem;
            color: #c53030;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 5px;
            animation: fadeInDown 0.25s ease;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-6px); }
            to   { opacity: 1; transform: translateY(0);    }
        }

        .form-control.is-invalid {
            border-color: #fc8181 !important;
            background: #fff5f5 !important;
            box-shadow: 0 0 0 4px rgba(252, 129, 129, 0.15) !important;
        }
    </style>
{% endblock %}

{% block body %}

<div class="split-container">
    
    {# ——— LEFT PANEL: VISUALS ——— #}
    <div class="visual-panel">
        <div id="bgCarousel" class="carousel slide carousel-fade h-100 w-100" data-bs-ride="carousel" data-bs-interval="2500" style="position: absolute; top:0; left:0;">
            <div class="carousel-inner h-100">
                <div class="carousel-item active h-100">
                    <img src="/images/bg-2.jpg" class="d-block w-100 h-100" alt="Bien-être 1" style="object-fit: cover;">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/bg-3.jpg" class="d-block w-100 h-100" alt="Bien-être 2" style="object-fit: cover;">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/bg-4.jpg" class="d-block w-100 h-100" alt="Bien-être 3" style="object-fit: cover;">
                </div>
            </div>
        </div>
        <div class="visual-overlay"></div>
        <div class="visual-content">
            <i class="fa-solid fa-heart-pulse mb-4" style="font-size: 4rem;"></i>
            <h2>Evolia Healthy Life</h2>
            <p class="lead">Votre bien-être commence ici. Rejoignez notre communauté dédiée à la santé mentale et physique.</p>
        </div>
    </div>

    {# ——— RIGHT PANEL: FORM ——— #}
    <div class="form-panel">
        <div class="form-container">
            
            <div class="brand-header animate__animated animate__fadeInDown">
                <div class="card-icon-wrap">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
                <h1>Espace Personnel</h1>
                <p class="subtitle">Votre chemin vers le bien-être</p>
            </div>

            {% if error %}
                <div class="modern-alert alert-error animate__animated animate__headShake">
                    <i class="fa-solid fa-triangle-exclamation me-3"></i>
                    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                </div>
            {% endif %}

            {% if app.request.query.get('success') %}
                <div class="modern-alert alert-success animate__animated animate__fadeInUp">
                    <i class="fa-solid fa-circle-check me-3"></i>
                    <div>{{ app.request.query.get('success') }}</div>
                </div>
            {% endif %}

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="modern-alert alert-{{ label == 'error' ? 'error' : 'success' }} animate__animated animate__fadeInUp">
                        <i class="fa-solid fa-{{ label == 'error' ? 'circle-exclamation' : 'circle-check' }} me-3"></i>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('app_user_login') }}" novalidate id="login-form" class="animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                
                <div class="form-group">
                    <label class="form-label" for="user_email">Email</label>
                    <input type="email" id="user_email" name="_username" class="form-control" value="{{ last_username }}" placeholder="nom@exemple.com" autocomplete="off">
                    <div class="field-error-msg" id="err-email" style="display:none"><i class="fa-solid fa-circle-exclamation"></i><span></span></div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="user_password">Mot de passe</label>
                    <div class="password-container">
                        <input type="password" id="user_password" name="_password" class="form-control" value="" placeholder="Votre mot de passe" autocomplete="off">
                        <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('user_password', this)">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <div class="field-error-msg" id="err-password" style="display:none"><i class="fa-solid fa-circle-exclamation"></i><span></span></div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </div>

                <div class="form-options">
                    <label class="d-flex align-items-center gap-2 m-0" style="cursor: pointer;">
                        <input type="checkbox" name="_remember_me" style="width: 16px; height: 16px; accent-color: var(--primary-navy);"> 
                        <span style="opacity: 0.8;">Rester connecté</span>
                    </label>
                    <a href="{{ path('app_forgot_password_request') }}" data-turbo="false">Oublié ?</a>
                </div>

                {% if recaptcha_site_key != 'your_site_key' %}
                <div class="captcha-area">
                    <div id="captcha-container" class="g-recaptcha" 
                         data-sitekey="{{ recaptcha_site_key }}" 
                         data-theme="light"
                         data-callback="onCaptchaSuccess"
                         data-expired-callback="onCaptchaExpired"></div>
                </div>
                {% endif %}

                <button type="submit" id="login-submit" class="btn-login" {{ recaptcha_site_key != 'your_site_key' ? 'disabled' : '' }}>
                    Se connecter
                </button>

                <div class="premium-divider"><span>OU</span></div>

                <a href="{{ path('app_google_connect') }}" class="btn-google">
                    <img src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png" alt="Google" style="width: 20px;">
                    Se connecter avec Google
                </a>

                <div class="register-footer mt-5 animate__animated animate__fadeIn" style="animation-delay: 0.8s;">
                    <p class="text-muted mb-3 small">Pas encore membre de la communauté ?</p>
                    <a href="{{ path('app_user_form') }}" class="btn btn-outline-primary rounded-pill px-4 fw-bold" style="border-color: var(--primary-navy); color: var(--primary-navy); font-size: 0.9rem;">
                        <i class="fa-solid fa-user-plus me-2"></i> Créer mon profil gratuitement
                    </a>
                </div>

                <div class="text-center mt-5">
                    <a href="{{ path('app_home') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-4" data-turbo="false">
                       <i class="fa-solid fa-house me-2"></i> Accueil
                    </a>
                </div>

            </form>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{# ── Toast container ── #}
<div id="toast-error">
    <div class="toast-card">
        <div class="toast-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="toast-body">
            <div class="toast-title">Champ requis</div>
            <div class="toast-msg" id="toast-text"></div>
        </div>
        <button class="toast-close" onclick="closeToast()"><i class="fa-solid fa-xmark"></i></button>
        <div class="toast-progress" id="toast-progress"></div>
    </div>
</div>

<script>
    let toastTimer;

    function showToast(msg) {
        const toast = document.getElementById('toast-error');
        document.getElementById('toast-text').textContent = msg;
        const card = toast.querySelector('.toast-card');
        const progress = document.getElementById('toast-progress');

        // Reset animation
        card.style.animation = 'none';
        card.offsetHeight; // reflow
        card.style.animation = '';
        progress.style.animation = 'none';
        progress.offsetHeight;
        progress.style.animation = 'shrink 4s linear forwards';

        toast.style.display = 'block';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(closeToast, 4000);
    }

    function closeToast() {
        const toast = document.getElementById('toast-error');
        const card = toast.querySelector('.toast-card');
        card.style.animation = 'slideOutRight 0.3s ease forwards';
        setTimeout(() => { toast.style.display = 'none'; }, 300);
    }

    function clearFieldError(input, errId) {
        input.classList.remove('is-invalid');
        const err = document.getElementById(errId);
        if (err) err.style.display = 'none';
    }

    function showFieldError(input, errId, msg) {
        input.classList.add('is-invalid');
        const err = document.getElementById(errId);
        if (err) { err.querySelector('span').textContent = msg; err.style.display = 'flex'; }
        input.focus();
        showToast(msg);
    }

    document.getElementById('login-form').addEventListener('submit', function(e) {
        const email    = document.getElementById('user_email');
        const password = document.getElementById('user_password');
        let valid = true;

        clearFieldError(email,    'err-email');
        clearFieldError(password, 'err-password');

        if (!email.value.trim()) {
            showFieldError(email, 'err-email', 'Veuillez saisir votre adresse email.');
            valid = false;
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
            showFieldError(email, 'err-email', 'Format d\'email invalide.');
            valid = false;
        }

        if (!password.value) {
            showFieldError(password, 'err-password', 'Veuillez saisir votre mot de passe.');
            valid = false;
        }

        if (!valid) e.preventDefault();
    });

    // Clear error on input
    document.getElementById('user_email').addEventListener('input', function() {
        clearFieldError(this, 'err-email');
    });
    document.getElementById('user_password').addEventListener('input', function() {
        clearFieldError(this, 'err-password');
    });

    // Global function to be sure it's accessible anywhere
    window.togglePasswordVisibility = function(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        
        if (input) {
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                }
            } else {
                input.type = 'password';
                if (icon) {
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            }
        }
    };

    window.onCaptchaSuccess = function() {
        const btn = document.getElementById('login-submit');
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
    };

    window.onCaptchaExpired = function() {
        const btn = document.getElementById('login-submit');
        btn.disabled = true;
        btn.style.opacity = '0.6';
        btn.style.cursor = 'not-allowed';
    };

    // Fix for Turbo navigation: re-initialize reCAPTCHA on turbo:load
    document.addEventListener('turbo:load', function() {
        const container = document.getElementById('captcha-container');
        if (container && typeof grecaptcha !== 'undefined') {
            try {
                if (container.innerHTML.trim() === '') {
                    grecaptcha.render('captcha-container', {
                        'sitekey': '{{ recaptcha_site_key }}',
                        'theme': 'light',
                        'callback': onCaptchaSuccess,
                        'expired-callback': onCaptchaExpired
                    });
                }
            } catch (e) {
                console.log("reCAPTCHA already rendered or failed to re-render:", e);
            }
        }
    });
</script>
{% endblock %}
