{% extends 'base.html.twig' %}

{% block title %}Evolia — Espace Utilisateur{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_login.css') }}">
    <style>
        .modern-alert {
            display: flex;
            align-items: center;
            padding: 1rem;
            margin-bottom: 2rem;
            border-radius: 1.25rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
        }
        .alert-error {
            background: #842029 !important;
            border: 1px solid #721c24 !important;
            color: #ffffff !important;
            box-shadow: 0 4px 15px rgba(114, 28, 36, 0.3) !important;
            opacity: 1 !important;
        }
        .alert-success {
            background: #0f5132 !important;
            border: 1px solid #0d4128 !important;
            color: #ffffff !important;
            box-shadow: 0 4px 15px rgba(13, 65, 40, 0.3) !important;
            opacity: 1 !important;
            font-weight: 700 !important;
        }
        .alert-icon-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            background: rgba(255, 255, 255, 0.2) !important;
            color: #ffffff !important;
            font-size: 1.25rem;
        }
        .alert-message {
            font-size: 0.95rem;
            text-align: left;
        }
        .alert-message strong {
            display: block;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            margin-bottom: 2px;
            opacity: 0.8;
        }

        /* Bulletproof Password Toggle Styles */
        .password-container {
            position: relative;
            display: flex;
            align-items: center;
        }
        .password-toggle-btn {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(30, 77, 107, 0.1);
            border: 1px solid rgba(30, 77, 107, 0.2);
            border-radius: 8px;
            padding: 6px 10px;
            cursor: pointer;
            color: #1e4d6b !important;
            z-index: 99;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            outline: none !important;
            height: 34px;
            width: 40px;
        }
        .password-toggle-btn:hover {
            background: rgba(30, 77, 107, 0.2);
            transform: translateY(-50%) scale(1.05);
        }
        .password-toggle-btn:active {
            transform: translateY(-50%) scale(0.95);
        }
        .form-control {
            padding-right: 55px !important;
        }
        /* Disable browser default reveal buttons */
        input::-ms-reveal,
        input::-ms-clear {
            display: none !important;
        }
    </style>
{% endblock %}

{% block body %}

{# ——— BOOTSTRAP BACKGROUND CAROUSEL ——— #}
<div id="bgCarousel" class="carousel slide carousel-fade bg-carousel" data-bs-ride="carousel" data-bs-interval="1500">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/images/bg-2.jpg" class="d-block w-100" alt="Bien-être 1">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-3.jpg" class="d-block w-100" alt="Bien-être 2">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-4.jpg" class="d-block w-100" alt="Bien-être 3">
        </div>
    </div>
</div>

{# ——— DARK OVERLAY ——— #}
<div class="bg-dark-overlay"></div>

<div class="login-card">

    <i class="fa-solid fa-heart-pulse login-icon"></i>

    <h1>Espace Utilisateur</h1>
    <p class="subtitle">Connectez-vous à votre espace personnel</p>

    {% if error %}
        <div class="modern-alert alert-error animate__animated animate__shakeX">
            <div class="alert-icon-circle">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>
            <div class="alert-message">
                <strong>Oups !</strong> {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        </div>
    {% endif %}

    {% if app.request.query.get('success') %}
        <div class="modern-alert alert-success animate__animated animate__fadeInUp">
            <div class="alert-icon-circle">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="alert-message">
                <strong>Génial !</strong> {{ app.request.query.get('success') }}
            </div>
        </div>
    {% endif %}
    <form method="post" action="{{ path('app_user_login') }}" novalidate id="login-form">
        <div class="form-group">
                    <label class="form-label" for="user_email">Email</label>
                    <input type="email" id="user_email" name="_username" class="form-control" value="{{ last_username }}" placeholder="nom@exemple.com" autocomplete="off" required>
                    <div class="field-error-msg" id="err-email" style="display:none"><i class="fa-solid fa-circle-exclamation"></i><span></span></div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="user_password">Mot de passe</label>
                    <div class="password-container">
                        <input type="password" id="user_password" name="_password" class="form-control" placeholder="Votre mot de passe" autocomplete="off" required>
                        <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('user_password', this)">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <div class="field-error-msg" id="err-password" style="display:none"><i class="fa-solid fa-circle-exclamation"></i><span></span></div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </div>

                <div class="form-options">
                    <label class="d-flex align-items-center gap-2 m-0" style="cursor: pointer;">
                        <input type="checkbox" name="_remember_me" style="width: 16px; height: 16px; accent-color: var(--primary-navy);"> 
                        <span style="opacity: 0.8;">Rester connecté</span>
                    </label>
                    <a href="{{ path('app_forgot_password_request') }}" data-turbo="false">Oublié ?</a>
                </div>

                {% if recaptcha_site_key is defined and recaptcha_site_key != 'your_site_key' %}
                <div class="captcha-area">
                    <div id="captcha-container" class="g-recaptcha" 
                         data-sitekey="{{ recaptcha_site_key }}" 
                         data-theme="light"
                         data-callback="onCaptchaSuccess"
                         data-expired-callback="onCaptchaExpired"></div>
                </div>
                {% endif %}

                <button type="submit" id="login-submit" class="btn-login" {{ (recaptcha_site_key is defined and recaptcha_site_key != 'your_site_key') ? 'disabled' : '' }}>
                    <i class="fa-solid fa-heart-pulse"></i>
                    Se connecter
                </button>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        </div>

        <div class="form-options">
            <label>
                <input type="checkbox" name="_remember_me"> Se souvenir de moi
            </label>
            <a href="#">Mot de passe oublié ?</a>
        </div>

        <button type="submit" class="btn-login" style="border: none; width: 100%;">
            <i class="fa-solid fa-heart-pulse"></i>
            Se connecter
        </button>

    </form>

    <p class="register-link">
        Pas encore de compte ? <a href="{{ path('app_user_form') }}">Inscrivez-vous ici</a>
    </p>

    <hr class="divider">

    <a href="{{ path('app_home') }}" class="btn-back">
        <i class="fa-solid fa-house"></i> Retour à l'accueil
    </a>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Global function to be sure it's accessible anywhere
    window.togglePasswordVisibility = function(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        
        if (input) {
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                }
            } else {
                input.type = 'password';
                if (icon) {
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            }
            // Optional: input.focus(); 
        }
    };
</script>
{% endblock %}
