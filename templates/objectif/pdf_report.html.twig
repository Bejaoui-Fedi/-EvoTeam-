<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport d'Objectifs - Evolia Admin</title>
    <style>
        body { font-family: 'Helvetica', sans-serif; color: #333; line-height: 1.5; font-size: 11pt; }
        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #1a3a2e; padding-bottom: 10px; }
        .header h1 { color: #1a3a2e; margin: 0; font-size: 24pt; }
        .header p { color: #666; margin: 5px 0 0; }
        
        .footer { position: fixed; bottom: -20px; left: 0; right: 0; height: 30px; text-align: center; font-size: 9pt; border-top: 1px solid #eee; padding-top: 5px; }

        .summary { background: #f8fafc; padding: 15px; border-radius: 8px; margin-bottom: 30px; }
        .summary-item { display: inline-block; width: 32%; text-align: center; }
        .summary-val { display: block; font-size: 16pt; font-weight: bold; color: #1a3a2e; }
        .summary-label { font-size: 8pt; text-transform: uppercase; color: #64748b; }

        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background: #1a3a2e; color: #fff; text-align: left; padding: 10px; font-size: 9pt; text-transform: uppercase; }
        td { border-bottom: 1px solid #e2e8f0; padding: 10px; vertical-align: top; }
        
        .status { padding: 3px 8px; border-radius: 4px; font-size: 8pt; font-weight: bold; text-transform: uppercase; }
        .status-en_cours { background: #e0f2fe; color: #0284c7; }
        .status-termine { background: #ede9fe; color: #7c3aed; }
        .status-abandonne { background: #ffe4e6; color: #e11d48; }

        .progress-bar { width: 100px; height: 8px; background: #eee; border-radius: 4px; display: inline-block; margin-right: 5px; }
        .progress-fill { height: 80%; background: #1a3a2e; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>EVOLIA ADMIN</h1>
        <p>Rapport d'Activité et Objectifs — Généré le {{ date|date('d/m/Y H:i') }}</p>
    </div>

    <div class="summary">
        <div class="summary-item">
            <span class="summary-val">{{ objectifs|length }}</span>
            <span class="summary-label">Total Objectifs</span>
        </div>
        <div class="summary-item">
            <span class="summary-val">{{ objectifs|filter(o => o.statut == 'termine')|length }}</span>
            <span class="summary-label">Complétés</span>
        </div>
        <div class="summary-item">
            <span class="summary-val">
                {% set total = objectifs|length %}
                {% if total > 0 %}
                    {{ ((objectifs|filter(o => o.statut == 'termine')|length / total) * 100)|round }}%
                {% else %}0%{% endif %}
            </span>
            <span class="summary-label">Taux de réussite</span>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th width="35%">Objectif</th>
                <th width="15%">Statut</th>
                <th width="20%">Période</th>
                <th width="30%">Description</th>
            </tr>
        </thead>
        <tbody>
            {% for objectif in objectifs %}
                <tr>
                    <td>
                        <strong>{{ objectif.titre }}</strong>
                        <br>
                        <span style="font-size: 8pt; color: #666;">ID: #{{ objectif.id }}</span>
                    </td>
                    <td>
                        <span class="status status-{{ objectif.statut }}">
                            {{ objectif.statut|replace({'_':' '})|capitalize }}
                        </span>
                    </td>
                    <td style="font-size: 9pt;">
                        Du {{ objectif.dateDebut|date('d/m/y') }}<br>
                        au {{ objectif.dateFin|date('d/m/y') }}
                    </td>
                    <td style="font-size: 8pt; color: #64748b;">
                        {{ objectif.description|default('N/A')|slice(0, 150) }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Document officiel Evolia Admin - Page 1/1
    </div>
</body>
</html>
