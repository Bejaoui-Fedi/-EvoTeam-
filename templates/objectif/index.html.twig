{% extends 'base.html.twig' %}

{% block title %}Mes Objectifs — Evolia{% endblock %}

{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<style>
    :root {
        --primary: #1a3a2e;
        --primary-dark: #2d6a4f;
        --success: #22c55e;
        --warning: #f59e0b;
        --danger: #ef4444;
        --bg: #f1f5f9;
        --bg-card: #ffffff;
        --border: #e2e8f0;
        --text: #1a3a2e;
        --text-muted: #64748b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { 
        background: #f8fafc; 
        color: var(--text); 
        font-family: 'Inter', sans-serif; 
        min-height: 100vh; 
        overflow-x: hidden; 
        position: relative;
    }
    body::before {
        content: ''; position: fixed; top: -10%; right: -10%; width: 40%; height: 50%;
        background: radial-gradient(circle, rgba(34, 197, 94, 0.05) 0%, transparent 70%);
        z-index: -1; pointer-events: none;
    }
    body::after {
        content: ''; position: fixed; bottom: -10%; left: -10%; width: 50%; height: 60%;
        background: radial-gradient(circle, rgba(14, 165, 233, 0.05) 0%, transparent 70%);
        z-index: -1; pointer-events: none;
    }
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    .admin-scope { display: flex; min-height: 100vh; }
    
    .page-header {
        background: linear-gradient(135deg, #1a3a2e 0%, #2d6a4f 100%);
        padding: 2.5rem 3rem;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
        color: #fff;
    }
    .page-header h1 { font-size: 2.2rem; font-weight: 700; color: #fff; }
    .page-header p { color: rgba(255, 255, 255, 0.8); font-size: 1rem; margin-top: 0.3rem; text-transform: uppercase; letter-spacing: 1px; }

    .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.4rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; cursor: pointer; border: none; text-decoration: none; transition: all 0.3s; }
    .btn-primary { background: var(--primary); color: #fff; border: 1px solid rgba(255,255,255,0.1); }
    .btn-primary:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(26, 58, 46, 0.2); }
    .btn-white { background: #fff; color: var(--primary); }
    .btn-white:hover { background: #f8f9fa; transform: translateY(-2px); }
    .btn-outline { background: #fff; color: var(--text-muted); border: 1px solid var(--border); }
    .btn-outline:hover { border-color: var(--primary); color: var(--primary); }
    .btn-danger { background: #fff0f0; color: var(--danger); border: 1px solid #ffcccc; }
    .btn-danger:hover { background: var(--danger); color: #fff; }
    .container-fluid { width: 100%; padding: 0 1.5rem 4rem 1.5rem; }

    /* Stats Grid Ultra-Premium */
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 3.5rem; }
    /* Statistics Grid - 3 Columns */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }
    @media (max-width: 992px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .stat-grid { grid-template-columns: 1fr; } }

    .stat-card {
        background: #fff;
        border-radius: 24px;
        padding: 2.2rem;
        border: 1px solid rgba(0, 0, 0, 0.03);
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
        overflow: hidden;
        min-height: 180px;
        justify-content: center;
    }
    .stat-card::after {
        content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 4px; opacity: 0.6;
    }
    .stat-card:nth-child(1)::after { background: #0ea5e9; box-shadow: 0 0 15px #0ea5e9; }
    .stat-card:nth-child(2)::after { background: #f59e0b; box-shadow: 0 0 15px #f59e0b; }
    .stat-card:nth-child(3)::after { background: #10b981; box-shadow: 0 0 15px #10b981; }
    
    .stat-card:hover { transform: translateY(-8px); box-shadow: 0 25px 50px rgba(0,0,0,0.1); }
    .stat-icon {
        width: 65px; height: 65px;
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }
    .stat-icon-total    { background: #f0f9ff; color: #0ea5e9; }
    .stat-icon-active   { background: #fffbeb; color: #f59e0b; }
    .stat-icon-complete { background: #f0fdf4; color: #10b981; }

    .stat-info .stat-label { font-size: 0.85rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1.5px; }
    .stat-info .stat-value { font-size: 2.8rem; font-weight: 900; color: #1a3a2e; line-height: 1; }

    /* Objective Grid - Strict 4 Columns */
    .obj-grid { 
        display: grid; 
        grid-template-columns: repeat(4, 1fr); 
        gap: 1.5rem; 
        width: 100%;
    }

    @media (max-width: 1600px) {
        .obj-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 1200px) {
        .obj-grid { grid-template-columns: repeat(2, 1fr); }
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
        .obj-grid { grid-template-columns: 1fr; }
        .stats-grid { grid-template-columns: 1fr; }
    }

    /* Ultra-Premium Card */
    .obj-card {
        background: #ffffff;
        border-radius: 28px;
        padding: 1.8rem;
        border: 1px solid rgba(0, 0, 0, 0.04);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
    }
    .obj-card::before {
        content: ''; position: absolute; top: 0; left: 0; width: 6px; height: 100%;
        opacity: 0.8;
    }
    .obj-card-en_cours::before { background: #0ea5e9; }
    .obj-card-termine::before { background: #8b5cf6; }
    .obj-card-abandonne::before { background: #f43f5e; }

    .obj-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 40px 80px rgba(0,0,0,0.12);
    }
    .obj-card-en_cours:hover { border-color: rgba(14, 165, 233, 0.2); }
    .obj-card-termine:hover { border-color: rgba(139, 92, 246, 0.2); }
    .obj-card-abandonne:hover { border-color: rgba(244, 63, 94, 0.2); }

    .obj-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
    .obj-card-title { font-size: 1.4rem; font-weight: 800; color: #1a3a2e; margin-bottom: 0.5rem; line-height: 1.3; }
    .obj-card-en_cours .obj-card-title { color: #075985; }
    .obj-card-termine .obj-card-title { color: #5b21b6; }
    .obj-card-abandonne .obj-card-title { color: #9f1239; }

    .badge-status {
        padding: 0.5rem 1rem;
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .badge-en_cours   { background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; }
    .badge-termine    { background: #ede9fe; color: #7c3aed; border: 1px solid #ddd6fe; }
    .badge-abandonne  { background: #ffe4e6; color: #e11d48; border: 1px solid #fecdd3; }

    .obj-card-body { position: relative; }
    .obj-card-desc { color: #64748b; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; }

    /* Beautiful Progress Bar */
    .progress-section { margin-bottom: 2rem; }
    .progress-info { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 700; color: #64748b; margin-bottom: 0.6rem; }
    .progress-track { height: 8px; background: #f1f5f9; border-radius: 20px; position: relative; overflow: hidden; }
    .progress-bar {
        height: 100%;
        border-radius: 20px;
        transition: width 1s cubic-bezier(0.1, 0, 0, 1);
    }
    .progress-bar-low { background: linear-gradient(90deg, #f43f5e, #fb923c); box-shadow: 0 0 10px rgba(244, 63, 94, 0.3); }
    .progress-bar-mid { background: linear-gradient(90deg, #fb923c, #f59e0b); box-shadow: 0 0 10px rgba(245, 158, 11, 0.3); }
    .progress-bar-high { background: linear-gradient(90deg, #10b981, #34d399); box-shadow: 0 0 10px rgba(16, 185, 129, 0.3); }

    /* Toolbar Styling */
    .toolbar { 
        background: #fff; 
        padding: 1.5rem; 
        border-radius: 20px; 
        margin-bottom: 2.5rem; 
        border: 1px solid var(--border);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .obj-card-meta {
        display: flex;
        justify-content: space-between;
        padding: 1.2rem 0;
        border-top: 1px solid #f1f5f9;
        margin-bottom: 1.5rem;
        color: #64748b;
        font-size: 0.85rem;
    }
    .meta-item { display: flex; align-items: center; gap: 0.5rem; font-weight: 500; }
    .meta-item i { color: #2d6a4f; }

    .obj-card-footer { display: flex; gap: 0.8rem; }
    .btn-card {
        flex: 1;
        padding: 0.8rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s;
        text-decoration: none;
    }
    .btn-card-view { background: #f8fafc; color: #1a3a2e; border: 1px solid #e2e8f0; }
    .btn-card-view:hover { background: #1a3a2e; color: #fff; border-color: #1a3a2e; }
    .btn-card-edit { background: #2d6a4f; color: #fff; }
    .btn-card-edit:hover { background: #1a3a2e; box-shadow: 0 8px 20px rgba(26, 58, 46, 0.2); }
    .btn-card-delete {
        width: 45px;
        background: #fff;
        color: #ef4444;
        border: 1px solid #fee2e2;
    }
    .btn-card-delete:hover { background: #ef4444; color: #fff; border-color: #ef4444; }

    /* Empty state premium */
    .empty-state {
        grid-column: 1 / -1;
        padding: 5rem;
        text-align: center;
        background: rgba(255, 255, 255, 0.5);
        border: 2px dashed #e2e8f0;
        border-radius: 32px;
    }
    .empty-state i { font-size: 4rem; color: #2d6a4f; opacity: 0.2; margin-bottom: 1.5rem; }

    .nav-filters {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
        padding: 1.5rem 2rem;
        border-radius: 24px;
        margin-bottom: 3rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }
</style>
{% endblock %}

{% block body %}
<div class="admin-scope">
    {% include 'admin_nav_bar/index.html.twig' %}

    <div class="admin-main-content">
        {# Header Premium #}
        <div class="d-flex justify-content-between align-items-center mb-5 px-4">
            <div class="header-title">
                <div class="d-flex align-items-center gap-4">
                    <div class="p-4 bg-white rounded-5 shadow-sm border border-light">
                        <i class="fa-solid fa-bullseye fs-2 text-success"></i>
                    </div>
                    <div>
                        <h1 class="display-6 fw-bold mb-0">Mes Objectifs</h1>
                        <p class="small text-uppercase tracking-wider">Planification & Suivi</p>
                    </div>
                </div>
            </div>
            <div class="header-actions d-flex gap-3">
                <a href="{{ path('exercice_index') }}" class="btn btn-outline border-secondary-subtle bg-white shadow-sm px-4 rounded-4" style="font-weight: 600; color: #1a3a2e;">
                    <i class="fa-solid fa-dumbbell me-2 text-success"></i> Exercices
                </a>
                <a href="{{ path('objectif_export_pdf') }}" class="btn btn-outline border-secondary-subtle bg-white shadow-sm px-4 rounded-4" style="font-weight: 600; color: #1a3a2e;">
                    <i class="fa-solid fa-file-pdf me-2 text-danger"></i> PDF
                </a>
                <a href="{{ path('objectif_new') }}" class="btn btn-success px-4 rounded-4 shadow-sm fw-bold">
                    <i class="fa-solid fa-plus me-2"></i> Nouvel Objectif
                </a>
            </div>
        </div>

        <div class="container-fluid px-4">
            {# Flash messages #}
            {% for msg in app.flashes('success') %}
                <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4">✅ {{ msg }}</div>
            {% endfor %}
            {% for msg in app.flashes('error') %}
                <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4">❌ {{ msg }}</div>
            {% endfor %}

            {# Stats Row #}
            <div class="stat-grid">
                <div class="stat-card">
                    <div class="stat-icon stat-icon-total"><i class="fa-solid fa-layer-group"></i></div>
                    <div class="stat-info">
                        <div class="stat-label">Total Objectifs</div>
                        <div class="stat-value">{{ stats.total }}</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon stat-icon-active"><i class="fa-solid fa-spinner"></i></div>
                    <div class="stat-info">
                        <div class="stat-label">En cours</div>
                        <div class="stat-value">{{ stats.enCours }}</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon stat-icon-complete"><i class="fa-solid fa-trophy"></i></div>
                    <div class="stat-info">
                        <div class="stat-label">Taux Réussite</div>
                        <div class="stat-value">{{ stats.taux }}%</div>
                    </div>
                </div>
            </div>

            {# Toolbar: Search, Filter, Sort #}
            <div class="toolbar">
                <form method="get" class="search-form d-flex gap-3 flex-wrap">
                    <div class="flex-grow-1" style="position:relative;">
                        <input type="text" name="q" value="{{ search }}" class="form-control" placeholder="🔍 Rechercher un objectif..." style="padding-left: 2.5rem; border-radius:15px; border:1px solid #e2e8f0;">
                    </div>
                    
                    <select name="statut" class="form-select w-auto" style="border-radius:15px;" onchange="this.form.submit()">
                        <option value="">Tous les statuts</option>
                        <option value="en_cours" {{ statut == 'en_cours' ? 'selected' }}>🔵 En cours</option>
                        <option value="termine" {{ statut == 'termine' ? 'selected' }}>🟢 Terminé</option>
                        <option value="abandonne" {{ statut == 'abandonne' ? 'selected' }}>🔴 Abandonné</option>
                    </select>

                    <select name="sort" class="form-select w-auto" style="border-radius:15px;" onchange="this.form.submit()">
                        <option value="dateDebut" {{ sort == 'dateDebut' ? 'selected' }}>📅 Date (Début)</option>
                        <option value="dateFin" {{ sort == 'dateFin' ? 'selected' }}>🏁 Date (Fin)</option>
                        <option value="titre" {{ sort == 'titre' ? 'selected' }}>🔤 Titre</option>
                        <option value="statut" {{ sort == 'statut' ? 'selected' }}>📊 Statut</option>
                    </select>

                    <select name="direction" class="form-select w-auto" style="border-radius:15px;" onchange="this.form.submit()">
                        <option value="DESC" {{ direction == 'DESC' ? 'selected' }}>⬇️ Descendant</option>
                        <option value="ASC" {{ direction == 'ASC' ? 'selected' }}>⬆️ Ascendant</option>
                    </select>

                    <button type="submit" class="btn btn-primary" style="border-radius:15px; padding:0 1.5rem;">Filtrer</button>
                    
                    {% if search or statut or sort != 'dateDebut' %}
                        <a href="{{ path('objectif_index') }}" class="btn btn-outline" style="border-radius:15px; color:#64748b; border-color:#e2e8f0;">✕</a>
                    {% endif %}
                </form>
            </div>

            {# Objective Grid #}
            <div class="obj-grid">
                {% for objectif in objectifs %}
                    {% set nbExercices = objectif.exercices|length %}
                    {% set progres = objectif.dateFin and objectif.dateDebut
                        ? max(0, min(100, (date()|date('U') - objectif.dateDebut|date('U')) * 100 // ((objectif.dateFin|date('U') - objectif.dateDebut|date('U')) ?: 1)))
                        : 0 %}
                    <div class="obj-card obj-card-{{ objectif.statut }}">
                        <div class="obj-card-header">
                            <span class="badge-status badge-{{ objectif.statut }}">
                                {% if objectif.statut == 'en_cours' %}En cours
                                {% elseif objectif.statut == 'termine' %}Terminé
                                {% else %}Abandonné{% endif %}
                            </span>
                            <div class="d-flex gap-2">
                                <span class="badge bg-white text-{{ (progres > 70 ? 'success' : (progres > 30 ? 'warning' : 'danger')) }} border shadow-sm">{{ nbExercices }} Exercices</span>
                            </div>
                        </div>

                        <div class="obj-card-body">
                            <h3 class="obj-card-title">{{ objectif.titre }}</h3>
                            <p class="obj-card-desc">
                                {{ (objectif.description|default('Aucune description définie pour cet objectif.'))|slice(0, 120) }}...
                            </p>

                            <div class="progress-section">
                                <div class="progress-info">
                                    <span>Progression</span>
                                    <span>{{ progres }}%</span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-bar {{ (progres > 70 ? 'progress-bar-high' : (progres > 30 ? 'progress-bar-mid' : 'progress-bar-low')) }}" style="width: {{ progres }}%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="obj-card-meta">
                            <div class="meta-item"><i class="fa-solid fa-calendar-day"></i> {{ objectif.dateDebut|date('d/m/Y') }}</div>
                            <div class="meta-item"><i class="fa-solid fa-flag-checkered"></i> {{ objectif.dateFin ? objectif.dateFin|date('d/m/Y') : '—' }}</div>
                        </div>

                        <div class="obj-card-footer">
                            <a href="{{ path('objectif_show', {id: objectif.id}) }}" class="btn-card btn-card-view">
                                <i class="fa-solid fa-eye"></i> Voir
                            </a>
                            <a href="{{ path('objectif_edit', {id: objectif.id}) }}" class="btn-card btn-card-edit">
                                <i class="fa-solid fa-pen-nib"></i> Modifier
                            </a>
                            <form method="post" action="{{ path('objectif_delete', {id: objectif.id}) }}" onsubmit="return confirm('Confirmer la suppression ?')" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ objectif.id) }}">
                                <button type="submit" class="btn-card btn-card-delete shadow-sm" style="border:none;">
                                    <i class="fa-solid fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}

                {% if objectifs is empty %}
                    <div class="empty-state">
                        <i class="fa-solid fa-ghost"></i>
                        <h3>Aucun objectif trouvé</h3>
                        <p class="text-muted">Il est temps de lancer une nouvelle routine !</p>
                        <a href="{{ path('objectif_new') }}" class="btn btn-primary rounded-pill px-5 mt-4">Créer mon premier objectif</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
