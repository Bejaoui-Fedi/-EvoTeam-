{% extends 'base.html.twig' %}

{% block title %}Evolia — Gestion Utilisateurs{% endblock %}

{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    <style>
        /* Advanced Search Bar Styling */
        .advanced-search-container {
            position: relative;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.03);
            backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            z-index: 10;
        }

        .advanced-search-container:focus-within {
            box-shadow: 0 15px 50px rgba(30, 77, 107, 0.1);
            transform: translateY(-2px);
            border-color: rgba(30, 77, 107, 0.2);
        }

        .premium-search-input {
            width: 100%;
            border: none;
            background: transparent;
            padding: 12px 20px 12px 50px;
            font-size: 1.05rem;
            color: var(--text-dark);
            outline: none;
        }

        .premium-search-input::placeholder {
            color: #a0aec0;
            font-weight: 500;
        }

        .search-icon-anim {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary-navy);
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .advanced-search-container:focus-within .search-icon-anim {
            color: var(--green-deep);
            transform: translateY(-50%) scale(1.1);
        }

        .glow-effect {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            border-radius: 16px;
            background: linear-gradient(120deg, rgba(74,135,168,0.1), rgba(37,106,143,0), rgba(72,187,120,0.1));
            z-index: -1;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .advanced-search-container:focus-within .glow-effect {
            opacity: 1;
        }

        .premium-filter-select {
            border: 2px solid transparent;
            background: #f8fafc;
            border-radius: 12px;
            padding: 10px 15px;
            font-weight: 600;
            color: var(--primary-navy);
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
        }

        .premium-filter-select:hover {
            background: white;
            border-color: rgba(30, 77, 107, 0.1);
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .premium-filter-select:focus {
            outline: none;
            border-color: var(--primary-navy);
            background: white;
        }
        
        /* Table Row Animation */
        .table tbody tr {
            transition: all 0.3s ease-in-out;
        }
        .table tbody tr.filtered-out {
            opacity: 0;
            visibility: hidden;
            display: none;
        }
        
        /* Table Avatar Styling */
        .table-avatar-wrapper {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            overflow: hidden;
            background: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }
        .table-avatar-wrapper:hover {
            transform: scale(1.1);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }
        .table-avatar-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .table-avatar-placeholder {
            font-size: 1.2rem;
            color: #cbd5e1;
        }
    </style>
{% endblock %}

{% block body %}

<div class="admin-scope">
<div class="admin-sidebar">
    <div class="sidebar-brand">
        <div class="logo-animation-wrapper mb-4" style="position: relative; width: 120px; height: 120px; margin: 0 auto; display: flex; align-items: center; justify-content: center;">
            <div class="logo-animation-bg" style="position: absolute; inset: 10px; background: rgba(255, 255, 255, 0.08); border-radius: 50%; box-shadow: 0 8px 32px rgba(0,0,0,0.2);"></div>
            <lottie-player 
                src="{{ asset('Logo_Evolia.json') }}" 
                background="transparent" 
                speed="1" 
                style="width: 160px; height: 160px; position: relative; z-index: 2;" 
                loop 
                autoplay>
            </lottie-player>
        </div>
        <div class="d-flex align-items-center justify-content-center gap-2">
            <h2 class="mb-0" style="font-size: 1.5rem; letter-spacing: 2px;">EVOLIA</h2>
            <span class="sidebar-badge">Admin</span>
        </div>
    </div>

    <div class="admin-sidebar-nav">
        <div class="nav-section-title">Principal</div>
        <a href="{{ path('app_admin_dashboard') }}" class="admin-nav-link">
            <i class="fa-solid fa-chart-line"></i> Tableau de bord
        </a>
        <a href="{{ path('app_user_list') }}" class="admin-nav-link active">
            <i class="fa-solid fa-users"></i> Utilisateurs
        </a>

        <div class="nav-section-title mt-4">Gestion</div>
        <a href="#" class="admin-nav-link">
            <i class="fa-solid fa-calendar-days"></i> Événements
        </a>
        <a href="#" class="admin-nav-link">
            <i class="fa-solid fa-dumbbell"></i> Exercices
        </a>
        <a href="#" class="admin-nav-link">
            <i class="fa-solid fa-heart-pulse"></i> Bien-être
        </a>
        <a href="#" class="admin-nav-link">
            <i class="fa-solid fa-clipboard-list"></i> Consult-RDV
        </a>
    </div>

    <div class="admin-sidebar-footer">
        <a href="{{ path('app_home') }}" class="btn-logout" data-turbo="false">
            <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
        </a>
    </div>
</div>

<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="header-title">
            <div class="d-flex align-items-center gap-4">
                <div class="p-4 bg-white rounded-5 shadow-sm border border-light">
                    <i class="fa-solid fa-users-gear fs-2 text-success"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-0">Gestion Utilisateurs</h1>
                    <p class="small text-uppercase tracking-wider">Administration du personnel & patients</p>
                </div>
            </div>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-header">
                <span>COMMUNAUTÉ</span>
                <div class="p-2 bg-light rounded-circle"><i class="fa-solid fa-users text-success"></i></div>
            </div>
            <div class="stat-value">{{ stats.total }} <small class="fs-6 fw-normal opacity-50">Membres</small></div>
            <div class="mt-2 text-muted small">Inscriptions totales</div>
        </div>
        <div class="stat-card active">
            <div class="stat-header">
                <span>ENGAGEMENT</span>
                <div class="p-2 bg-success bg-opacity-10 rounded-circle"><i class="fa-solid fa-bolt text-success"></i></div>
            </div>
            <div class="stat-value">{{ stats.active_percentage }}% <small class="fs-6 fw-normal opacity-50">Actifs</small></div>
            <div class="mt-2 text-success small"><i class="fa-solid fa-check-double"></i> Comptes vérifiés</div>
        </div>
        <div class="stat-card inactive">
            <div class="stat-header">
                <span>EN ATTENTE / INACTIFS</span>
                <div class="p-2 bg-light rounded-circle"><i class="fa-solid fa-clock text-muted"></i></div>
            </div>
            <div class="stat-value">{{ stats.inactive }}</div>
            <div class="mt-2 text-muted small">Aucune action requise</div>
        </div>
    </div>

    <div class="management-card">
        <div class="card-header-actions mb-4">
            <div class="advanced-search-container w-100 d-flex flex-wrap gap-3 align-items-center">
                <div class="glow-effect"></div>
                
                <div class="position-relative flex-grow-1" style="max-width: 550px;">
                    <i class="fa-solid fa-magnifying-glass search-icon-anim"></i>
                    <input type="text" id="live-search" class="premium-search-input" placeholder="Recherche instantanée par nom, email ou téléphone...">
                </div>
                
                <div class="filter-box">
                    <select id="live-role-filter" class="form-select premium-filter-select">
                        <option value="">Tous les rôles</option>
                        <option value="Administrateur">Administrateurs</option>
                        <option value="Patient">Patients</option>
                        <option value="Psychologue/Coach">Psychologues & Coachs</option>
                    </select>
                </div>

                <div class="d-flex gap-2 ms-auto">
                    <button class="btn-action" title="Actualiser" onclick="window.location.reload();">
                        <i class="fa-solid fa-rotate"></i>
                    </button>
                    <a href="{{ path('app_admin_user_new') }}" class="btn-add ms-2 text-decoration-none d-flex align-items-center justify-content-center" style="transition: transform 0.2s;">
                        <i class="fa-solid fa-user-plus me-2"></i> Nouvel Utilisateur
                    </a>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Avatar</th>
                        <th>Nom complet</th>
                        <th>Adresse email</th>
                        <th>Rôle</th>
                        <th>Téléphone</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>
                            <div class="table-avatar-wrapper">
                                {% if user.userProfile and user.userProfile.avatar %}
                                    <img src="{{ asset('uploads/avatars/' ~ user.userProfile.avatar) }}" alt="Avatar" class="table-avatar-img">
                                {% else %}
                                    <i class="fa-solid fa-user table-avatar-placeholder"></i>
                                {% endif %}
                            </div>
                        </td>
                        <td><strong>{{ user.nom }}</strong></td>
                        <td>{{ user.email }}</td>
                        <td>
                            <span class="role-badge">
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <i class="fa-solid fa-user-shield text-dark"></i> Administrateur
                                {% elseif 'ROLE_PSYCHOLOGUE' in user.roles or 'ROLE_COACH' in user.roles %}
                                    <i class="fa-solid fa-user-doctor text-info"></i> Psychologue/Coach
                                {% else %}
                                    <i class="fa-solid fa-heart text-danger"></i> Patient
                                {% endif %}
                            </span>
                        </td>
                        <td>{{ user.telephone }}</td>
                        <td>
                            {% if user.actif %}
                                <span class="status-badge status-active"><i class="fa-solid fa-check"></i> Actif</span>
                            {% else %}
                                <span class="status-badge status-inactive"><i class="fa-solid fa-xmark"></i> Inactif</span>
                            {% endif %}
                        </td>
                        <td class="action-btns">
                            <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn-action"><i class="fa-solid fa-pen-to-square"></i></a>
                            <form method="post" action="{{ path('app_user_toggle', {'id': user.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                <button type="submit" class="btn-action" style="border:none;background:none;padding:0;" title="{{ user.actif ? 'Désactiver' : 'Activer' }}">
                                    <i class="fa-solid fa-user-tag {% if not user.actif %}opacity-50{% endif %}"></i>
                                </button>
                            </form>
                            
                            <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button type="submit" class="btn-action btn-delete" style="border:none;background:none;padding:0;"><i class="fa-solid fa-trash-can"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center">Aucun utilisateur trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('turbo:load', initLiveSearch);
    document.addEventListener('DOMContentLoaded', initLiveSearch);

    function initLiveSearch() {
        const searchInput = document.getElementById('live-search');
        const roleFilter = document.getElementById('live-role-filter');
        const tableRows = document.querySelectorAll('tbody tr');

        if (!searchInput || !roleFilter) return;

        function filterTable() {
            const query = searchInput.value.toLowerCase().trim();
            const role = roleFilter.value.toLowerCase();

            tableRows.forEach(row => {
                // Ignore the "Aucun utilisateur trouvé" row if it exists
                if (row.cells.length === 1) return;

                const name = row.cells[1].textContent.toLowerCase();
                const email = row.cells[2].textContent.toLowerCase();
                const rowRole = row.cells[3].textContent.toLowerCase();
                const phone = row.cells[4].textContent.toLowerCase();

                const matchesSearch = query === '' || 
                                      name.includes(query) || 
                                      email.includes(query) || 
                                      phone.includes(query);
                                      
                const matchesRole = role === '' || rowRole.includes(role);

                if (matchesSearch && matchesRole) {
                    row.classList.remove('filtered-out');
                } else {
                    row.classList.add('filtered-out');
                }
            });
        }

        searchInput.addEventListener('input', filterTable);
        roleFilter.addEventListener('change', filterTable);
    }
    initLiveSearch();
</script>
{% endblock %}
