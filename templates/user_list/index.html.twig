{% extends 'base.html.twig' %}

{% block title %}Evolia — Gestion Utilisateurs{% endblock %}

{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
{% endblock %}

{% block body %}

<div class="admin-scope">
{% include 'admin_nav_bar/index.html.twig' %}

<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="header-title">
            <div class="d-flex align-items-center gap-4">
                <div class="p-4 bg-white rounded-5 shadow-sm border border-light">
                    <i class="fa-solid fa-users-gear fs-2 text-success"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-0">Gestion Utilisateurs</h1>
                    <p class="small text-uppercase tracking-wider">Administration du personnel & patients</p>
                </div>
            </div>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-header">
                <span>COMMUNAUTÉ</span>
                <div class="p-2 bg-light rounded-circle"><i class="fa-solid fa-users text-success"></i></div>
            </div>
            <div class="stat-value">11 <small class="fs-6 fw-normal opacity-50">Membres</small></div>
            <div class="mt-2 text-muted small">Inscriptions totales</div>
        </div>
        <div class="stat-card active">
            <div class="stat-header">
                <span>ENGAGEMENT</span>
                <div class="p-2 bg-success bg-opacity-10 rounded-circle"><i class="fa-solid fa-bolt text-success"></i></div>
            </div>
            <div class="stat-value">100% <small class="fs-6 fw-normal opacity-50">Actifs</small></div>
            <div class="mt-2 text-success small"><i class="fa-solid fa-check-double"></i> Comptes vérifiés</div>
        </div>
        <div class="stat-card inactive">
            <div class="stat-header">
                <span>EN ATTENTE</span>
                <div class="p-2 bg-light rounded-circle"><i class="fa-solid fa-clock text-muted"></i></div>
            </div>
            <div class="stat-value">0</div>
            <div class="mt-2 text-muted small">Aucune action requise</div>
        </div>
    </div>

    <div class="management-card">
        <div class="card-header-actions">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Rechercher par nom, email ou téléphone...">
            </div>
            <div class="d-flex gap-2">
                <button class="btn-add">
                    <i class="fa-solid fa-plus"></i> Nouvel Utilisateur
                </button>
                <button class="btn-action">
                    <i class="fa-solid fa-rotate"></i>
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom complet</th>
                        <th>Adresse email</th>
                        <th>Rôle</th>
                        <th>Téléphone</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>49</td>
                        <td><strong>admin</strong></td>
                        <td>admin@gmail.com</td>
                        <td><span class="role-badge"><i class="fa-solid fa-user-shield text-dark"></i> Administrateur</span></td>
                        <td>56321978</td>
                        <td><span class="status-badge status-active"><i class="fa-solid fa-check"></i> Actif</span></td>
                        <td class="action-btns">
                            <a href="#" class="btn-action"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a href="#" class="btn-action"><i class="fa-solid fa-user-tag"></i></a>
                            <a href="#" class="btn-action btn-delete"><i class="fa-solid fa-trash-can"></i></a>
                        </td>
                    </tr>
                    <tr>
                        <td>48</td>
                        <td><strong>Test</strong></td>
                        <td>user@gmail.com</td>
                        <td><span class="role-badge"><i class="fa-solid fa-user-doctor text-info"></i> Psychologue/Coach</span></td>
                        <td>56321789</td>
                        <td><span class="status-badge status-active"><i class="fa-solid fa-check"></i> Actif</span></td>
                        <td class="action-btns">
                            <a href="#" class="btn-action"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a href="#" class="btn-action"><i class="fa-solid fa-user-tag"></i></a>
                            <a href="#" class="btn-action btn-delete"><i class="fa-solid fa-trash-can"></i></a>
                        </td>
                    </tr>
                    <tr>
                        <td>47</td>
                        <td><strong>fedi</strong></td>
                        <td>fedi@gmail.com</td>
                        <td><span class="role-badge"><i class="fa-solid fa-heart text-danger"></i> Patient</span></td>
                        <td>23654789</td>
                        <td><span class="status-badge status-active"><i class="fa-solid fa-check"></i> Actif</span></td>
                        <td class="action-btns">
                            <a href="#" class="btn-action"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a href="#" class="btn-action"><i class="fa-solid fa-user-tag"></i></a>
                            <a href="#" class="btn-action btn-delete"><i class="fa-solid fa-trash-can"></i></a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
