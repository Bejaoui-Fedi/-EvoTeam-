<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport des Exercices - Evolia Admin</title>
    <style>
        body { font-family: 'Helvetica', sans-serif; color: #333; line-height: 1.5; font-size: 11pt; }

        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #1a3a2e; padding-bottom: 10px; }
        .header h1 { color: #1a3a2e; margin: 0; font-size: 24pt; }
        .header p { color: #666; margin: 5px 0 0; }

        .footer { position: fixed; bottom: -20px; left: 0; right: 0; height: 30px;
                  text-align: center; font-size: 9pt; border-top: 1px solid #eee; padding-top: 5px; color: #888; }

        .summary { background: #f8fafc; padding: 15px; border-radius: 8px; margin-bottom: 30px; }
        .summary-item { display: inline-block; width: 30%; text-align: center; }
        .summary-val { display: block; font-size: 16pt; font-weight: bold; color: #1a3a2e; }
        .summary-label { font-size: 8pt; text-transform: uppercase; color: #64748b; }

        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background: #1a3a2e; color: #fff; text-align: left; padding: 10px; font-size: 9pt; text-transform: uppercase; }
        td { border-bottom: 1px solid #e2e8f0; padding: 9px 10px; vertical-align: top; font-size: 9pt; }
        tr:nth-child(even) td { background: #f9fafb; }

        .badge { padding: 3px 8px; border-radius: 4px; font-size: 8pt; font-weight: bold; text-transform: uppercase; }
        .diff-facile    { background: #d1fae5; color: #065f46; }
        .diff-moyen     { background: #fef3c7; color: #92400e; }
        .diff-difficile { background: #fee2e2; color: #991b1b; }
    </style>
</head>
<body>
    <div class="header">
        <h1>EVOLIA ADMIN</h1>
        <p>Rapport des Exercices — Généré le {{ date|date('d/m/Y H:i') }}</p>
    </div>

    <div class="summary">
        <div class="summary-item">
            <span class="summary-val">{{ exercices|length }}</span>
            <span class="summary-label">Total Exercices</span>
        </div>
        <div class="summary-item">
            {% set dureeTotal = 0 %}
            {% for e in exercices %}{% set dureeTotal = dureeTotal + e.duree %}{% endfor %}
            <span class="summary-val">{{ exercices|length > 0 ? (dureeTotal / exercices|length)|round : 0 }} min</span>
            <span class="summary-label">Durée Moyenne</span>
        </div>
        <div class="summary-item">
            <span class="summary-val">{{ exercices|filter(e => e.difficulte == 'difficile')|length }}</span>
            <span class="summary-label">Exercices Difficiles</span>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th width="28%">Titre</th>
                <th width="14%">Type</th>
                <th width="13%">Difficulté</th>
                <th width="10%">Durée</th>
                <th width="13%">Date</th>
                <th width="22%">Objectif lié</th>
            </tr>
        </thead>
        <tbody>
            {% for exercice in exercices %}
                <tr>
                    <td><strong>{{ exercice.titre }}</strong><br>
                        <span style="font-size:8pt;color:#888;">#{{ exercice.id }}</span>
                    </td>
                    <td>{{ exercice.type|replace({'_': ' '})|capitalize }}</td>
                    <td>
                        <span class="badge diff-{{ exercice.difficulte }}">{{ exercice.difficulte|capitalize }}</span>
                    </td>
                    <td>{{ exercice.duree }} min</td>
                    <td>{{ exercice.date|date('d/m/Y') }}</td>
                    <td>{{ exercice.objectif ? exercice.objectif.titre|slice(0, 30) : '—' }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" style="text-align:center;color:#888;">Aucun exercice trouvé.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Document officiel Evolia Admin — {{ exercices|length }} exercice(s) — Page 1/1
    </div>
</body>
</html>
