{% extends 'base.html.twig' %}

{% block title %}Evolia — Inscription Utilisateur{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_form.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <style>
        :root {
            --primary-navy: #1e4d6b;
            --secondary-blue: #4a87a8;
            --accent-azure: #f0f7fb;
            --text-dark: #1a2a3a;
            --premium-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        }

        body, html {
            margin: 0; padding: 0; height: 100%;
            overflow: hidden; font-family: 'Inter', sans-serif;
            background: #fff;
        }

        .split-container { display: flex; height: 100vh; width: 100%; }

        .visual-panel {
            flex: 1.2; position: relative; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
            background: var(--primary-navy);
        }

        .visual-content {
            position: relative; z-index: 5; text-align: center;
            color: white; padding: 40px;
        }

        .visual-content h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem; font-weight: 700; margin-bottom: 20px;
            text-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .visual-overlay {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(30, 77, 107, 0.8), rgba(30, 77, 107, 0.4));
            z-index: 2;
        }

        .form-panel {
            flex: 1; background: white; overflow-y: auto;
            display: flex; flex-direction: column; padding: 60px 80px;
            justify-content: flex-start;
            box-shadow: -10px 0 50px rgba(0,0,0,0.05);
        }

        .form-container { max-width: 440px; margin: 0 auto; width: 100%; }

        .brand-header { text-align: left; margin-bottom: 40px; }
        .brand-icon { font-size: 2.5rem; color: var(--primary-navy); margin-bottom: 15px; }

        h1 {
            font-family: 'Cormorant Garamond', serif !important;
            font-size: 2.4rem !important;
            font-weight: 700 !important; color: var(--primary-navy) !important;
            margin: 0 !important;
        }

        .subtitle {
            color: var(--secondary-blue) !important;
            font-size: 1rem !important; margin-top: 5px !important;
            opacity: 0.8;
        }

        .section-badge {
            font-size: 0.75rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 1px; color: var(--secondary-blue);
            padding: 4px 12px; background: var(--accent-azure);
            border-radius: 20px; display: inline-block;
        }

        .form-group { margin-bottom: 20px; width: 100%; }
        .form-label {
            font-weight: 700 !important; font-size: 0.85rem !important;
            color: var(--primary-navy) !important; margin-bottom: 8px !important;
            display: block; opacity: 0.9;
        }

        .form-control {
            border: 1.5px solid #e1e9f0 !important; border-radius: 12px !important;
            padding: 12px 18px !important; font-size: 0.95rem !important;
            background: #f8fafc !important; transition: all 0.3s ease !important;
        }

        .form-control:focus {
            border-color: var(--primary-navy) !important;
            background: white !important;
            box-shadow: 0 0 0 4px rgba(30, 77, 107, 0.1) !important;
        }

        .account-type-card {
            cursor: pointer;
            text-align: center;
        }

        .account-type-card .card-inner {
            padding: 12px; border: 1.5px solid #e1e9f0;
            border-radius: 12px; transition: all 0.2s;
            font-weight: 600; font-size: 0.9rem; color: var(--secondary-blue);
            background: #f8fafc;
        }

        .account-type-card input:checked + .card-inner {
            border-color: var(--primary-navy);
            background: var(--accent-azure);
            color: var(--primary-navy);
            box-shadow: 0 4px 12px rgba(30, 77, 107, 0.1);
        }

        .strength-bar {
            height: 4px; background: #e2e8f0; border-radius: 2px;
            overflow: hidden; width: 100%;
        }

        .strength-fill { height: 100%; width: 0; transition: all 0.3s; }

        .btn-login {
            width: 100%; height: 56px;
            background: var(--primary-navy) !important; color: white !important;
            border: none !important; border-radius: 12px !important;
            font-weight: 700 !important; font-size: 1.1rem !important;
            box-shadow: 0 10px 25px rgba(30, 77, 107, 0.2) !important;
            transition: all 0.3s ease !important; cursor: pointer;
        }

        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 15px 30px rgba(30, 77, 107, 0.3) !important; }

        .register-footer { text-align: center; font-size: 0.9rem; color: var(--secondary-blue); }
        .register-footer a { color: var(--primary-navy); font-weight: 700; text-decoration: none; }

        .modern-alert {
            padding: 14px 20px; border-radius: 12px; margin-bottom: 25px;
            display: flex; align-items: center; font-size: 0.9rem;
        }
        .alert-error { background: #fff5f5; color: #c53030; border: 1px solid #feb2b2; }
        .alert-success { background: #f0fff4; color: #2f855a; border: 1px solid #c6f6d5; }

        @media (max-width: 992px) {
            .visual-panel { display: none; }
            .form-panel { padding: 40px 20px; }
        }
    </style>
{% endblock %}

{% block body %}

<div class="split-container">
    
    {# ——— LEFT PANEL: VISUALS ——— #}
    <div class="visual-panel">
        <div id="bgCarousel" class="carousel slide carousel-fade h-100 w-100" data-bs-ride="carousel" data-bs-interval="2500" style="position: absolute; top:0; left:0;">
            <div class="carousel-inner h-100">
                <div class="carousel-item active h-100">
                    <img src="/images/bg-2.jpg" class="d-block w-100 h-100" alt="Bien-être 1" style="object-fit: cover;">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/bg-3.jpg" class="d-block w-100 h-100" alt="Bien-être 2" style="object-fit: cover;">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/bg-4.jpg" class="d-block w-100 h-100" alt="Bien-être 3" style="object-fit: cover;">
                </div>
            </div>
        </div>
        <div class="visual-overlay"></div>
        <div class="visual-content">
            <i class="fa-solid fa-heart-pulse mb-4" style="font-size: 4rem;"></i>
            <h2>Evolia Healthy Life</h2>
            <p class="lead">Commencez votre voyage vers un meilleur bien-être aujourd'hui.</p>
        </div>
    </div>

    {# ——— RIGHT PANEL: FORM ——— #}
    <div class="form-panel">
        <div class="form-container">
            
            <div class="brand-header animate__animated animate__fadeInDown">
                <i class="fa-solid fa-user-plus brand-icon"></i>
                <h1>Créer un compte</h1>
                <p class="subtitle">Patient • Coach • Psychologue</p>
            </div>

            {% if error is defined and error %}
                <div class="modern-alert alert-error animate__animated animate__headShake">
                    <i class="fa-solid fa-triangle-exclamation me-3"></i>
                    <div>{{ error }}</div>
                </div>
            {% endif %}

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="modern-alert alert-{{ label == 'error' ? 'error' : 'success' }} animate__animated animate__fadeInUp">
                        <i class="fa-solid fa-{{ label == 'error' ? 'circle-exclamation' : 'circle-check' }} me-3"></i>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('app_user_form') }}" autocomplete="off" class="animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                <input type="hidden" name="_token" value="{{ csrf_token('registration') }}">
                
                <div class="section-badge mb-3">Informations personnelles</div>
                
                <div class="form-group">
                    <label class="form-label">Nom complet</label>
                    <input type="text" class="form-control" name="fullname" placeholder="Votre nom" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Adresse Email</label>
                    <input type="email" class="form-control" name="email" placeholder="nom@exemple.com" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Téléphone</label>
                    <input type="tel" class="form-control" name="phone" placeholder="8 chiffres" pattern="[0-9]{8}" maxlength="8" required>
                </div>

                <div class="section-badge mb-3 mt-4">Type de compte</div>
                <div class="d-flex gap-3 mb-4">
                    <label class="account-type-card flex-fill">
                        <input type="radio" name="account_type" value="patient" checked class="d-none">
                        <div class="card-inner">Patient</div>
                    </label>
                    <label class="account-type-card flex-fill">
                        <input type="radio" name="account_type" value="coach" class="d-none">
                        <div class="card-inner">Coach</div>
                    </label>
                    <label class="account-type-card flex-fill">
                        <input type="radio" name="account_type" value="psychologue" class="d-none">
                        <div class="card-inner">Psy</div>
                    </label>
                </div>

                <div class="section-badge mb-3 mt-4">Sécurité</div>
                <div class="form-group">
                    <label class="form-label">Mot de passe</label>
                    <input type="password" class="form-control" name="password" placeholder="Min. 8 caractères" required autocomplete="new-password">
                    <div class="strength-container mt-2">
                        <div class="strength-bar"><div class="strength-fill"></div></div>
                        <div class="strength-label mt-1" style="font-size: 0.75rem; font-weight: 700;"></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Confirmer</label>
                    <input type="password" class="form-control" name="confirm_password" placeholder="Ressaisir le mot de passe" required autocomplete="new-password">
                </div>

                <div class="form-options mb-4">
                    <label class="d-flex align-items-center gap-2 m-0" style="cursor: pointer; opacity: 0.8;">
                        <input type="checkbox" name="terms" required style="width: 16px; height: 16px; accent-color: var(--primary-navy);"> 
                        <span>J'accepte les <a href="#" class="text-decoration-none fw-bold" style="color: var(--primary-navy);">conditions</a></span>
                    </label>
                </div>

                <button type="submit" class="btn-login" style="width: 100%;">
                    Créer mon compte
                </button>

                <div class="register-footer mt-4">
                    Déjà inscrit ? <a href="{{ path('app_user_login') }}">Connectez-vous ici</a>
                </div>

                <div class="text-center mt-4">
                    <a href="{{ path('app_home') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-4" style="font-size: 0.8rem;">
                       <i class="fa-solid fa-house me-1"></i> Accueil
                    </a>
                </div>

            </form>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function() {
    const initStrength = () => {
        const password = document.querySelector('input[name="password"]');
        const strengthFill = document.querySelector('.strength-fill');
        const strengthLabel = document.querySelector('.strength-label');

        if (!password || !strengthFill || !strengthLabel) return;

        password.addEventListener('input', function() {
            const val = password.value;
            let score = 0;

            if (!val) {
                strengthFill.style.width = '0%';
                strengthLabel.textContent = '';
                return;
            }

            if (val.length >= 8) score += 25;
            if (/[A-Z]/.test(val)) score += 25;
            if (/[0-9]/.test(val)) score += 25;
            if (/[^A-Za-z0-9]/.test(val)) score += 25;

            let color = '#ff6b6b';
            let label = 'Très Faible';

            if (score === 25) { color = '#ff6b6b'; label = 'Faible'; }
            else if (score === 50) { color = '#ffd166'; label = 'Moyen'; }
            else if (score === 75) { color = '#06d6a0'; label = 'Fort'; }
            else if (score === 100) { color = '#118ab2'; label = 'Excellent'; }

            strengthFill.style.width = score + '%';
            strengthFill.style.background = color;
            strengthLabel.style.color = color;
            strengthLabel.textContent = label;
        });
    };

    document.addEventListener('DOMContentLoaded', initStrength);
    document.addEventListener('turbo:load', initStrength);
})();
</script>
{% endblock %}
