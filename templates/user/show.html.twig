{% extends 'base.html.twig' %}

{% block title %}User Details{% endblock %}

{% block body %}
    <h1 class="title">User <span>Details</span></h1>
    <div class="hero-divider"></div>
    <p class="subtitle" style="text-align: center; margin-bottom: 30px;">Viewing profile for {{ user.nom }}</p>

    <div class="card admin" style="width: 100%; max-width: 600px; margin: 0 auto 2rem; padding: 30px;">
        <table class="table">
            <tbody>
                <tr>
                    <th style="width: 30%">Id</th>
                    <td>{{ user.id }}</td>
                </tr>
                <tr>
                    <th>Name</th>
                    <td>{{ user.nom }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ user.email }}</td>
                </tr>
                <tr>
                    <th>Role</th>
                    <td><span style="color: var(--green-light); font-weight: bold;">{{ user.role }}</span></td>
                </tr>
                <tr>
                    <th>Telephone</th>
                    <td>{{ user.telephone }}</td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>{{ user.actif ? 'Active' : 'Inactive' }}</td>
                </tr>
            </tbody>
        </table>

        <div style="display: flex; gap: 15px; margin-top: 25px; width: 100%;">
            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-admin" style="flex: 1;"><i class="fa fa-edit"></i> Edit</a>
            <a href="{{ path('app_user_index') }}" class="btn btn-personal" style="flex: 1;"><i class="fa fa-arrow-left"></i> Back to list</a>
        </div>
        
        <div style="margin-top: 20px; text-align: center;">
            <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button class="btn" style="background: rgba(255,100,100,0.2); color: #ff8888; border: 1px solid rgba(255,100,100,0.5);"><i class="fa fa-trash"></i> Delete User</button>
            </form>
        </div>
    </div>
{% endblock %}
