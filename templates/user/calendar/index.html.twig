{% extends 'user_nav_bar/index.html.twig' %}

{% block title %}Mon Agenda - Evolia{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); min-height: 100vh;">
    {# Header Section #}
    <div class="row mb-5">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between p-4 rounded-5 shadow-sm border-0" 
                 style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.3) !important;">
                <div>
                    <h2 class="fw-bold mb-1" style="background: linear-gradient(45deg, #1e4d6b, #2980b9); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        Mon Agenda Bien-être
                    </h2>
                    <p class="text-muted mb-0">Retrouvez toutes vos séances planifiées et vos événements personnels.</p>
                </div>
                <div class="d-flex gap-3">
                    <a href="https://calendar.google.com" target="_blank" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-external-link me-2"></i>Ouvrir dans Google
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Calendar Embed Section #}
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-5 overflow-hidden" 
                 style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                <div class="card-body p-0">
                    <div class="ratio ratio-16x9" style="min-height: 700px;">
                        <iframe src="{{ calendar_url }}" style="border: 0" frameborder="0" scrolling="no"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Tips Section #}
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="bg-white p-4 rounded-4 shadow-sm h-100">
                <i class="fa-solid fa-sync text-primary fs-3 mb-3"></i>
                <h5 class="fw-bold">Synchronisation en Temps Réel</h5>
                <p class="small text-muted mb-0">Tous les exercices planifiés depuis Evolia apparaissent instantanément ici.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white p-4 rounded-4 shadow-sm h-100">
                <i class="fa-solid fa-bell text-success fs-3 mb-3"></i>
                <h5 class="fw-bold">Rappels Automatiques</h5>
                <p class="small text-muted mb-0">Recevez des notifications 30 minutes avant chaque séance sur votre téléphone.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white p-4 rounded-4 shadow-sm h-100">
                <i class="fa-solid fa-mobile-screen text-info fs-3 mb-3"></i>
                <h5 class="fw-bold">Partout avec vous</h5>
                <p class="small text-muted mb-0">Votre planning Evolia est accessible sur tous vos appareils via Google Calendar.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.3s ease;
    }
    .card:hover {
        transform: translateY(-5px);
    }
</style>
{% endblock %}
