{% extends 'base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block body %}
    <h1 class="title">Users <span>Management</span></h1>
    <div class="hero-divider"></div>
    <p class="subtitle" style="text-align: center; margin-bottom: 30px;">Manage registered users</p>

    <div class="card admin" style="width: 100%; margin-bottom: 2rem; overflow-x: auto;">
        <table>
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.nom }}</td>
                    <td>{{ user.email }}</td>
                    <td><span style="color: var(--green-light); font-weight: bold;">{{ user.role }}</span></td>
                    <td>
                        {% if user.actif %}
                            <span style="color: #a7f3d0">Active</span>
                        {% else %}
                            <span style="color: #fca5a5">Inactive</span>
                        {% endif %}
                    </td>
                    <td>
                        <div style="display: flex; gap: 10px;">
                            <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-personal" style="padding: 6px 14px; font-size: 0.8rem; width: auto;"><i class="fa fa-eye"></i> View</a>
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-admin" style="padding: 6px 14px; font-size: 0.8rem; width: auto;"><i class="fa fa-edit"></i> Edit</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align: center; color: var(--green-pale); padding: 20px;">No users found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div style="text-align: center;">
        <a href="{{ path('app_user_new') }}" class="btn btn-admin" style="max-width: 300px; margin: 0 auto;">
            <i class="fa fa-plus"></i> Create New User
        </a>
    </div>
{% endblock %}
