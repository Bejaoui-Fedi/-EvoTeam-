{% extends 'base.html.twig' %}

{% block title %}{{ exercise.title }} — Evolia{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <style>
        /* NUCLEAR FULL WIDTH FIX */
        body.user-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
        }
        .media-container {
            background: #000;
            border-radius: 30px;
            overflow: hidden;
            aspect-ratio: 16/9;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .media-placeholder {
            color: #fff;
            text-align: center;
        }
        .step-item {
            position: relative;
            padding-left: 50px;
            padding-bottom: 30px;
        }
        .step-item::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 40px;
            bottom: 0;
            width: 2px;
            background: #e9ecef;
        }
        .step-item:last-child::before {
            display: none;
        }
        .step-number {
            position: absolute;
            left: 0;
            top: 0;
            width: 40px;
            height: 40px;
            background: var(--primary-navy, #1e4d6b);
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            z-index: 1;
        }
    </style>
{% endblock %}

{% block body %}
<div class="user-scope">
{% include 'user_nav_bar/index.html.twig' %}

<div class="user-main-content">
    <div class="container py-5">
        <div class="row mb-5">
            <div class="col-12">
                <a href="{{ path('app_user_objective_view', {'id': exercise.objective.id}) }}" class="text-decoration-none text-muted mb-4 d-inline-block">
                    <i class="fa-solid fa-arrow-left me-2"></i>Retour à {{ exercise.objective.title }}
                </a>
                <h1 class="display-5 fw-bold mb-2">{{ exercise.title }}</h1>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2">
                        <i class="fa-solid fa-layer-group me-1"></i> {{ exercise.type|capitalize }}
                    </span>
                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                        <i class="fa-regular fa-clock me-1"></i> {{ exercise.durationMinutes }} min
                    </span>
                    <span class="badge rounded-pill bg-dark bg-opacity-10 text-dark border px-3 py-2">
                        Difficulté {{ exercise.difficulty|capitalize }}
                    </span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <!-- Media Player Section -->
                <div class="media-container shadow-lg mb-5">
                    {% if exercise.mediaUrl %}
                        {% set videoId = null %}
                        {% if 'youtu.be/' in exercise.mediaUrl %}
                            {% set videoId = exercise.mediaUrl|split('youtu.be/')|last|split('?')|first %}
                        {% elseif 'youtube.com/watch' in exercise.mediaUrl %}
                            {% set videoId = exercise.mediaUrl|split('v=')|last|split('&')|first %}
                        {% elseif 'youtube.com/embed/' in exercise.mediaUrl %}
                            {% set videoId = exercise.mediaUrl|split('embed/')|last|split('?')|first %}
                        {% endif %}

                        {% if videoId %}
                            <iframe width="100%" height="100%" src="https://www.youtube.com/embed/{{ videoId }}?rel=0" 
                                frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen></iframe>
                        {% else %}
                            <img src="{{ exercise.mediaUrl }}" class="img-fluid" alt="{{ exercise.title }}" style="object-fit: contain; width: 100%; height: 100%;">
                        {% endif %}
                    {% else %}
                        <div class="media-placeholder p-5">
                            <i class="fa-solid fa-play-circle fs-1 mb-3 opacity-25"></i>
                            <p>Aucun média disponible pour cet exercice.</p>
                        </div>
                    {% endif %}
                </div>

                <h4 class="fw-bold mb-4">Description</h4>
                <div class="bg-white p-4 rounded-4 shadow-sm mb-5">
                    <p class="text-muted">{{ exercise.description }}</p>
                </div>

                {% if exercise.steps %}
                    <h4 class="fw-bold mb-4">Instructions</h4>
                    <div class="steps-list">
                        {% set stepsList = exercise.steps|split('\n') %}
                        {% for step in stepsList %}
                            {% if step|trim is not empty %}
                                <div class="step-item">
                                    <div class="step-number">{{ loop.index }}</div>
                                    <div class="bg-white p-4 rounded-4 shadow-sm">
                                        {{ step }}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-lg rounded-5 p-4 bg-primary text-white sticky-top" style="top: 100px;">
                    <h4 class="fw-bold mb-4 text-center">Prêt à commencer ?</h4>
                    <p class="small opacity-75 text-center mb-5">Assurez-vous d'être dans un environnement confortable et prêt à vous concentrer.</p>
                    
                    <div id="completion-success" class="bg-success bg-opacity-10 border border-success border-opacity-25 rounded-4 p-3 mb-3 d-none">
                        <div class="d-flex align-items-center gap-2 text-success fw-bold">
                            <i class="fa-solid fa-circle-check"></i>
                            <span id="success-msg">Exercice validé !</span>
                        </div>
                    </div>

                    <button id="btn-complete" class="btn btn-light btn-lg w-100 rounded-pill fw-bold py-3 text-primary mb-3 shadow-sm" onclick="markAsComplete({{ exercise.id }})">
                        <i class="fa-solid fa-check-circle me-2"></i>Marquer comme terminé
                    </button>
                    
                    <button class="btn btn-outline-light btn-lg w-100 rounded-pill fw-bold py-3 mb-4 border-2" onclick="toggleSchedule()">
                        <i class="fa-solid fa-calendar-plus me-2"></i>Planifier
                    </button>

                    {# Schedule Form #}
                    <div id="scheduleBox" class="bg-white rounded-4 p-4 mb-4 d-none">
                        <h6 class="text-primary fw-bold mb-3 small uppercase tracking-wider">Date & Heure</h6>
                        <input type="datetime-local" id="scheduleAt" class="form-control mb-3 border-0 bg-light rounded-3">
                        <button class="btn btn-primary w-100 rounded-pill fw-bold" onclick="submitSchedule({{ exercise.id }})">
                            Confirmer
                        </button>
                    </div>

                    <div class="pt-4 border-top border-white border-opacity-25">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar p-2 bg-white bg-opacity-20 rounded-circle">
                                <i class="fa-solid fa-award"></i>
                            </div>
                            <div class="small">
                                <strong>Gagnez 50 Points</strong><br>
                                <span class="opacity-75">Complétez cette tâche pour progresser !</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function markAsComplete(id) {
    const btn = document.getElementById('btn-complete');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Validation...';

    fetch(`/user/objectives/exercise/${id}/complete`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.status === 'success') {
            document.getElementById('completion-success').classList.remove('d-none');
            document.getElementById('success-msg').innerHTML = `+${data.xpGained} XP ! ${data.message}`;
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Terminé !';
            btn.className = 'btn btn-success btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm';
            
            // Optional: update XP/Level elsewhere if needed
        } else {
            alert(data.message);
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check-circle me-2"></i>Marquer comme terminé';
        }
    })
    .catch(error => {
        console.error('Error:', error);
        btn.disabled = false;
    });
}

function toggleSchedule() {
    const box = document.getElementById('scheduleBox');
    box.classList.toggle('d-none');
}

function submitSchedule(id) {
    const dateInput = document.getElementById('scheduleAt');
    const date = dateInput.value;
    if (!date) {
        alert("Veuillez choisir une date et une heure.");
        return;
    }

    const btn = window.event.currentTarget;
    const originalText = btn.innerText;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ...';

    fetch(`/user/objectives/exercise/${id}/schedule`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `scheduledAt=${encodeURIComponent(date)}`
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            document.getElementById('completion-success').classList.remove('d-none');
            document.getElementById('success-msg').innerText = "Planifié avec succès sur Google Calendar !";
            toggleSchedule();
        } else {
            alert("Erreur: " + data.message);
        }
    })
    .catch(err => alert("Erreur de connexion : " + err))
    .finally(() => {
        btn.disabled = false;
        btn.innerText = originalText;
    });
}
</script>
{% endblock %}

