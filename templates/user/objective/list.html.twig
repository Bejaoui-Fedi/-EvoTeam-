{% extends 'base.html.twig' %}

{% block title %}Mes Objectifs — Evolia{% endblock %}
{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <style>
        body.user-theme { display:block !important; margin:0; padding:0; width:100vw; height:100vh; overflow:hidden; background:#f1f5f9; }
        .user-scope { display:flex; width:100vw; height:100vh; }
        .user-main-content { flex-grow:1; overflow-y:auto; }

        /* Page Styles */
        .obj-hero { background:linear-gradient(135deg, #0c2b3e 0%, #1e4d6b 100%); padding:60px 50px; color:#fff; }
        .btn-progression { 
            background: rgba(255, 255, 255, 0.1); 
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 10px 22px;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
            backdrop-filter: blur(10px);
        }
        .btn-progression:hover { background: rgba(255, 255, 255, 0.2); transform: translateY(-2px); color: #fff; border-color: #fff; }
        
        .search-bar { background:rgba(0,0,0,0.15); border-radius:40px; padding:12px 25px; border:1px solid rgba(255,255,255,0.1); display:flex; align-items:center; gap:12px; min-width:320px; backdrop-filter:blur(15px); }
        .search-bar input { border:none; outline:none; flex:1; background:transparent; color:#fff; font-size:0.95rem; }
        .search-bar input::placeholder { color:rgba(255,255,255,0.5); }
        .sort-select { background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); border-radius:40px; padding:10px 18px; font-size:0.875rem; cursor:pointer; color:#fff; backdrop-filter:blur(10px); }
        .sort-select option { background:#1e4d6b; color:#fff; }

        /* Grid */
        .obj-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(290px,1fr)); gap:20px; padding:32px 40px; }
        .obj-card { background:#fff; border-radius:20px; padding:24px; border:1px solid #e2e8f0; transition:all 0.3s; display:flex; flex-direction:column; gap:12px; cursor:pointer; text-decoration:none; color:inherit; }
        .obj-card:hover { transform:translateY(-6px); box-shadow:0 20px 48px rgba(30,77,107,0.15); border-color:#1e4d6b; color:inherit; }
        .badge-level { font-size:0.7rem; font-weight:700; padding:4px 12px; border-radius:20px; text-transform:uppercase; display:inline-block; }
        
        /* Dynamic Objective Categories & Statuses */
        .obj-card.mix-beginner, .obj-card.mix-debutant { border-left:4px solid #27AE60; background:linear-gradient(135deg, #ffffff 0%, #f4fbf7 100%); }
        .obj-card.mix-beginner:hover, .obj-card.mix-debutant:hover { box-shadow:0 20px 48px rgba(39, 174, 96, 0.15); border-color:#27AE60; }
        
        .obj-card.mix-intermediate, .obj-card.mix-moyen { border-left:4px solid #F39C12; background:linear-gradient(135deg, #ffffff 0%, #fdf8f0 100%); }
        .obj-card.mix-intermediate:hover, .obj-card.mix-moyen:hover { box-shadow:0 20px 48px rgba(243, 156, 18, 0.15); border-color:#F39C12; }
        
        .obj-card.mix-advanced, .obj-card.mix-avance { border-left:4px solid #E74C3C; background:linear-gradient(135deg, #ffffff 0%, #fdf4f4 100%); }
        .obj-card.mix-advanced:hover, .obj-card.mix-avance:hover { box-shadow:0 20px 48px rgba(231, 76, 60, 0.15); border-color:#E74C3C; }
        
        .obj-card.mix-global { border-left:4px solid #2980B9; background:linear-gradient(135deg, #ffffff 0%, #f5f9fc 100%); }
        .obj-card.mix-global:hover { box-shadow:0 20px 48px rgba(41, 128, 185, 0.15); border-color:#2980B9; }

        /* Statuses */
        .obj-card.mix-en_cours { border-left:4px solid #3498db; background:linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%); }
        .obj-card.mix-en_cours:hover { border-color:#3498db; box-shadow:0 20px 48px rgba(52, 152, 219, 0.15); }
        .badge-en_cours { background:#e1f5fe; color:#0288d1; }

        .obj-card.mix-termine { border-left:4px solid #2ecc71; background:linear-gradient(135deg, #ffffff 0%, #f1faf2 100%); }
        .obj-card.mix-termine:hover { border-color:#2ecc71; box-shadow:0 20px 48px rgba(46, 204, 113, 0.15); }
        .badge-termine { background:#e8f5e9; color:#2e7d32; }

        .obj-card.mix-abandonne { border-left:4px solid #95a5a6; background:linear-gradient(135deg, #ffffff 0%, #f8f9f9 100%); opacity:0.8; }
        .obj-card.mix-abandonne:hover { border-color:#95a5a6; opacity:1; }
        .badge-abandonne { background:#f5f5f5; color:#616161; }

        .badge-debutant, .badge-beginner { background:#E9F7EF; color:#27AE60; }
        .badge-moyen, .badge-intermediate { background:#FEF9E7; color:#F39C12; }
        .badge-avance, .badge-advanced { background:#FDEDEC; color:#E74C3C; }
        .badge-global { background:#EAF2FB; color:#2980B9; }

        .obj-title { font-size:1rem; font-weight:700; color:#1a202c; line-height:1.3; margin:0; }
        .obj-desc  { font-size:0.83rem; color:#718096; flex:1; margin:0; }
        .obj-footer { display:flex; align-items:center; justify-content:space-between; padding-top:12px; border-top:1px solid #f0f4f8; }
        .ex-count { font-size:0.78rem; color:#a0aec0; display:flex; align-items:center; gap:5px; }
        .btn-view { background:#1e4d6b; color:#fff; border:none; border-radius:20px; padding:6px 18px; font-size:0.8rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
        .obj-card:hover .btn-view { background:#163d57; }

        .empty-state { text-align:center; padding:80px 20px; color:#a0aec0; }
        .empty-state i { font-size:3.5rem; margin-bottom:20px; display:block; opacity:0.4; }
    </style>
{% endblock %}

{% block body %}
<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}

    <div class="user-main-content">

        {# Dynamic & Beautiful Hero #}
        <div class="obj-hero shadow-sm">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-4">
                <div class="hero-text-side">
                    <div class="d-flex align-items-center gap-2 mb-2 text-uppercase fw-bold" style="letter-spacing:1px; font-size:0.75rem; color:rgba(255,255,255,0.6);">
                        <i class="fa-solid fa-compass"></i> Mon Parcours Evolia
                    </div>
                    <div class="d-flex align-items-center gap-4 mb-3">
                        <h1 class="display-6 fw-bold mb-0">Mes Objectifs</h1>
                        <a href="{{ path('app_user_gamification') }}" class="btn-progression shadow-sm">
                            <i class="fa-solid fa-trophy text-warning"></i> 
                            <span>Ma Progression</span>
                        </a>
                    </div>
                    <div class="badge bg-white bg-opacity-10 rounded-pill px-3 py-2 fw-normal" style="font-size:0.85rem;">
                        <span class="opacity-75">{{ objectives|length }} objectifs disponibles</span>
                    </div>
                </div>

                <div class="hero-action-side d-flex gap-2">
                    <form method="GET" class="d-flex gap-2">
                        <div class="search-bar">
                            <i class="fa-solid fa-magnifying-glass opacity-50"></i>
                            <input type="text" name="q" value="{{ q }}" placeholder="Chercher un objectif..." id="searchInput" oninput="debounceSubmit()">
                        </div>
                        <select name="sort" class="sort-select" onchange="this.form.submit()">
                            <option value="title_az"  {{ sort == 'title_az'  ? 'selected' }}>A → Z</option>
                            <option value="title_za"  {{ sort == 'title_za'  ? 'selected' }}>Z → A</option>
                            <option value="level"     {{ sort == 'level'     ? 'selected' }}>Niveau</option>
                        </select>
                    </form>
                </div>
            </div>
        </div>

        {# Cards Grid #}
        {% if objectives is empty %}
            <div class="empty-state">
                <i class="fa-regular fa-folder-open"></i>
                <p class="fw-600">
                    {% if q %}
                        Aucun objectif trouvé pour « {{ q }} ».
                    {% else %}
                        Aucun objectif disponible pour le moment.
                    {% endif %}
                </p>
            </div>
        {% else %}
            <div class="obj-grid">
                {% for obj in objectives %}
                    <a href="{{ path('app_user_objective_view', {id: obj.id}) }}" class="obj-card mix-{{ obj.level|lower }}">
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <span class="badge-level badge-{{ obj.level|lower }}">{{ obj.level }}</span>
                        </div>
                        <p class="obj-title">{{ obj.title }}</p>
                        <p class="obj-desc">{{ obj.description|default('Cliquez pour découvrir cet objectif.')|slice(0,100) }}{% if obj.description|length > 100 %}…{% endif %}</p>
                        <div class="obj-footer">
                            <span class="ex-count">
                                <i class="fa-solid fa-dumbbell"></i>
                                {{ obj.exercises|filter(e => e.isPublished)|length }} exercice{{ obj.exercises|filter(e => e.isPublished)|length != 1 ? 's' }}
                            </span>
                            <button class="btn-view">Commencer <i class="fa-solid fa-arrow-right ms-1"></i></button>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
let timer;
function debounceSubmit() {
    clearTimeout(timer);
    timer = setTimeout(() => document.getElementById('searchInput').form.submit(), 400);
}
</script>
{% endblock %}
