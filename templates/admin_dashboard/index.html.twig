{% extends 'base.html.twig' %}

{% block title %}Evolia — Administration{% endblock %}

{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
{% endblock %}

{% block body %}

<div class="admin-scope">
{% include 'admin_nav_bar/index.html.twig' %}

<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="header-title">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-white rounded-4 shadow-sm">
                    <i class="fa-solid fa-house-chimney-window fs-3 text-success"></i>
                </div>
                <div>
                    <h1>Tableau de Bord</h1>
                    <p>Bienvenue dans l'administration d'Evolia</p>
                </div>
            </div>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-header">
                <span>UTILISATEURS</span>
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="stat-value">{{ userCount }} <small class="fs-6 opacity-50">inscrits</small></div>
            <div class="mt-2 text-muted small"><a href="{{ path('app_user_list') }}" class="text-decoration-none text-inherit">Gérer la liste <i class="fa-solid fa-arrow-right"></i></a></div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <span>REVENUS (EST.)</span>
                <i class="fa-solid fa-sack-dollar"></i>
            </div>
            <div class="stat-value">1,240 €</div>
            <div class="mt-2 text-success small"><i class="fa-solid fa-caret-up"></i> +12% ce mois</div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <span>RÉSILIATIONS</span>
                <i class="fa-solid fa-user-minus"></i>
            </div>
            <div class="stat-value">2</div>
            <div class="mt-2 text-danger small">À surveiller</div>
        </div>
    </div>

    <div class="management-card mt-5 p-5">
        <div class="text-center py-5">
            <i class="fa-solid fa-chart-area fs-1 text-success opacity-25 mb-3"></i>
            <h3>Résumé de la plateforme</h3>
            <p class="text-muted">Sélectionnez une section dans le menu pour gérer les détails.</p>
        </div>
    </div>
</div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
