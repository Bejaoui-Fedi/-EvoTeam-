{% extends 'base.html.twig' %}

{% block title %}Evolia — Espace Administrateur{% endblock %}

{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_login.css') }}">
{% endblock %}

{% block body %}

{# ——— BOOTSTRAP BACKGROUND CAROUSEL ——— #}
<div id="bgCarousel" class="carousel slide carousel-fade bg-carousel" data-bs-ride="carousel" data-bs-interval="3000">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/images/bg-2.jpg" class="d-block w-100" alt="Bien-être 1">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-3.jpg" class="d-block w-100" alt="Bien-être 2">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-4.jpg" class="d-block w-100" alt="Bien-être 3">
        </div>
    </div>
</div>

{# ——— DARK OVERLAY ——— #}
<div class="bg-dark-overlay"></div>

<div class="login-card">

    <i class="fa-solid fa-seedling login-icon"></i>

    <h1>Espace Administrateur</h1>
    <p class="subtitle">Connectez-vous à l'espace administration</p>

    <form method="post" action="{{ path('app_admin_dashboard') }}">

        <div class="form-group">
            <label class="form-label" for="admin_email">Email</label>
            <input
                type="email"
                id="admin_email"
                name="email"
                class="form-control"
                placeholder="admin@evolia.com"
                required
            >
        </div>

        <div class="form-group">
            <label class="form-label" for="admin_password">Mot de passe</label>
            <input
                type="password"
                id="admin_password"
                name="password"
                class="form-control"
                placeholder="Votre mot de passe"
                required
            >
        </div>

        <div class="form-options">
            <label>
                <input type="checkbox" name="remember"> Se souvenir de moi
            </label>
            <a href="#">Mot de passe oublié ?</a>
        </div>

        <a href="{{ path('app_admin_dashboard') }}" class="btn-login" style="text-decoration: none;">
            <i class="fa-solid fa-seedling"></i>
            Se connecter
        </a>

    </form>

    <p class="register-link">
        Pas encore de compte admin ? <a href="{{ path('app_admin_form') }}">Inscrivez-vous ici</a>
    </p>

    <hr class="divider">

    <a href="{{ path('app_home') }}" class="btn-back">
        <i class="fa-solid fa-house"></i> Retour à l'accueil
    </a>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
