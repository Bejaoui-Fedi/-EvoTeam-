{% extends 'base.html.twig' %}

{% block title %}Test SMS Twilio - Evolia Elite{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('elite_theme.css') }}">
    <style>
        body { background: #f1f5f9; font-family: 'Outfit', sans-serif; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .sms-card { background: white; border-radius: 35px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 40px 100px rgba(15, 23, 42, 0.1); overflow: hidden; max-width: 550px; width: 100%; transition: all 0.4s ease; }
        .sms-card:hover { transform: translateY(-10px); box-shadow: 0 50px 120px rgba(15, 23, 42, 0.15); }
        .sms-header { background: linear-gradient(135deg, var(--elite-navy), var(--elite-accent)); padding: 4rem 2rem; text-align: center; color: white; position: relative; }
        .sms-header i { font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.9; }
        .sms-body { padding: 4rem; }
    </style>
{% endblock %}

{% block body %}
<div class="sms-card">
    <div class="sms-header">
        <i class="fa-solid fa-comment-sms"></i>
        <h1 class="fw-bold mb-1" style="letter-spacing: -1.5px;">API SMS Twilio</h1>
        <p class="text-uppercase small fw-bold opacity-75 letter-spacing-2">Console de Test Evolia Elite</p>
    </div>
    
    <div class="sms-body">
        {% if status %}
            <div class="alert {{ '✅' in status ? 'alert-success border-0 shadow-sm' : 'alert-danger border-0 shadow-sm' }} mb-5 p-4" style="border-radius: 20px;">
                <div class="d-flex align-items-center gap-3">
                    <i class="fa-solid {{ '✅' in status ? 'fa-circle-check' : 'fa-circle-exclamation' }} fs-4"></i>
                    <span class="fw-bold">{{ status }}</span>
                </div>
            </div>
        {% endif %}

        <form method="post" novalidate>
            <div class="elite-form-group">
                <label class="elite-label">Numéro du destinataire</label>
                <div class="position-relative">
                    <input type="text" name="phone" class="elite-input" placeholder="+216XXXXXXXX" required>
                    <i class="fa-solid fa-phone position-absolute top-50 end-0 translate-middle-y me-4 opacity-50"></i>
                </div>
                <p class="small text-muted mt-2 ps-2">Utilisez le format international (ex: +216 pour la Tunisie).</p>
            </div>

            <div class="elite-form-group">
                <label class="elite-label">Contenu du message</label>
                <textarea name="message" class="elite-textarea" rows="3">Ceci est un test de l'API SMS depuis votre nouveau projet Evolia ! 🚀</textarea>
            </div>

            <button type="submit" class="btn-elite-primary w-100 py-3 mt-4" style="border-radius: 20px;">
                <i class="fa-solid fa-paper-plane me-2"></i> ENVOYER MAINTENANT
            </button>
        </form>

        <div class="mt-5 text-center">
            <a href="{{ path('app_admin_workspace') }}" class="text-decoration-none text-muted fw-bold small">
                <i class="fa-solid fa-arrow-left me-2"></i> RETOUR AU DASHBOARD
            </a>
        </div>
    </div>
</div>
{% endblock %}
