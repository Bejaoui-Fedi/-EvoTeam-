{% extends 'base.html.twig' %}

{% block title %}Supervision Médicale (Admin) — Evolia Elite{% endblock %}

{% block body_class %}admin-theme{% endblock %}
{% block main_class %}admin-main-content{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('elite_theme.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    <style>
        /* SCROLL FIX */
        body.admin-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .admin-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .admin-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
            padding: 40px !important;
            background: #f1f5f9 !important;
        }
        .workspace-nav {
            display: flex;
            gap: 15px;
            margin-bottom: 40px;
            background: rgba(255, 255, 255, 0.4);
            padding: 8px;
            border-radius: 20px;
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.2);
            width: fit-content;
        }
        .workspace-nav-btn {
            padding: 12px 24px;
            border-radius: 14px;
            font-weight: 700;
            text-decoration: none;
            color: var(--elite-navy);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .workspace-nav-btn:hover { background: rgba(56, 189, 248, 0.1); }
        .workspace-nav-btn.active {
            background: var(--elite-navy);
            color: white;
            box-shadow: 0 8px 30px rgba(15, 23, 42, 0.25);
        }
        
        .admin-supervision-card {
            background: white;
            border-radius: 32px;
            padding: 40px;
            box-shadow: 0 25px 80px rgba(0,0,0,0.05);
            min-height: 70vh;
            border: 1px solid var(--elite-border);
        }

        .status-badge-elite {
            padding: 8px 18px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .status-confirme { background: #dcfce7; color: #166534; }
        .status-attente { background: #fee2e2; color: #991b1b; }
        .status-termine { background: #dbeafe; color: #1e40af; }
        .status-annule { background: #f1f5f9; color: #475569; }
        
        .admin-table th {
            border: none;
            padding: 24px 20px;
            font-weight: 800;
            color: var(--elite-slate);
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            opacity: 0.6;
        }
        .admin-table td {
            padding: 24px 20px;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 500;
            color: var(--elite-navy);
        }
        .admin-table tr { transition: all 0.3s ease; }
        .admin-table tr:hover { background: #f8fafc; }
        .admin-table tr:last-child td { border: none; }

        /* Modal Styles */
        .evolia-modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            align-items: center;
            justify-content: center;
        }
        .evolia-modal.active { display: flex; }
        .evolia-modal-content {
            background: white;
            padding: 40px;
            border-radius: 36px;
            width: 100%;
            max-width: 800px;
            box-shadow: 0 40px 100px rgba(0,0,0,0.3);
            animation: modalPopIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalPopIn {
            from { opacity: 0; transform: translateY(40px) scale(0.9); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="admin-scope">
{% include 'admin_nav_bar/index.html.twig' %}
<div class="admin-main-content">
    <div class="header-title mb-5">
        <p class="text-uppercase letter-spacing-2 fw-bold opacity-50" style="font-size: 0.8rem; color: var(--elite-accent);">Contrôle Administratif • Supervision</p>
        <h1 class="fw-bold" style="color: var(--elite-navy); font-size: 3rem; letter-spacing: -1px;">
            {{ view == 'rdv' ? 'Flux Global des RDV' : 'Historique des Consultations' }}
        </h1>
        <div class="hero-divider" style="margin: 15px 0; width: 60px; height: 6px; background: linear-gradient(90deg, var(--elite-accent), var(--elite-secondary)); border-radius: 10px;"></div>
    </div>

    <div class="workspace-nav">
        <a href="{{ path('app_admin_workspace', {view: 'rdv'}) }}" class="workspace-nav-btn {{ view == 'rdv' ? 'active' : '' }}">
            <i class="fa-solid fa-layer-group"></i> Supervision RDV
        </a>
        <a href="{{ path('app_admin_workspace', {view: 'consultations'}) }}" class="workspace-nav-btn {{ view == 'consultations' ? 'active' : '' }}">
            <i class="fa-solid fa-list-check"></i> Supervision Consultations
        </a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'danger' ? 'danger' : 'info') }} border-0 shadow-sm mb-4 elite-glass-card" style="padding: 1rem; border-radius: 18px;">
                <i class="fa-solid fa-circle-info me-2"></i> {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="admin-supervision-card">
        {% if view == 'rdv' %}
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Identifiant</th>
                            <th>Patient / Utilisateur</th>
                            <th>Détails & Temps</th>
                            <th>Praticien</th>
                            <th>Statut Actuel</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for appointment in appointments %}
                        <tr>
                            <td><span class="badge bg-light text-muted px-3 py-2" style="border-radius: 10px;">#{{ appointment.id }}</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="patient-avatar-mini" style="width: 40px; height: 40px; background: #f0f9ff; color: #0369a1; display: flex; align-items: center; justify-content: center; border-radius: 12px; font-weight: 800; font-size: 0.8rem;">P</div>
                                    <div class="fw-bold">Patient #{{ appointment.userId }}</div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold">{{ appointment.dateRdv|date('d/m/Y') }}</div>
                                <div class="small opacity-50"><i class="fa-regular fa-clock me-1"></i> {{ appointment.heureRdv|date('H:i') }} • {{ appointment.typeRdv }}</div>
                            </td>
                            <td>
                                {% if appointment.professionalName %}
                                    <div class="fw-bold" style="color: var(--elite-accent);">{{ appointment.professionalName }}</div>
                                {% else %}
                                    <span class="text-muted">Non assigné</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="status-badge-elite status-{{ appointment.statut|lower|replace({' ': '-'}) }}">
                                    {{ appointment.statut }}
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-light px-3" style="border-radius: 10px; color: var(--elite-accent);" title="Détails" 
                                        onclick="showRdvDetails({
                                            id: '{{ appointment.id }}',
                                            dateRdv: '{{ appointment.dateRdv|date('Y-m-d') }}',
                                            statut: '{{ appointment.statut|e('js') }}',
                                            motif: '{{ appointment.motif|e('js') }}',
                                            professional: '{{ appointment.professionalName|e('js') ?: 'N/A' }}'
                                        })">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <form method="post" action="{{ path('app_admin_workspace_rdv_delete', {id: appointment.id}) }}" onsubmit="return confirm('Supprimer ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
                                        <button class="btn btn-sm btn-outline-danger px-3" style="border-radius: 10px;"><i class="fa-solid fa-trash-alt"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="py-5">
                                    <div class="mb-4" style="position: relative; display: inline-block;">
                                        <i class="fa-solid fa-layer-group" style="font-size: 5rem; color: var(--elite-navy); opacity: 0.1;"></i>
                                    </div>
                                    <h4 class="fw-bold" style="color: var(--elite-navy); opacity: 0.8;">Flux d'activité au repos</h4>
                                    <p class="text-muted">Aucune demande de rendez-vous n'a été trouvée dans le système.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Ref</th>
                            <th>Référence RDV</th>
                            <th>Diagnostic Principal</th>
                            <th>Date de Saisie</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for consultation in consultations %}
                        <tr>
                            <td><span class="fw-bold" style="color: var(--elite-accent);">#{{ consultation.id }}</span></td>
                            <td>
                                <div class="fw-bold">Patient #{{ consultation.appointment.userId }}</div>
                                <div class="small opacity-50">RDV Relatif #{{ consultation.appointment.id }}</div>
                            </td>
                            <td><div class="text-truncate" style="max-width: 300px; font-weight: 600;">{{ consultation.diagnostic }}</div></td>
                            <td>{{ consultation.dateConsultation|date('d/m/Y') }}</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-light px-3" style="border-radius: 10px; color: var(--elite-accent);" 
                                        onclick="showConsultationDetails({
                                            id: '{{ consultation.id }}',
                                            appointmentId: '{{ consultation.appointment.id }}',
                                            dateConsultation: '{{ consultation.dateConsultation|date('Y-m-d') }}',
                                            duree: '{{ consultation.duree }}',
                                            diagnostic: '{{ consultation.diagnostic|e('js') }}'
                                        })">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <form method="post" action="{{ path('app_admin_workspace_consultation_delete', {id: consultation.id}) }}" onsubmit="return confirm('Supprimer ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ consultation.id) }}">
                                        <button class="btn btn-sm btn-outline-danger px-3" style="border-radius: 10px;"><i class="fa-solid fa-trash-alt"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="py-5">
                                    <div class="mb-4" style="position: relative; display: inline-block;">
                                        <i class="fa-solid fa-clipboard-list" style="font-size: 5rem; color: var(--elite-navy); opacity: 0.05;"></i>
                                    </div>
                                    <h4 class="fw-bold" style="color: var(--elite-navy);">Aucune supervision nécessaire</h4>
                                    <p class="text-muted">La base de données des consultations est actuellement vide.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

<!-- Elite Details Modal -->
<div id="detailsModal" class="evolia-modal">
    <div class="evolia-modal-content">
        <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-4">
            <h3 class="fw-bold mb-0" id="modalTitle" style="color: var(--elite-navy);">Supervision Détails</h3>
            <button type="button" class="btn-close" onclick="closeModal()"></button>
        </div>
        <div id="modalBody"></div>
        <div class="mt-5 pt-4 text-end">
            <button class="btn-elite-primary" style="background: var(--elite-navy); min-width: 150px; border-radius: 14px;" onclick="closeModal()">Fermer</button>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById('detailsModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalBody = document.getElementById('modalBody');

    function showRdvDetails(rdv) {
        console.log("Admin RDV Data:", rdv);
        try {
            modalTitle.innerText = "Supervision RDV #" + rdv.id;
            modalBody.innerHTML = `
                <div class="row g-5">
                    <div class="col-md-4"><p class="elite-label">Date du RDV</p><p class="fw-bold h4">${rdv.dateRdv}</p></div>
                    <div class="col-md-4"><p class="elite-label">Praticien</p><p class="fw-bold h4" style="color: var(--elite-accent);">${rdv.professional}</p></div>
                    <div class="col-md-4"><p class="elite-label">Statut</p><span class="status-badge-elite status-${rdv.statut.toLowerCase().replace(' ', '-')}">${rdv.statut}</span></div>
                    <div class="col-12"><p class="elite-label">Motif de Consultation</p><div class="p-4 rounded-4 shadow-sm" style="background: #f8fafc; border-left: 6px solid var(--elite-accent); line-height: 1.6;">${rdv.motif || 'Aucun motif renseigné'}</div></div>
                </div>
            `;
            modal.classList.add('active');
        } catch (e) { console.error("Error showing Admin RDV details:", e); }
    }

    function showConsultationDetails(con) {
        console.log("Admin Consultation Data:", con);
        try {
            modalTitle.innerText = "Supervision Consultation #" + con.id;
            modalBody.innerHTML = `
                <div class="row g-5">
                    <div class="col-md-6"><p class="elite-label">Saisie le</p><p class="fw-bold h4">${con.dateConsultation}</p></div>
                    <div class="col-md-6"><p class="elite-label">Durée Totale</p><p class="fw-bold h4">${con.duree || '-'} minutes</p></div>
                    <div class="col-12"><p class="elite-label">Diagnostic Enregistré</p><div class="p-4 rounded-4 shadow-sm" style="background: #f0f9ff; border-left: 6px solid var(--elite-accent); color: #0369a1; font-weight: 500;">${con.diagnostic || 'Non spécifié'}</div></div>
                </div>
            `;
            modal.classList.add('active');
        } catch (e) { console.error("Error showing Admin Consultation details:", e); }
    }
    
    function closeModal() { modal.classList.remove('active'); }
    window.onclick = function(event) { if (event.target == modal) closeModal(); }
</script>
</div>
</div>
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
