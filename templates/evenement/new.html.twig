{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="admin-scope">
    {% include 'admin_nav_bar/index.html.twig' %}
    <div class="admin-main-content p-4">
    <h1>Créer un événement</h1>
    
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_errors(form) }}
        
        <div>
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>
        <div>
            {{ form_label(form.startDate) }}
            {{ form_widget(form.startDate) }}
            {{ form_errors(form.startDate) }}
        </div>
        <div>
            {{ form_label(form.endDate) }}
            {{ form_widget(form.endDate) }}
            {{ form_errors(form.endDate) }}
        </div>
        <div>
            {{ form_label(form.maxParticipants) }}
            {{ form_widget(form.maxParticipants) }}
            {{ form_errors(form.maxParticipants) }}
        </div>
        <div>
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>
        <div>
            {{ form_label(form.fee) }}
            {{ form_widget(form.fee) }}
            {{ form_errors(form.fee) }}
        </div>
        <div>
            {{ form_label(form.location) }}
            {{ form_widget(form.location) }}
            {{ form_errors(form.location) }}
        </div>
        <div>
            {{ form_widget(form.save) }}
        </div>
    {{ form_end(form) }}
    
    <br>
    <br>
    <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary">← Retour à la liste</a>

    </div>
</div>
{% endblock %}