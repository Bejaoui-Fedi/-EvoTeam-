{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }
        .event-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }
        .event-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
        }
        .event-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 3rem 2rem;
            text-align: center;
        }
        .event-title {
            font-weight: 700;
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }
        .event-body {
            padding: 3rem 2rem;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }
        .info-card {
            background: white;
            padding: 1.5rem;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s ease;
        }
        .info-card:hover {
            transform: translateY(-5px);
        }
        .info-icon {
            font-size: 2rem;
            color: #667eea;
            margin-bottom: 1rem;
        }
        .info-label {
            font-size: 0.85rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }
        .info-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #2b2b2b;
        }
        .event-description {
            background: #f8f9fa;
            padding: 2rem;
            border-radius: 15px;
            border-left: 5px solid #764ba2;
            margin-bottom: 3rem;
            line-height: 1.8;
            color: #444;
        }
        .cta-section {
            text-align: center;
            margin-top: 2rem;
        }
        .btn-participate {
            background: linear-gradient(135deg, #00b09b, #96c93d);
            color: white;
            padding: 1rem 3rem;
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: none;
            box-shadow: 0 10px 20px rgba(0, 176, 155, 0.3);
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
        }
        .btn-participate:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 25px rgba(0, 176, 155, 0.4);
            color: white;
        }
        .btn-participate i {
            margin-right: 10px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="event-container">
    <div class="event-card">
        <div class="event-header">
            <h1 class="event-title">{{ evenement.name }}</h1>
            <p class="mb-0 opacity-75"><i class="fas fa-ticket-alt"></i> Page Officielle de l'Événement</p>
        </div>
        
        <div class="event-body">
            <div class="info-grid">
                <div class="info-card">
                    <div class="info-icon"><i class="fas fa-calendar-alt"></i></div>
                    <div class="info-label">Début</div>
                    <div class="info-value">{{ evenement.startDate|date('d/m/Y') }}</div>
                </div>
                
                <div class="info-card">
                    <div class="info-icon"><i class="fas fa-flag-checkered"></i></div>
                    <div class="info-label">Fin</div>
                    <div class="info-value">{{ evenement.endDate|date('d/m/Y') }}</div>
                </div>
                
                <div class="info-card">
                    <div class="info-icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div class="info-label">Lieu</div>
                    <div class="info-value">{{ evenement.location }}</div>
                </div>
                
                <div class="info-card">
                    <div class="info-icon"><i class="fas fa-tags"></i></div>
                    <div class="info-label">Tarif</div>
                    <div class="info-value">{{ evenement.fee }} €</div>
                </div>
            </div>

            <div class="event-description">
                <h4 class="mb-3" style="color: #2b2b2b; font-weight: 600;"><i class="fas fa-info-circle text-primary"></i> À propos de l'événement</h4>
                <p class="mb-0">{{ evenement.description }}</p>
            </div>

            <div class="cta-section">
                <a href="{{ path('app_participation_new', {id: evenement.id}) }}" class="btn-participate">
                    <i class="fas fa-check-circle"></i> S'inscrire maintenant
                </a>
                <p class="text-muted mt-3 small"><i class="fas fa-shield-alt"></i> Inscription en ligne sécurisée</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
