{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="admin-scope">
    {% include 'admin_nav_bar/index.html.twig' %}
    <div class="admin-main-content p-4">
    <h1>Modifier l'événement</h1>
    
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_errors(form) }}
        
        <div>
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>
        <div>
            {{ form_label(form.startDate) }}
            {{ form_widget(form.startDate) }}
            {{ form_errors(form.startDate) }}
        </div>
        <div>
            {{ form_label(form.endDate) }}
            {{ form_widget(form.endDate) }}
            {{ form_errors(form.endDate) }}
        </div>
        <div>
            {{ form_label(form.maxParticipants) }}
            {{ form_widget(form.maxParticipants) }}
            {{ form_errors(form.maxParticipants) }}
        </div>
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                {{ form_label(form.description) }}
                <button type="button" id="btn-generate-ai" class="btn btn-sm btn-outline-info">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Générer avec l'IA
                </button>
            </div>
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>
        <div>
            {{ form_label(form.fee) }}
            {{ form_widget(form.fee) }}
            {{ form_errors(form.fee) }}
        </div>
        <div>
            {{ form_label(form.location) }}
            {{ form_widget(form.location) }}
            {{ form_errors(form.location) }}
        </div>
        <div>
            {{ form_widget(form.save, { 'label': 'Enregistrer' }) }}
        </div>
    {{ form_end(form) }}
    
    <br>
    <br>
    <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary">← Retour à la liste</a>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnAi = document.getElementById('btn-generate-ai');
    if (!btnAi) return;

    btnAi.addEventListener('click', async function() {
        const nameInput = document.getElementById('evenement_name');
        const locationInput = document.getElementById('evenement_location');
        const descInput = document.getElementById('evenement_description');

        const name = nameInput ? nameInput.value : '';
        const loc = locationInput ? locationInput.value : '';

        if (!name) {
            alert('Veuillez au moins saisir un nom d\'événement pour générer une description.');
            return;
        }

        const originalText = btnAi.innerHTML;
        btnAi.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Génération...';
        btnAi.disabled = true;

        try {
            const response = await fetch('/admin/evenement/generate-description', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ name: name, location: loc })
            });

            const data = await response.json();
            
            if (response.ok) {
                descInput.value = data.description;
            } else {
                alert(data.description || 'Erreur lors de la génération.');
            }
        } catch (e) {
            alert('Erreur réseau ou serveur.');
        } finally {
            btnAi.innerHTML = originalText;
            btnAi.disabled = false;
        }
    });
});
</script>
{% endblock %}