{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="admin-scope">
    {% include 'admin_nav_bar/index.html.twig' %}
    <div class="admin-main-content p-4">
    <h1>{{ evenement.name }}</h1>
    
    <p><strong>ID :</strong> {{ evenement.id }}</p>
    <p><strong>Date début :</strong> {{ evenement.startDate|date('d/m/Y') }}</p>
    <p><strong>Date fin :</strong> {{ evenement.endDate|date('d/m/Y') }}</p>
    <p><strong>Places maximum :</strong> {{ evenement.maxParticipants }}</p>
    <p><strong>Description :</strong> {{ evenement.description }}</p>
    <p><strong>Prix :</strong> {{ evenement.fee }} €</p>
    <p><strong>Lieu :</strong> {{ evenement.location }}</p>
    <p><strong>Participants inscrits :</strong> {{ evenement.participations|filter(p => p.status == 'registered')|length }}</p>
    
    <br>
    <br>
    <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary">← Retour à la liste</a>
    &nbsp;|&nbsp;
    <a href="{{ path('app_evenement_edit', {id: evenement.id}) }}" class="btn btn-primary">Modifier</a>
    <a href="{{ path('app_evenement_participants_export', {id: evenement.id}) }}" class="btn btn-success">Exporter participants Excel</a>

    </div>
</div>
{% endblock %}