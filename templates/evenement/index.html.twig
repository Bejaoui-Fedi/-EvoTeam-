{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    {% if is_granted('ROLE_ADMIN') %}
        <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    {% else %}
        <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
        <style>
            body { display: block !important; padding: 0 !important; margin: 0 !important; width: 100vw !important; height: 100vh !important; overflow: hidden !important; background: #f1f5f9 !important; }
            .user-scope { display: flex !important; width: 100vw !important; height: 100vh !important; max-width: none !important; margin: 0 !important; padding: 0 !important; }
            .user-main-content { flex-grow: 1 !important; width: calc(100vw - 280px) !important; max-width: none !important; overflow-y: auto !important; padding: 20px; }
        </style>
    {% endif %}
{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
    <div class="admin-scope">
        {% include 'admin_nav_bar/index.html.twig' %}
        <div class="admin-main-content p-4">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button></div>
            {% endfor %}
            <h1>Liste des événements</h1>
            <div class="row g-3 mb-4">
                <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Événements</div><div class="fs-4 fw-bold">{{ stats.totalEvents }}</div></div></div></div>
                <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Avis publiés</div><div class="fs-4 fw-bold">{{ stats.totalReviews }}</div></div></div></div>
                <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Note moyenne</div><div class="fs-4 fw-bold text-warning">{{ stats.avgRating }}/5</div></div></div></div>
            </div>
            <form method="get" class="row g-2 mb-4">
                <div class="col-md-5"><input type="text" name="q" value="{{ q|default('') }}" class="form-control" placeholder="Rechercher un événement"></div>
                <div class="col-md-4">
                    <select name="sort" class="form-select">
                        <option value="date_desc" {{ sort == 'date_desc' ? 'selected' : '' }}>Date début (récent)</option>
                        <option value="date_asc" {{ sort == 'date_asc' ? 'selected' : '' }}>Date début (ancien)</option>
                        <option value="name_asc" {{ sort == 'name_asc' ? 'selected' : '' }}>Nom A-Z</option>
                        <option value="name_desc" {{ sort == 'name_desc' ? 'selected' : '' }}>Nom Z-A</option>
                        <option value="fee_asc" {{ sort == 'fee_asc' ? 'selected' : '' }}>Prix croissant</option>
                        <option value="fee_desc" {{ sort == 'fee_desc' ? 'selected' : '' }}>Prix décroissant</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2"><button class="btn btn-primary w-100">Filtrer</button><a class="btn btn-outline-secondary" href="{{ path('app_evenement_index') }}">Reset</a></div>
            </form>
            <div style="margin-bottom: 20px;">
                <a href="{{ path('app_evenement_new') }}">+ Créer un événement</a>
            </div>
            
            <table class="table table-striped" border="1" cellpadding="10" cellspacing="0" style="background: white;">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Date début</th>
                        <th>Date fin</th>
                        <th>Places max</th>
                        <th>Lieu</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in evenements %}
                    <tr>
                        <td>{{ event.name }}</td>
                        <td>{{ event.startDate|date('d/m/Y') }}</td>
                        <td>{{ event.endDate|date('d/m/Y') }}</td>
                        <td>{{ event.maxParticipants }}</td>
                        <td>{{ event.location }}</td>
                        <td>
                            <a href="{{ path('app_evenement_show', {id: event.id}) }}" class="btn btn-sm btn-info">Voir</a>
                            <a href="{{ path('app_evenement_edit', {id: event.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                            <form method="post" action="{{ path('app_evenement_delete', {id: event.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
                                <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6">Aucun événement trouvé</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            
        </div>
    </div>
{% else %}
    <div class="user-scope">
        {% include 'user_nav_bar/index.html.twig' %}
        <div class="user-main-content">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button></div>
            {% endfor %}
            <div class="row g-3 mb-4">
                <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Événements disponibles</div><div class="fs-4 fw-bold">{{ stats.totalEvents }}</div></div></div></div>
                <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Avis publiés</div><div class="fs-4 fw-bold">{{ stats.totalReviews }}</div></div></div></div>
                <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Note moyenne</div><div class="fs-4 fw-bold text-warning">{{ stats.avgRating }}/5</div></div></div></div>
            </div>
            <form method="get" class="row g-2 mb-4">
                <div class="col-md-5"><input type="text" name="q" value="{{ q|default('') }}" class="form-control" placeholder="Rechercher un événement"></div>
                <div class="col-md-4">
                    <select name="sort" class="form-select">
                        <option value="date_desc" {{ sort == 'date_desc' ? 'selected' : '' }}>Date début (récent)</option>
                        <option value="date_asc" {{ sort == 'date_asc' ? 'selected' : '' }}>Date début (ancien)</option>
                        <option value="name_asc" {{ sort == 'name_asc' ? 'selected' : '' }}>Nom A-Z</option>
                        <option value="name_desc" {{ sort == 'name_desc' ? 'selected' : '' }}>Nom Z-A</option>
                        <option value="fee_asc" {{ sort == 'fee_asc' ? 'selected' : '' }}>Prix croissant</option>
                        <option value="fee_desc" {{ sort == 'fee_desc' ? 'selected' : '' }}>Prix décroissant</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2"><button class="btn btn-primary w-100">Filtrer</button><a class="btn btn-outline-secondary" href="{{ path('app_evenement_index') }}">Reset</a></div>
            </form>
<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <h1 style="color: #2c3e50; margin-bottom: 30px; font-size: 2em; letter-spacing: 1px;">Événements à Découvrir</h1>
    
    {% for event in evenements %}
        <div style="background-color: #ffffff; margin-bottom: 30px; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.3s ease;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 300px; padding-right: 20px;">
                    <h2 style="margin-top: 0; color: #2c3e50; font-size: 1.5em;">{{ event.name }}</h2>
                    <div style="color: #7f8c8d; margin-bottom: 15px; font-size: 0.9em;">
                        <span style="display: inline-block; margin-right: 15px; margin-bottom: 5px;"><i class="fa-solid fa-location-dot"></i> {{ event.location }}</span>
                        <span style="display: inline-block; margin-right: 15px; margin-bottom: 5px;"><i class="fa-regular fa-calendar"></i> {{ event.startDate|date('d/m/Y') }} - {{ event.endDate|date('d/m/Y') }}</span>
                        <span style="display: inline-block; color: #27ae60; font-weight: bold; background: #e8f8f5; padding: 4px 10px; border-radius: 20px;"><i class="fa-solid fa-tag"></i> {{ event.fee }} €</span>
                    </div>
                    <p style="line-height: 1.6; color: #34495e;">{{ event.description }}</p>
                </div>
                <div style="margin-top: 10px;">
                    <a href="{{ path('app_review_new', {'eventId': event.id}) }}" style="display: inline-block; padding: 10px 20px; background: linear-gradient(135deg, #3498db, #2980b9); color: white; text-decoration: none; border-radius: 30px; font-weight: 600; box-shadow: 0 4px 10px rgba(52, 152, 219, 0.3); transition: all 0.3s;">
                        ⭐ Laisser un avis
                    </a>
                </div>
            </div>

            {% set visibleReviews = event.reviews|filter(review => is_granted('ROLE_ADMIN') or (review.author and app.user and review.author.id == app.user.id)) %}
            {% if visibleReviews|length > 0 %}
                <div style="margin-top: 25px; padding-top: 15px; border-top: 1px solid #f1f2f6;">
                    <h4 style="color: #34495e; margin-bottom: 15px; font-size: 1.1em; display: flex; align-items: center;">
                        <span style="background-color: #f1c40f; color: #fff; border-radius: 50%; width: 24px; height: 24px; display: inline-flex; justify-content: center; align-items: center; margin-right: 10px; font-size: 0.8em;">{{ visibleReviews|length }}</span>
                        Avis
                    </h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px;">
                        {% for review in visibleReviews %}
                            <div style="background-color: #f8f9fa; padding: 15px; border-radius: 8px; border-left: 4px solid #f1c40f;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                    <strong style="color: #2c3e50; font-size: 1em;">{{ review.title }}</strong>
                                    <span style="color: #f39c12; font-size: 1em;">
                                        {% for i in 1..5 %}
                                            {% if i <= review.rating %}★{% else %}<span style="color: #dcdde1;">☆</span>{% endif %}
                                        {% endfor %}
                                    </span>
                                </div>
                                <p style="font-size: 0.8em; color: #95a5a6; margin: 0 0 10px 0;">Le {{ review.reviewDate|date('d/m/Y') }}</p>
                                <p style="margin: 0; color: #34495e; font-style: italic; font-size: 0.9em; line-height: 1.4;">"{{ review.comment }}"</p>
                                {% if review.author and app.user and review.author.id == app.user.id %}
                                    <div class="mt-2 d-flex gap-2">
                                        <a href="{{ path('app_review_edit', {id: review.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                        <form method="post" action="{{ path('app_review_delete', {id: review.id}) }}" onsubmit="return confirm('Supprimer cet avis ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div style="text-align: center; padding: 50px; background-color: #f8f9fa; border-radius: 10px; color: #7f8c8d;">
            <p style="font-size: 1.2em;">Aucun événement n'est disponible pour le moment.</p>
        </div>
    {% endfor %}
</div>

        </div>
    </div>
{% endif %}
{% endblock %}