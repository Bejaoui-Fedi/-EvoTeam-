{% extends 'base.html.twig' %}

{% block title %}{{ exercice.titre }} — Evolia{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/user_dashboard.css">
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<style>
    :root {
        --primary: #1a3a2e;
        --primary-dark: #2d6a4f;
        --success: #22c55e;
        --warning: #f59e0b;
        --danger: #ef4444;
        --bg: #f1f5f9;
        --bg-card: #ffffff;
        --border: #e2e8f0;
        --text: #1a3a2e;
        --text-muted: #64748b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; min-height: 100vh; overflow-x: hidden; }
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    .user-scope { display: flex; min-height: 100vh; }

    .page-header { background: linear-gradient(135deg, #1a3a2e 0%, #2d6a4f 100%); padding: 2.5rem 3rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; color: #fff; }
    .page-header-left { display: flex; align-items: center; gap: 1.2rem; }
    .page-header h1 { font-size: 1.7rem; font-weight: 700; color: #fff; }
    .back-link { color: rgba(255, 255, 255, 0.7); text-decoration: none; font-size: 0.9rem; font-weight: 500; }
    .back-link:hover { color: #fff; }
    .back-link:hover { color:var(--success); }

    .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.4rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; cursor: pointer; border: none; text-decoration: none; transition: all 0.3s; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(26, 58, 46, 0.2); }
    .btn-white { background: #fff; color: var(--primary); }
    .btn-white:hover { background: #f8f9fa; transform: translateY(-2px); }
    .btn-danger { background: #fff0f0; color: var(--danger); border: 1px solid #ffcccc; }
    .btn-danger:hover { background: var(--danger); color: #fff; }
    .btn-outline { background: #fff; color: var(--text-muted); border: 1px solid var(--border); }
    .btn-outline:hover { border-color: var(--primary); color: var(--primary); }
    .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.8rem; }

    .container { max-width:800px; margin:2.5rem auto; padding:0 1.5rem; }

    .hero-card {
        background:var(--bg-card);
        border:1px solid var(--border);
        border-radius:20px;
        padding:2.5rem;
        margin-bottom:1.5rem;
        position:relative;
        overflow:hidden;
    }
    .hero-card::before {
        content:'';
        position:absolute;
        top:0; left:0;
        width:100%; height:4px;
        background:linear-gradient(90deg,#22c55e,#4ade80);
    }

    .hero-type { font-size:3.5rem; margin-bottom:1rem; }
    .hero-title { font-size:1.6rem; font-weight:700; margin-bottom:0.5rem; }
    .hero-desc { color:var(--text-muted); font-size:0.9rem; line-height:1.6; }

    .metrics-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(140px,1fr)); gap:1rem; margin-bottom:1.5rem; }
    .metric { background:var(--bg-card); border:1px solid var(--border); border-radius:14px; padding:1.2rem; text-align:center; }
    .metric .metric-val { font-size:1.8rem; font-weight:700; margin-bottom:0.2rem; }
    .metric .metric-label { font-size:0.75rem; color:var(--text-muted); }

    .info-card { background:var(--bg-card); border:1px solid var(--border); border-radius:14px; padding:1.5rem; margin-bottom:1.5rem; }
    .info-card h3 { font-size:0.8rem; font-weight:500; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; margin-bottom:1rem; }
    .info-row { display:flex; justify-content:space-between; align-items:center; padding:0.6rem 0; border-bottom:1px solid var(--border); }
    .info-row:last-child { border-bottom:none; }
    .info-label { font-size:0.85rem; color:var(--text-muted); }
    .info-value { font-size:0.9rem; font-weight:500; }

    .diff-badge { padding:0.3rem 0.7rem; border-radius:6px; font-size:0.78rem; font-weight:500; }
    .diff-facile    { background:rgba(34,197,94,.2);  color:#4ade80; }
    .diff-moyen     { background:rgba(245,158,11,.2); color:#fbbf24; }
    .diff-difficile { background:rgba(239,68,68,.2);  color:#f87171; }

    .objectif-link { color:var(--primary); text-decoration:none; font-weight:500; }
    .objectif-link:hover { text-decoration:underline; }

    .alert { padding:0.9rem 1.2rem; border-radius:10px; margin-bottom:1.5rem; display:flex; align-items:center; gap:0.6rem; font-size:0.9rem; }
    .alert-success { background:rgba(34,197,94,.12); border:1px solid rgba(34,197,94,.3); color:#4ade80; }
</style>
{% endblock %}

{% block body %}
<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}

    <div class="user-main-content">
        {% set icons = {'cardio':'🏃','musculation':'💪','yoga':'🧘','flexibilite':'🤸','sport_collectif':'⚽','autre':'🎯'} %}

        <div class="page-header">
            <div class="page-header-left">
                <a href="{{ path('app_user_exercice_index') }}" class="back-link">
                    <i class="fa-solid fa-arrow-left"></i> Retour
                </a>
                <h1>{{ icons[exercice.type] ?? '🎯' }} {{ exercice.titre }}</h1>
            </div>
            <div style="display:flex;gap:1rem;">
                <a href="{{ path('app_user_exercice_edit', {id: exercice.id}) }}" class="btn btn-white">✏️ Modifier</a>
                <form method="post" action="{{ path('app_user_exercice_delete', {id: exercice.id}) }}" onsubmit="return confirm('Supprimer cet exercice ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exercice.id) }}">
                    <button type="submit" class="btn btn-danger">🗑 Supprimer</button>
                </form>
            </div>
        </div>

<div class="container">
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success">✅ {{ msg }}</div>
    {% endfor %}

    {# Description Card #}
    <div class="hero-card">
        <div class="hero-type">{{ icons[exercice.type] ?? '🎯' }}</div>
        <div class="hero-title">{{ exercice.titre }}</div>
        <p class="hero-desc">{{ exercice.description|default('Aucune description fournie.') }}</p>
    </div>

    {# Métriques #}
    <div class="metrics-grid">
        <div class="metric">
            <div class="metric-val" style="color:#38bdf8;">{{ exercice.duree }}</div>
            <div class="metric-label">⏱ Minutes</div>
        </div>
        <div class="metric">
            <div class="metric-val" style="color:#4ade80;">
                <span class="diff-badge diff-{{ exercice.difficulte }}">{{ exercice.difficulte|capitalize }}</span>
            </div>
            <div class="metric-label">💪 Difficulté</div>
        </div>
        <div class="metric">
            <div class="metric-val" style="color:#a78bfa; font-size:1.1rem;">{{ exercice.date|date('d/m/Y') }}</div>
            <div class="metric-label">📅 Date</div>
        </div>
    </div>

    {# Infos #}
    <div class="info-card">
        <h3>📋 Détails</h3>
        <div class="info-row">
            <span class="info-label">Type</span>
            <span class="info-value">{{ exercice.type|replace({'_':' '})|capitalize }}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Difficulté</span>
            <span class="diff-badge diff-{{ exercice.difficulte }}">{{ exercice.difficulte|capitalize }}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Durée</span>
            <span class="info-value">{{ exercice.duree }} minutes</span>
        </div>
        <div class="info-row">
            <span class="info-label">Date</span>
            <span class="info-value">{{ exercice.date|date('d/m/Y') }}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Objectif lié</span>
            <span class="info-value">
                {% if exercice.objectif %}
                    <a href="{{ path('app_user_objectif_show', {id: exercice.objectif.id}) }}" class="objectif-link">
                        🎯 {{ exercice.objectif.titre }}
                    </a>
                {% else %}
                    <span style="color:var(--text-muted);">Aucun</span>
                {% endif %}
            </span>
        </div>
    </div>
</div>
    </div>
</div>
{% endblock %}
