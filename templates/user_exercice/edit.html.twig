{% extends 'base.html.twig' %}

{% block title %}Modifier — {{ exercice.titre }} — Evolia{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/user_dashboard.css">
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    :root {
        --primary: #1a3a2e; --primary-dark: #2d6a4f; --success: #22c55e;
        --danger: #ef4444; --bg: #f1f5f9; --bg-card: #ffffff;
        --border: #e2e8f0; --text: #1a3a2e; --text-muted: #64748b;
    }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { background:var(--bg); color:var(--text); font-family:'Inter',sans-serif; min-height:100vh; }
    .user-scope { display:flex; min-height:100vh; }
    .page-header { background:linear-gradient(135deg,#1a3a2e 0%,#2d6a4f 100%); padding:2.5rem 3rem; display:flex; align-items:center; gap:1rem; color:#fff; }
    .page-header h1 { font-size:1.6rem; font-weight:700; color:#fff; }
    .back-link { color:rgba(255,255,255,0.7); text-decoration:none; font-size:0.9rem; display:flex; align-items:center; gap:0.4rem; }
    .back-link:hover { color:#fff; }
    .container { max-width:700px; margin:3rem auto; padding:0 1.5rem; }
    .form-card { background:var(--bg-card); border:1px solid var(--border); border-radius:20px; padding:2.5rem; box-shadow:0 10px 40px rgba(0,0,0,0.05); }
    .form-card h2 { font-size:1.15rem; font-weight:600; margin-bottom:0.4rem; }
    .form-card .subtitle { font-size:0.83rem; color:var(--text-muted); margin-bottom:2rem; }
    .form-group { margin-bottom:1.5rem; }
    .form-group label { display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.5rem; text-transform:uppercase; letter-spacing:.04em; }
    .required-star { color:var(--danger); margin-left:2px; }
    .form-control, .form-select {
        width:100%; background:#fff; border:2px solid var(--border); border-radius:12px;
        padding:0.8rem 1.1rem; color:var(--text); font-size:0.93rem; outline:none;
        font-family:'Inter',sans-serif; transition:all 0.25s;
    }
    .form-control:focus, .form-select:focus { border-color:var(--primary); box-shadow:0 0 0 4px rgba(26,58,46,0.08); }
    textarea.form-control { resize:vertical; min-height:90px; }
    .form-control.is-valid, .form-select.is-valid { border-color:#22c55e; }
    .form-control.is-invalid, .form-select.is-invalid { border-color:var(--danger); }
    .field-error { color:var(--danger); font-size:0.78rem; margin-top:0.35rem; display:flex; align-items:center; gap:0.3rem; animation:slideIn 0.2s ease; }
    .field-hint  { color:var(--text-muted); font-size:0.76rem; margin-top:0.3rem; }
    @keyframes slideIn { from{opacity:0;transform:translateY(-4px)} to{opacity:1;transform:translateY(0)} }
    .char-counter { font-size:0.73rem; color:var(--text-muted); text-align:right; margin-top:0.25rem; }
    .char-counter.warn { color:var(--danger); font-weight:600; }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1.2rem; }
    .btn { display:inline-flex; align-items:center; gap:0.45rem; padding:0.75rem 1.6rem; border-radius:12px; font-size:0.9rem; font-weight:600; cursor:pointer; border:none; text-decoration:none; transition:all 0.25s; }
    .btn-success { background:linear-gradient(135deg,#22c55e,#16a34a); color:#fff; }
    .btn-success:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(34,197,94,.35); }
    .btn-outline { background:transparent; color:var(--text-muted); border:2px solid var(--border); }
    .btn-outline:hover { border-color:var(--primary); color:var(--primary); }
    .form-actions { display:flex; gap:1rem; margin-top:2rem; justify-content:flex-end; }
    .symfony-errors { background:#fef2f2; border:1px solid #fecaca; border-radius:12px; padding:1rem 1.2rem; margin-bottom:1.5rem; }
    .symfony-errors p { color:#991b1b; font-size:0.85rem; margin:0; display:flex; align-items:center; gap:0.4rem; }
    .form-progress { height:4px; background:#e2e8f0; border-radius:4px; margin-bottom:2rem; overflow:hidden; }
    .form-progress-bar { height:100%; background:linear-gradient(90deg,#22c55e,#4ade80); border-radius:4px; transition:width 0.4s ease; width:0%; }
</style>
{% endblock %}

{% block body %}
<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}
    <div class="user-main-content">
        <div class="page-header">
            <a href="{{ path('app_user_exercice_show', {id: exercice.id}) }}" class="back-link">
                <i class="fa-solid fa-arrow-left"></i> Retour
            </a>
            <h1>✏️ Modifier l'exercice</h1>
        </div>

<div class="container">
    <div class="form-card">
        <h2>{{ exercice.titre }}</h2>
        <p class="subtitle">Modifiez les informations de l'exercice</p>
        <div class="form-progress"><div class="form-progress-bar" id="progressBar"></div></div>

        {% if form.vars.errors|length > 0 %}
        <div class="symfony-errors">
            {% for error in form.vars.errors %}
                <p><i class="fa-solid fa-circle-exclamation"></i> {{ error.message }}</p>
            {% endfor %}
        </div>
        {% endif %}

        {{ form_start(form, {'attr': {'id': 'exerciceForm', 'novalidate': 'novalidate'}}) }}

        <div class="form-group">
            <label>Titre <span class="required-star">*</span></label>
            {{ form_widget(form.titre, {'attr': {'id': 'field-titre', 'maxlength': 150, 'class': 'form-control' ~ (form.titre.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
            <div class="char-counter"><span id="titreCount">{{ exercice.titre|length }}</span>/150</div>
            <div class="field-hint">Minimum 3 caractères, maximum 150</div>
            {% for error in form.titre.vars.errors %}<div class="field-error"><i class="fa-solid fa-triangle-exclamation"></i> {{ error.message }}</div>{% endfor %}
            <div class="field-error" id="err-titre" style="display:none"></div>
        </div>

        <div class="form-group">
            <label>Description <span class="required-star">*</span></label>
            {{ form_widget(form.description, {'attr': {'id': 'field-desc', 'maxlength': 2000, 'rows': 4, 'class': 'form-control' ~ (form.description.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
            <div class="char-counter"><span id="descCount">{{ exercice.description|length }}</span>/2000</div>
            <div class="field-hint">Minimum 10 caractères</div>
            {% for error in form.description.vars.errors %}<div class="field-error"><i class="fa-solid fa-triangle-exclamation"></i> {{ error.message }}</div>{% endfor %}
            <div class="field-error" id="err-desc" style="display:none"></div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Type <span class="required-star">*</span></label>
                {{ form_widget(form.type, {'attr': {'id': 'field-type', 'class': 'form-select' ~ (form.type.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                {% for error in form.type.vars.errors %}<div class="field-error"><i class="fa-solid fa-triangle-exclamation"></i> {{ error.message }}</div>{% endfor %}
                <div class="field-error" id="err-type" style="display:none"></div>
            </div>
            <div class="form-group">
                <label>Difficulté <span class="required-star">*</span></label>
                {{ form_widget(form.difficulte, {'attr': {'id': 'field-diff', 'class': 'form-select' ~ (form.difficulte.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                {% for error in form.difficulte.vars.errors %}<div class="field-error"><i class="fa-solid fa-triangle-exclamation"></i> {{ error.message }}</div>{% endfor %}
                <div class="field-error" id="err-diff" style="display:none"></div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Durée (minutes) <span class="required-star">*</span></label>
                {{ form_widget(form.duree, {'attr': {'id': 'field-duree', 'min': 1, 'max': 600, 'class': 'form-control' ~ (form.duree.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                <div class="field-hint">Entre 1 et 600 minutes</div>
                {% for error in form.duree.vars.errors %}<div class="field-error"><i class="fa-solid fa-triangle-exclamation"></i> {{ error.message }}</div>{% endfor %}
                <div class="field-error" id="err-duree" style="display:none"></div>
            </div>
            <div class="form-group">
                <label>Date <span class="required-star">*</span></label>
                {{ form_widget(form.date, {'attr': {'id': 'field-date', 'class': 'form-control' ~ (form.date.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                {% for error in form.date.vars.errors %}<div class="field-error"><i class="fa-solid fa-triangle-exclamation"></i> {{ error.message }}</div>{% endfor %}
                <div class="field-error" id="err-date" style="display:none"></div>
            </div>
        </div>

        <div class="form-group">
            <label>Objectif lié <span class="required-star">*</span></label>
            {{ form_widget(form.objectif, {'attr': {'id': 'field-objectif', 'class': 'form-select' ~ (form.objectif.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
            {% for error in form.objectif.vars.errors %}<div class="field-error"><i class="fa-solid fa-triangle-exclamation"></i> {{ error.message }}</div>{% endfor %}
            <div class="field-error" id="err-objectif" style="display:none"></div>
        </div>

        <div class="form-actions">
            <a href="{{ path('app_user_exercice_show', {id: exercice.id}) }}" class="btn btn-outline">Annuler</a>
            <button type="submit" class="btn btn-success" id="submitBtn">
                <i class="fa-solid fa-floppy-disk"></i> Enregistrer
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
    </div>
</div>

<script>
(function () {
    const FIELDS = [
        { id: 'field-titre',    err: 'err-titre',    validate: v => {
            if (!v.trim()) return 'Le titre est obligatoire.';
            if (v.trim().length < 3) return 'Le titre doit comporter au moins 3 caractères.';
            if (v.length > 150) return 'Le titre ne peut pas dépasser 150 caractères.';
            return null;
        }},
        { id: 'field-desc',     err: 'err-desc',     validate: v => {
            if (!v.trim()) return 'La description est obligatoire.';
            if (v.trim().length < 10) return 'La description doit comporter au moins 10 caractères.';
            return null;
        }},
        { id: 'field-type',     err: 'err-type',     validate: v => (!v ? 'Veuillez choisir un type.' : null) },
        { id: 'field-diff',     err: 'err-diff',     validate: v => (!v ? 'Veuillez choisir une difficulté.' : null) },
        { id: 'field-duree',    err: 'err-duree',    validate: v => {
            const n = parseInt(v);
            if (!v || isNaN(n)) return 'La durée est obligatoire.';
            if (n < 1 || n > 600) return 'La durée doit être comprise entre 1 et 600 minutes.';
            return null;
        }},
        { id: 'field-date',     err: 'err-date',     validate: v => (!v ? 'La date est obligatoire.' : null) },
        { id: 'field-objectif', err: 'err-objectif', validate: v => (!v ? 'Veuillez sélectionner un objectif.' : null) },
    ];

    function setFieldState(el, errEl, error) {
        el.classList.remove('is-valid', 'is-invalid');
        errEl.style.display = 'none';
        if (error) { el.classList.add('is-invalid'); errEl.textContent = '⚠ ' + error; errEl.style.display = 'flex'; }
        else if (el.value) { el.classList.add('is-valid'); }
    }

    function updateProgress() {
        const valid = FIELDS.filter(f => { const el = document.getElementById(f.id); return el && !f.validate(el.value); }).length;
        document.getElementById('progressBar').style.width = Math.round((valid / FIELDS.length) * 100) + '%';
    }

    const titreEl = document.getElementById('field-titre');
    const descEl  = document.getElementById('field-desc');
    if (titreEl) {
        document.getElementById('titreCount').textContent = titreEl.value.length;
        titreEl.addEventListener('input', () => {
            const c = document.getElementById('titreCount');
            c.textContent = titreEl.value.length;
            c.parentElement.classList.toggle('warn', titreEl.value.length > 140);
        });
    }
    if (descEl) {
        document.getElementById('descCount').textContent = descEl.value.length;
        descEl.addEventListener('input', () => {
            const c = document.getElementById('descCount');
            c.textContent = descEl.value.length;
            c.parentElement.classList.toggle('warn', descEl.value.length > 1900);
        });
    }

    FIELDS.forEach(f => {
        const el  = document.getElementById(f.id);
        const err = document.getElementById(f.err);
        if (!el || !err) return;
        const check = () => { setFieldState(el, err, f.validate(el.value)); updateProgress(); };
        if (el.value) check(); // Valider les champs pré-remplis dès le chargement
        el.addEventListener('input',  check);
        el.addEventListener('change', check);
        el.addEventListener('blur',   check);
    });

    document.getElementById('exerciceForm')?.addEventListener('submit', function (e) {
        let valid = true;
        FIELDS.forEach(f => {
            const el  = document.getElementById(f.id);
            const err = document.getElementById(f.err);
            if (!el || !err) return;
            const error = f.validate(el.value);
            setFieldState(el, err, error);
            if (error) valid = false;
        });
        if (!valid) {
            e.preventDefault();
            document.querySelector('.is-invalid')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    updateProgress();
})();
</script>
{% endblock %}
