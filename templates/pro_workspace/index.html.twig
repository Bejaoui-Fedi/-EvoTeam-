{% extends 'base.html.twig' %}

{% block title %}Espace Médical (Pro) - Evolia{% endblock %}

{% block body_class %}user-theme{% endblock %}
{% block main_class %}user-main-content{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('elite_theme.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <style>
        /* SCROLL FIX */
        body.user-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
            padding: 40px !important;
            background: #f1f5f9 !important;
        }
        .workspace-nav {
            display: flex;
            gap: 15px;
            margin-bottom: 40px;
            background: rgba(255, 255, 255, 0.4);
            padding: 8px;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            width: fit-content;
        }
        .workspace-nav-btn {
            padding: 12px 24px;
            border-radius: 14px;
            font-weight: 700;
            text-decoration: none;
            color: var(--elite-navy);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .workspace-nav-btn:hover { background: rgba(56, 189, 248, 0.1); }
        .workspace-nav-btn.active {
            background: var(--elite-navy);
            color: white;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.2);
        }
        
        .elite-rdv-card {
            background: white;
            border: 1px solid var(--elite-border);
            border-radius: 24px;
            padding: 24px;
            transition: all 0.3s ease;
            height: 100%;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }
        .elite-rdv-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06);
            border-color: var(--elite-accent);
        }
        
        .status-badge-elite {
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-confirme { background: #dcfce7; color: #166534; }
        .status-attente { background: #fee2e2; color: #991b1b; }
        .status-termine { background: #dbeafe; color: #1e40af; }
        .status-annule { background: #f3f4f6; color: #4b5563; }

        .pro-workspace-card {
            background: white;
            border-radius: 36px;
            padding: 40px;
            box-shadow: 0 40px 100px rgba(0,0,0,0.04);
            border: 1px solid var(--elite-border);
            min-height: 70vh;
        }

        /* Detail Modal Customization */
        .evolia-modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            align-items: center;
            justify-content: center;
        }
        .evolia-modal.active { display: flex; }
        .evolia-modal-content {
            background: white;
            padding: 40px;
            border-radius: 32px;
            width: 100%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 40px 100px rgba(0,0,0,0.3);
            animation: modalSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalSlideUp {
            from { opacity: 0; transform: translateY(40px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="user-scope">
{% include 'user_nav_bar/index.html.twig' %}
<div class="user-main-content">
    <div class="header-title mb-5">
        <p class="text-uppercase letter-spacing-2 fw-bold opacity-50" style="font-size: 0.8rem; color: var(--elite-accent);">Plateforme Médicale • Professionnel (Connecté sous: {{ app.user.nom }} - ID: {{ app.user.id }})</p>
        <h1 class="fw-bold" style="color: var(--elite-navy); font-size: 3rem; letter-spacing: -1px;">
            {{ view == 'rdv' ? 'Aperçu des Rendez-vous' : 'Saisie de Consultation' }}
        </h1>
        <div class="hero-divider" style="margin: 15px 0; width: 80px; height: 6px; background: linear-gradient(90deg, var(--elite-accent), var(--elite-secondary)); border-radius: 10px;"></div>
    </div>

    <div class="workspace-nav">
        <a href="{{ path('app_pro_workspace', {view: 'rdv'}) }}" class="workspace-nav-btn {{ view == 'rdv' ? 'active' : '' }}">
            <i class="fa-solid fa-calendar-check"></i> Mon Planning
        </a>
        <a href="{{ path('app_pro_workspace', {view: 'consultations'}) }}" class="workspace-nav-btn {{ view == 'consultations' ? 'active' : '' }}">
            <i class="fa-solid fa-notes-medical"></i> Consultations
        </a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'danger' ? 'danger' : 'info') }} border-0 shadow-sm mb-4 elite-glass-card" style="padding: 1.5rem; border-radius: 20px;">
                <i class="fa-solid {{ type == 'success' ? 'fa-circle-check' : 'fa-circle-info' }} me-2"></i> {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="pro-workspace-card">
        {% if view == 'rdv' %}
            <div class="row g-4">
            {% for appointment in appointments %}
                <div class="col-lg-4 col-md-6">
                    <div class="elite-rdv-card d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <span class="badge bg-light text-dark px-3 py-2" style="border-radius: 12px; font-weight: 700; font-size: 0.7rem;">#{{ appointment.id }}</span>
                            <span class="status-badge-elite status-{{ appointment.statut|lower|replace({' ': '-'}) }}">
                                {{ appointment.statut }}
                            </span>
                        </div>
                        <h5 class="fw-bold mb-2">Patient ID: {{ appointment.userId }}</h5>
                        <div class="d-flex gap-3 text-muted small mb-4">
                            <span><i class="fa-regular fa-calendar-alt me-1 text-primary"></i> {{ appointment.dateRdv|date('d/m/Y') }}</span>
                            <span><i class="fa-regular fa-clock me-1 text-primary"></i> {{ appointment.heureRdv|date('H:i') }}</span>
                        </div>
                        
                        <form method="post" action="{{ path('app_pro_workspace_rdv_update_status', {id: appointment.id}) }}" class="mb-4">
                            <div class="input-group">
                                <select name="statut" class="elite-select py-2" style="border-radius: 12px 0 0 12px; font-size: 0.85rem;">
                                    <option value="en attente" {{ appointment.statut|lower == 'en attente' ? 'selected' : '' }}>En attente</option>
                                    <option value="confirmé" {{ appointment.statut|lower == 'confirmé' ? 'selected' : '' }}>Confirmé</option>
                                    <option value="terminé" {{ appointment.statut|lower == 'terminé' ? 'selected' : '' }}>Terminé</option>
                                    <option value="annulé" {{ appointment.statut|lower == 'annulé' ? 'selected' : '' }}>Annulé</option>
                                </select>
                                <button class="btn btn-outline-primary px-3" type="submit" style="border-radius: 0 12px 12px 0;"><i class="fa-solid fa-rotate"></i></button>
                            </div>
                        </form>

                        <div class="mt-auto d-flex justify-content-between gap-2 border-top pt-3">
                            <div class="d-flex gap-2">
                                <a href="{{ path('app_pro_workspace', {view: 'consultations', appointment_id: appointment.id}) }}" class="btn btn-sm btn-elite-primary px-3 py-2" style="border-radius: 10px; font-size: 0.75rem;" title="Commencer">
                                    <i class="fa-solid fa-play"></i> GÉRER
                                </a>
                                <button class="btn btn-sm btn-light px-3 rounded-3" style="color: var(--elite-accent);" title="Détails" 
                                    onclick="showRdvDetails({
                                        id: '{{ appointment.id }}',
                                        dateRdv: '{{ appointment.dateRdv|date('Y-m-d') }}',
                                        heureRdv: '{{ appointment.heureRdv|date('H:i') }}',
                                        userId: '{{ appointment.userId }}',
                                        statut: '{{ appointment.statut|e('js') }}',
                                        motif: '{{ appointment.motif|e('js') }}'
                                    })">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                            <form method="post" action="{{ path('app_pro_workspace_rdv_delete', {id: appointment.id}) }}" onsubmit="return confirm('Supprimer ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
                                <button class="btn btn-sm btn-outline-danger px-3 rounded-3"><i class="fa-solid fa-trash-alt"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5 my-4">
                    <div class="mb-4" style="position: relative; display: inline-block;">
                        <i class="fa-solid fa-calendar-alt" style="font-size: 5rem; color: var(--elite-accent); opacity: 0.2;"></i>
                        <i class="fa-solid fa-check" style="position: absolute; bottom: 0; right: -10px; font-size: 2rem; color: var(--elite-secondary);"></i>
                    </div>
                    <h3 class="fw-bold" style="color: var(--elite-navy);">Aucun rendez-vous pour le moment</h3>
                    <p class="text-muted fs-5 mx-auto" style="max-width: 600px;">Votre planning est actuellement à jour. Dès qu'un patient réservera une séance avec vous, elle s'affichera ici instantanément.</p>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- ELITE CONSULTATION FORM -->
        {% if activeAppointment %}
            <div class="mb-5">
                <h4 class="fw-bold mb-5 d-flex align-items-center" style="color: var(--elite-navy);">
                    <span class="icon-circle me-3" style="width: 45px; height: 45px; background: linear-gradient(135deg, var(--elite-accent), var(--elite-secondary)); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 8px 16px rgba(56, 189, 248, 0.3);">
                        <i class="fa-solid fa-file-signature"></i>
                    </span>
                    Compte-rendu pour le RDV #{{ activeAppointment.id }}
                </h4>
                
                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="row g-4">
                        <div class="col-md-6 elite-form-group">
                            <label class="elite-label"><i class="fa-solid fa-stethoscope me-2"></i>Diagnostic</label>
                            {{ form_widget(form.diagnostic, {'attr': {'class': 'elite-textarea', 'rows': 4, 'placeholder': 'Décrivez le diagnostic médical...'}}) }}
                            <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.diagnostic) }}</div>
                        </div>
                        <div class="col-md-3 elite-form-group">
                            <label class="elite-label"><i class="fa-solid fa-hourglass-half me-2"></i>Durée (min)</label>
                            {{ form_widget(form.duree, {'attr': {'class': 'elite-input'}}) }}
                            <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.duree) }}</div>
                        </div>
                        <div class="col-md-3 elite-form-group">
                            <label class="elite-label"><i class="fa-solid fa-toggle-on me-2"></i>Statut</label>
                            {{ form_widget(form.statutConsultation, {'attr': {'class': 'elite-select'}}) }}
                        </div>
                        <div class="col-md-6 elite-form-group">
                            <label class="elite-label"><i class="fa-solid fa-pills me-2"></i>Traitement</label>
                            {{ form_widget(form.traitement, {'attr': {'class': 'elite-textarea', 'rows': 3, 'placeholder': 'Prescription et posologie...'}}) }}
                            <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.traitement) }}</div>
                        </div>
                        <div class="col-md-6 elite-form-group">
                            <label class="elite-label"><i class="fa-solid fa-comment-medical me-2"></i>Observations</label>
                            {{ form_widget(form.observation, {'attr': {'class': 'elite-textarea', 'rows': 3}}) }}
                            <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.observation) }}</div>
                        </div>
                        <div class="col-12 elite-form-group">
                            <label class="elite-label"><i class="fa-solid fa-scroll me-2"></i>Ordonnance Détaillée</label>
                            {{ form_widget(form.ordonnance, {'attr': {'class': 'elite-textarea', 'rows': 4, 'placeholder': 'Copie de l\'ordonnance officielle...'}}) }}
                            <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.ordonnance) }}</div>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 text-end">
                        <button type="submit" class="btn-elite-primary" style="min-width: 300px;">
                            <i class="fa-solid fa-check-double me-2"></i> Finaliser et Enregistrer
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        {% else %}
            <div class="text-center py-5 mb-5">
                <div class="mb-4 opacity-50">
                    <i class="fa-solid fa-arrow-pointer" style="font-size: 4rem; color: var(--elite-accent);"></i>
                </div>
                <h4 class="fw-bold" style="color: var(--elite-navy);">Saisie de Consultation</h4>
                <p class="text-muted fs-6" style="max-width: 600px; margin: 0 auto;">Veuillez sélectionner un rendez-vous depuis votre <a href="{{ path('app_pro_workspace', {view: 'rdv'}) }}" class="fw-bold text-decoration-none" style="color: var(--elite-accent);">Planning</a> ou utiliser le bouton "Modifier" ci-dessous pour rédiger ou mettre à jour un compte-rendu.</p>
            </div>
        {% endif %}

        <div class="history-section mt-5 border-top pt-5">
            <h4 class="fw-bold mb-4" style="color: var(--elite-navy); opacity: 0.8;">Historique Récents</h4>
            <div class="row g-3">
                {% for consultation in consultations %}
                    <div class="col-12">
                        <div class="consultation-history-item d-flex align-items-center justify-content-between elite-glass-card" style="padding: 1.5rem; border-radius: 20px; background: white;">
                            <div class="d-flex align-items-center gap-4">
                                <div class="icon-circle bg-light text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-folder-open"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold" style="color: var(--elite-navy);">Consultation #{{ consultation.id }} <span class="text-muted" style="font-weight: 500; font-size: 0.8rem;">(RDV #{{ consultation.appointment.id }})</span></h6>
                                    <small style="color: var(--elite-accent); font-weight: 600;">{{ consultation.dateConsultation|date('d F Y') }}</small>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-light px-3" style="border-radius: 10px; color: var(--elite-accent);" 
                                    onclick="showConsultationDetails({
                                        id: '{{ consultation.id }}',
                                        appointmentId: '{{ consultation.appointment.id }}',
                                        dateConsultation: '{{ consultation.dateConsultation|date('Y-m-d') }}',
                                        diagnostic: '{{ consultation.diagnostic|e('js') }}',
                                        duree: '{{ consultation.duree }}',
                                        statutConsultation: '{{ consultation.statutConsultation|e('js') }}',
                                        traitement: '{{ consultation.traitement|e('js') }}',
                                        observation: '{{ consultation.observation|e('js') }}',
                                        ordonnance: '{{ consultation.ordonnance|e('js') }}'
                                    })">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                                <a href="{{ path('app_pro_workspace', {view: 'consultations', appointment_id: consultation.appointment.id}) }}" class="btn btn-sm btn-outline-primary px-3" style="border-radius: 10px;" title="Modifier">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form method="post" action="{{ path('app_pro_workspace_consultation_delete', {id: consultation.id}) }}" onsubmit="return confirm('Supprimer ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ consultation.id) }}">
                                    <button class="btn btn-sm btn-outline-danger px-3" style="border-radius: 10px;"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5">
                        <div class="mb-4" style="position: relative; display: inline-block;">
                            <i class="fa-solid fa-folder-open" style="font-size: 5rem; color: var(--elite-navy); opacity: 0.1;"></i>
                        </div>
                        <h4 class="fw-bold" style="color: var(--elite-navy);">Historique des consultations vide</h4>
                        <p class="text-muted">Aucun compte-rendu médical n'a été enregistré pour le moment.</p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<!-- Elite Details Modal -->
<div id="detailsModal" class="evolia-modal">
    <div class="evolia-modal-content">
        <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-4">
            <h3 class="fw-bold mb-0" id="modalTitle" style="color: var(--elite-navy);">Détails</h3>
            <button type="button" class="btn-close" onclick="closeModal()"></button>
        </div>
        <div id="modalBody"></div>
        <div class="mt-5 pt-4 text-end">
            <button class="btn btn-elite-primary" style="background: var(--elite-navy); border-radius: 14px; padding: 0.75rem 2rem;" onclick="closeModal()">Fermer</button>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById('detailsModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalBody = document.getElementById('modalBody');

    function showRdvDetails(rdv) {
        console.log("RDV Data:", rdv);
        try {
            modalTitle.innerText = "Rendez-vous #" + rdv.id;
            modalBody.innerHTML = `
                <div class="row g-5">
                    <div class="col-md-6">
                        <label class="elite-label">Date & Heure</label>
                        <p class="fw-bold h4" style="color: var(--elite-navy);">${rdv.dateRdv} — ${rdv.heureRdv}</p>
                    </div>
                <div class="col-md-6 text-md-end">
                    <label class="elite-label">Statut Actuel</label>
                    <div><span class="status-badge-elite status-${rdv.statut.toLowerCase().replace(' ', '-')}">${rdv.statut}</span></div>
                </div>
                <div class="col-12">
                    <label class="elite-label">Motif de Consultation</label>
                    <div class="p-4" style="background: #f8fafc; border-radius: 18px; border-left: 6px solid var(--elite-accent); line-height: 1.6; font-size: 1.1rem;">
                        ${rdv.motif || 'Aucun motif renseigné'}
                    </div>
                </div>
            </div>
        `;
        modal.classList.add('active');
        } catch (e) { console.error("Error showing RDV details:", e); }
    }

    function showConsultationDetails(con) {
        console.log("Consultation Data:", con);
        try {
            modalTitle.innerText = "Consultation #" + con.id;
            modalBody.innerHTML = `
                <div class="row g-5">
                    <div class="col-md-4"><label class="elite-label">Date</label><p class="fw-bold h5">${con.dateConsultation}</p></div>
                    <div class="col-md-4"><label class="elite-label">Durée</label><p class="fw-bold h5">${con.duree || '-'} min</p></div>
                    <div class="col-md-4"><label class="elite-label">Statut</label><p class="fw-bold h5">${con.statutConsultation || 'En cours'}</p></div>
                    <div class="col-12">
                        <label class="elite-label">Diagnostic</label>
                        <div class="p-4 mb-4" style="background: #f0f9ff; border-radius: 18px; color: #0369a1; font-weight: 500;">${con.diagnostic || 'Non spécifié'}</div>
                    </div>
                    <div class="col-md-6"><label class="elite-label">Traitement</label><div class="p-3" style="background: #fdfdfd; border: 1px dashed #cbd5e1; border-radius: 14px;">${con.traitement || 'N/A'}</div></div>
                    <div class="col-md-6"><label class="elite-label">Observations</label><div class="p-3" style="background: #fdfdfd; border: 1px dashed #cbd5e1; border-radius: 14px;">${con.observation || 'N/A'}</div></div>
                    <div class="col-12"><label class="elite-label">Ordonnance</label><pre class="p-4" style="background: #1e293b; color: #38bdf8; border-radius: 18px; font-family: 'Courier New', monospace; white-space: pre-wrap;">${con.ordonnance || 'N/A'}</pre></div>
                </div>
            `;
            modal.classList.add('active');
        } catch (e) { console.error("Error showing Consultation details:", e); }
    }

    function closeModal() { modal.classList.remove('active'); }
    window.onclick = function(event) { if (event.target == modal) closeModal(); }
</script>
</div>
</div>
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
