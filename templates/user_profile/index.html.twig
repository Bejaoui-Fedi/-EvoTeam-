{% extends 'base.html.twig' %}

{% block title %}Evolia — Mon Profil{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <style>
        /* NUCLEAR FULL WIDTH FIX */
        body.user-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
        }
        .btn-logout-alt {
            background: #ffffff !important;
            color: #dc3545 !important;
            border: 2px solid #dc3545 !important;
            padding: 12px 25px !important;
            border-radius: 30px !important;
            font-weight: 700 !important;
            font-size: 0.95rem !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 12px !important;
            transition: all 0.3s ease !important;
            cursor: pointer !important;
            text-decoration: none !important;
        }
        .btn-logout-alt:hover {
            background: #dc3545 !important;
            color: #ffffff !important;
            transform: translateY(-4px) !important;
            box-shadow: 0 10px 20px rgba(220, 53, 69, 0.2) !important;
        }
    </style>
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
{% endblock %}

{% block body %}

<div class="user-scope">
{% include 'user_nav_bar/index.html.twig' %}

<div class="user-main-content">
    <div class="profile-card">
        <div class="profile-hero">
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center gap-4">
                    <div class="hero-icon-wrapper">
                        <i class="fa-solid fa-sparkles fs-1 text-white opacity-50"></i>
                    </div>
                    <div>
                        <h1>Mon Profil</h1>
                        <p class="m-0 fs-5 opacity-75">Bienvenue dans votre havre de paix, {{ user.nom }}.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-5 mt-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mb-0 rounded-4 shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-{{ label == 'error' ? 'exclamation' : 'check' }} me-2"></i>
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <div class="profile-content">
            <div class="row g-5">
                <div class="col-lg-4 text-center">
                    <div class="profile-sidebar-inner p-4 rounded-5" style="background: rgba(30, 77, 107, 0.03);">
                        <div class="avatar-container mx-auto mb-4 shadowed-avatar">
                            {% if userProfile and userProfile.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ userProfile.avatar) }}" alt="Avatar">
                            {% else %}
                                <img src="https://images.unsplash.com/photo-1531427186611-ecfd6d936c79?auto=format&fit=crop&q=80&w=120&h=120" alt="Avatar par défaut">
                            {% endif %}
                        </div>
                        <div class="mb-3">
                            <span class="badge-patient px-3 py-2">
                                {% if 'ROLE_ADMIN' in user.roles %} Administrateur
                                {% elseif 'ROLE_PSYCHOLOGUE' in user.roles %} Psychologue
                                {% elseif 'ROLE_COACH' in user.roles %} Coach
                                {% else %} Patient {% endif %}
                            </span>
                        </div>

                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="profile-main-section">
                        <h2 class="profile-section-title">
                            <i class="fa-solid fa-address-card me-2 opacity-50"></i> Informations personnelles
                        </h2>
                        <div class="info-grid">
                            <div class="info-item">
                                <label>Nom complet</label>
                                <p>{{ user.nom }}</p>
                            </div>
                            <div class="info-item">
                                <label>Email professionnel</label>
                                <p>{{ user.email }}</p>
                            </div>
                            <div class="info-item">
                                <label>Téléphone</label>
                                <p>{{ user.telephone ?? 'Non renseigné' }}</p>
                            </div>
                            <div class="info-item">
                                <label>Statut du compte</label>
                                <p>
                                    {% if user.actif %}
                                        <span class="status-active-dot"></span> <span class="text-success">Vérifié & Actif</span>
                                    {% else %}
                                        <span class="status-inactive-dot" style="display:inline-block; width:8px; height:8px; border-radius:50%; background-color:#dc3545; margin-right:5px;"></span> <span class="text-danger">Inactif</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        <h2 class="profile-section-title mt-5">
                            <i class="fa-solid fa-quote-left me-2 opacity-50"></i> À propos de moi
                        </h2>
                        <div class="info-item">
                            <p class="text-muted fst-italic bg-light p-4 rounded-4">
                                {{ userProfile ? (userProfile.bio|default("Aucune biographie renseignée pour le moment.")) : "Aucune biographie renseignée pour le moment." }}
                            </p>
                        </div>

                        <div class="mt-5 d-flex gap-3">
                            <a href="{{ path('app_user_profile_edit') }}" class="edit-btn m-0 px-5 py-3 shadow-lg text-decoration-none d-inline-block">
                                <i class="fa-solid fa-user-pen me-2"></i> Éditer mon profil
                            </a>
                            <a href="{{ path('app_user_logout') }}" class="btn-logout-alt m-0 px-5 py-3 shadow-lg text-decoration-none d-inline-block" data-turbo="false">
                                <i class="fa-solid fa-right-from-bracket me-2"></i> Déconnexion
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
