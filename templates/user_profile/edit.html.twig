{% extends 'base.html.twig' %}

{% block title %}Evolia — Modifier mon Profil{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
{% endblock %}

{% block body %}

<div class="user-scope">
{% include 'user_nav_bar/index.html.twig' %}

<div class="user-main-content">
    <div class="profile-card">
        <div class="profile-hero">
            <div class="d-flex align-items-center gap-4" style="position: relative; z-index: 10;">
                <a href="{{ path('app_user_profile') }}" class="p-3 bg-white rounded-circle shadow-sm text-primary text-decoration-none" style="display: flex; align-items: center; justify-content: center; width: 50px; height: 50px;">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h1 style="color: #ffffff !important;">Modifier mon Profil</h1>
                    <p class="m-0 opacity-75">Personnalisez votre espace personnel.</p>
                </div>
            </div>
        </div>

        <div class="px-5 mt-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mb-0 rounded-4 shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-{{ label == 'error' ? 'exclamation' : 'check' }} me-2"></i>
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <div class="profile-content p-5">
            <form action="{{ path('app_user_profile_update') }}" method="POST" enctype="multipart/form-data">
                <div class="row g-5">
                    <div class="col-lg-4 text-center">
                        <div class="avatar-edit-wrapper mx-auto mb-4">
                            <div class="avatar-container shadowed-avatar" id="avatarPreviewContainer">
                                {% if userProfile.avatar %}
                                    <img src="{{ asset('uploads/avatars/' ~ userProfile.avatar) }}" alt="Avatar" id="avatarPreview">
                                {% else %}
                                    <img src="https://images.unsplash.com/photo-1531427186611-ecfd6d936c79?auto=format&fit=crop&q=80&w=120&h=120" alt="Avatar par défaut" id="avatarPreview">
                                {% endif %}
                                <div class="avatar-overlay">
                                    <i class="fa-solid fa-camera fs-3 text-white"></i>
                                    <input type="file" name="avatar" id="avatarInput" accept="image/*">
                                </div>
                            </div>
                            <p class="small text-muted mt-3">Cliquez sur l'image pour charger une nouvelle photo</p>
                        </div>
                    </div>

                    <div class="col-lg-8">
                        <div class="info-grid mt-0">
                            <div class="col-12 mb-4">
                                <h5 class="text-primary mb-3"><i class="fa-solid fa-user-circle me-2"></i> Informations de base</h5>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">Nom Complet</label>
                                <input type="text" name="nom" class="form-control rounded-4 p-3 shadow-sm border-light" value="{{ user.nom }}" required>
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">Téléphone</label>
                                <input type="tel" name="phone" class="form-control rounded-4 p-3 shadow-sm border-light" value="{{ user.telephone }}" placeholder="+216 XX XXX XXX">
                            </div>

                            <div class="col-12 mb-4 mt-4">
                                <h5 class="text-primary mb-3"><i class="fa-solid fa-pencil me-2"></i> Ma Biographie</h5>
                                <textarea name="bio" class="form-control rounded-4 p-3 shadow-sm border-light" rows="5" placeholder="Parlez-nous un peu de vous...">{{ userProfile.bio }}</textarea>
                            </div>

                            <div class="col-12 mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                                <a href="{{ path('app_user_profile') }}" class="btn-secondary-custom">Annuler</a>
                                <button type="submit" class="edit-btn">
                                    <i class="fa-solid fa-save me-2"></i> Enregistrer les modifications
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

</div>

<style>
.avatar-edit-wrapper {
    position: relative;
    width: 150px;
}
.avatar-container {
    position: relative;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
}
.avatar-container:hover {
    transform: scale(1.05);
}
.avatar-overlay {
    position: absolute;
    inset: 0;
    background: rgba(30, 77, 107, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}
.avatar-container:hover .avatar-overlay {
    opacity: 1;
}
#avatarInput {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
}
.form-control:focus {
    border-color: var(--primary-color) !important;
    box-shadow: 0 5px 15px rgba(30, 77, 107, 0.1) !important;
}

/* PREMIUM BUTTONS NUCLEAR FIX */
.edit-btn {
    background: linear-gradient(135deg, #1e4d6b 0%, #2a6f97 100%) !important;
    color: #fff !important;
    border: none !important;
    padding: 14px 35px !important;
    border-radius: 30px !important;
    font-weight: 700 !important;
    font-size: 0.95rem !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 12px !important;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    box-shadow: 0 10px 25px rgba(30, 77, 107, 0.2) !important;
    cursor: pointer !important;
    text-decoration: none !important;
}

.edit-btn:hover {
    transform: translateY(-4px) scale(1.02) !important;
    box-shadow: 0 15px 35px rgba(30, 77, 107, 0.3) !important;
    filter: brightness(1.1) !important;
}

.btn-secondary-custom {
    background: #f8fafc !important;
    color: #64748b !important;
    border: 1.5px solid #e2e8f0 !important;
    padding: 14px 35px !important;
    border-radius: 30px !important;
    font-weight: 700 !important;
    font-size: 0.95rem !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05) !important;
}

.btn-secondary-custom:hover {
    background: #f1f5f9 !important;
    color: #1e293b !important;
    border-color: #cbd5e1 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 12px rgba(0,0,0,0.1) !important;
}
</style>

<script>
document.getElementById('avatarInput').addEventListener('change', function(event) {
    const file = event.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('avatarPreview').src = e.target.result;
        };
        reader.readAsDataURL(file);
    }
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
