{% extends 'base.html.twig' %}

{% block title %}Dashboard Overview{% endblock %}

{% block body %}
    <h1 class="title">Overview <span>Dashboard</span></h1>
    <div class="hero-divider"></div>
    <p class="subtitle" style="text-align: center; margin-bottom: 40px;">Your interactive platform analytics</p>

    <!-- Animated Widgets Grid -->
    <div class="dashboard-grid">
        <div class="widget-card">
            <div class="widget-icon"><i class="fa-solid fa-users"></i></div>
            <div class="widget-value">{{ totalUsers }}</div>
            <div class="widget-label">Total Users</div>
        </div>
        
        <div class="widget-card">
            <div class="widget-icon" style="color: #60a5fa;"><i class="fa-solid fa-list-check"></i></div>
            <div class="widget-value">{{ completedTasks }} <span style="font-size: 1rem; color: rgba(255,255,255,0.5);">/ {{ totalTasks }}</span></div>
            <div class="widget-label">Completed Tasks</div>
        </div>

        <div class="widget-card">
            <div class="widget-icon" style="color: #fcd34d;"><i class="fa-solid fa-face-smile"></i></div>
            <div class="widget-value">{{ avgMood }}</div>
            <div class="widget-label">Average Mood (x/5)</div>
        </div>

        <div class="widget-card">
            <div class="widget-icon" style="color: #f87171;"><i class="fa-solid fa-heart-pulse"></i></div>
            <div class="widget-value">{{ avgStress }}</div>
            <div class="widget-label">Average Stress (x/5)</div>
        </div>
    </div>

    <!-- Interactive Trend Chart -->
    <div class="chart-container">
        <canvas id="wellbeingChart" style="width: 100%; height: 350px;"></canvas>
    </div>

    <!-- Quick Animated Actions -->
    <div class="quick-actions">
        <a href="{{ path('app_daily_routine_task_new') }}" class="btn btn-admin"><i class="fa-solid fa-plus"></i> Create Routine Task</a>
        <a href="{{ path('app_wellbeing_tracker_new') }}" class="btn btn-personal"><i class="fa-solid fa-notes-medical"></i> Log Wellbeing</a>
        <a href="{{ path('app_user_new') }}" class="btn" style="background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2);"><i class="fa-solid fa-user-plus"></i> Register User</a>
    </div>

    <!-- Chart.js Injection & Configuration -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('wellbeingChart').getContext('2d');
            
            const rawDates = {{ chartDates|raw }};
            const moodScores = {{ moodScores|raw }};
            const stressScores = {{ stressScores|raw }};

            // Custom gradient for beautifully modern charts
            let gradientMood = ctx.createLinearGradient(0, 0, 0, 400);
            gradientMood.addColorStop(0, 'rgba(252, 211, 77, 0.5)'); // Yellow-ish
            gradientMood.addColorStop(1, 'rgba(252, 211, 77, 0.0)');

            let gradientStress = ctx.createLinearGradient(0, 0, 0, 400);
            gradientStress.addColorStop(0, 'rgba(248, 113, 113, 0.5)'); // Red-ish
            gradientStress.addColorStop(1, 'rgba(248, 113, 113, 0.0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: rawDates,
                    datasets: [
                        {
                            label: 'Mood Score',
                            data: moodScores,
                            borderColor: '#fcd34d',
                            backgroundColor: gradientMood,
                            borderWidth: 3,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#fcd34d',
                            pointHoverRadius: 8,
                            tension: 0.4,
                            fill: true
                        },
                        {
                            label: 'Stress Score',
                            data: stressScores,
                            borderColor: '#f87171',
                            backgroundColor: gradientStress,
                            borderWidth: 3,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#f87171',
                            pointHoverRadius: 8,
                            tension: 0.4,
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: {
                            labels: { color: 'rgba(255,255,255,0.8)', font: { family: 'Inter', size: 14 } }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(255,255,255,0.9)',
                            titleColor: '#1a3a2e',
                            bodyColor: '#1a3a2e',
                            borderColor: 'transparent',
                            padding: 10,
                            boxPadding: 4,
                            usePointStyle: true
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false },
                            ticks: { color: 'rgba(255,255,255,0.6)', font: { family: 'Inter' } }
                        },
                        y: {
                            beginAtZero: true,
                            max: 5,
                            grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false },
                            ticks: { color: 'rgba(255,255,255,0.6)', stepSize: 1, font: { family: 'Inter' } }
                        }
                    }
                }
            });
        });
    </script>
{% endblock %}
