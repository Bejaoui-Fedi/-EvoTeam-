{% extends 'base.html.twig' %}

{% block title %}Evolia — Réinitialiser le mot de passe{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_login.css') }}">
    <style>
        .modern-alert {
            display: flex;
            align-items: center;
            padding: 1rem;
            margin-bottom: 2rem;
            border-radius: 1.25rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
        }
        .alert-danger {
            background: #842029 !important;
            border: 1px solid #721c24 !important;
            color: #ffffff !important;
            box-shadow: 0 4px 15px rgba(114, 28, 36, 0.3) !important;
        }
        .alert-success {
            background: #0f5132 !important;
            border: 1px solid #0d4128 !important;
            color: #ffffff !important;
            box-shadow: 0 4px 15px rgba(13, 65, 40, 0.3) !important;
        }
        .alert-icon-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            background: rgba(255, 255, 255, 0.2) !important;
            color: #ffffff !important;
            font-size: 1.25rem;
        }
        .alert-message {
            font-size: 0.95rem;
            text-align: left;
        }
        .alert-message strong {
            display: block;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            margin-bottom: 2px;
            opacity: 0.8;
        }
        .code-input {
            letter-spacing: 5px;
            text-align: center;
            font-weight: 700;
            font-size: 1.25rem;
        }
    </style>
{% endblock %}

{% block body %}

{# ——— BOOTSTRAP BACKGROUND CAROUSEL ——— #}
<div id="bgCarousel" class="carousel slide carousel-fade bg-carousel" data-bs-ride="carousel" data-bs-interval="1500">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/images/bg-2.jpg" class="d-block w-100" alt="Bien-être 1">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-3.jpg" class="d-block w-100" alt="Bien-être 2">
        </div>
        <div class="carousel-item">
            <img src="/images/bg-4.jpg" class="d-block w-100" alt="Bien-être 3">
        </div>
    </div>
</div>

{# ——— DARK OVERLAY ——— #}
<div class="bg-dark-overlay"></div>

<div class="login-card">

    <i class="fa-solid fa-key login-icon"></i>

    <h1>Réinitialiser</h1>
    <p class="subtitle">Entrez le code reçu par email ({{ email }}) et votre nouveau mot de passe.</p>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="modern-alert alert-{{ label == 'danger' ? 'danger' : 'success' }} animate__animated animate__fadeInUp">
                <div class="alert-icon-circle">
                    <i class="fa-solid fa-{{ label == 'danger' ? 'circle-exclamation' : 'circle-check' }}"></i>
                </div>
                <div class="alert-message">
                    <strong>{{ label == 'danger' ? 'Oups !' : 'Succès !' }}</strong> {{ message }}
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <form method="post" action="{{ path('app_forgot_password_reset') }}">
        <input type="hidden" name="email" value="{{ email }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">

        <div class="form-group">
            <label class="form-label" for="code">Code de validation (6 chiffres)</label>
            <input
                type="text"
                id="code"
                name="code"
                class="form-control code-input"
                maxlength="6"
                placeholder="000000"
                required
                autocomplete="one-time-code"
                readonly
                onfocus="this.removeAttribute('readonly');"
                onmousedown="this.removeAttribute('readonly');"
            >
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Nouveau mot de passe</label>
            <input
                type="password"
                id="password"
                name="password"
                class="form-control"
                placeholder="••••••••"
                required
            >
        </div>

        <div class="form-group">
            <label class="form-label" for="confirm_password">Confirmer le mot de passe</label>
            <input
                type="password"
                id="confirm_password"
                name="confirm_password"
                class="form-control"
                placeholder="••••••••"
                required
            >
        </div>

        <button type="submit" class="btn-login" style="border: none; width: 100%;">
            <i class="fa-solid fa-check"></i>
            Réinitialiser
        </button>

    </form>

    <p class="register-link">
        <a href="{{ path('app_forgot_password_request') }}">Retour</a>
    </p>

    <hr class="divider">

    <a href="{{ path('app_home') }}" class="btn-back">
        <i class="fa-solid fa-house"></i> Retour à l'accueil
    </a>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
