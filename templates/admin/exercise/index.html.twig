{% extends 'base.html.twig' %}

{% block title %}Manage Exercises — Evolia{% endblock %}

{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    <style>
        .admin-main-content { margin-left: 260px; padding: 36px; flex: 1; }
        
        .search-bar { background:#fff; border-radius:40px; padding:8px 20px; border:1px solid #e2e8f0; display:flex; align-items:center; gap:10px; min-width:280px; }
        .search-bar input { border:none; outline:none; flex:1; font-size:0.9rem; }
        .sort-select { background:#fff; border:1px solid #e2e8f0; border-radius:40px; padding:8px 18px; font-size:0.875rem; cursor:pointer; }
        
        /* ── Cards Grid ── */
        .ex-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
        .ex-card {
            background: #fff; border-radius: 16px; padding: 22px;
            border: 1px solid #e2e8f0; transition: all 0.25s;
            display: flex; flex-direction: column; gap: 10px; position:relative;
        }
        .ex-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.1); }
        
        /* Dynamic Exercise Colors */
        .ex-card.c-easy   { border-top:4px solid #27AE60; background:linear-gradient(180deg, #ffffff 0%, #f4fbf7 100%); }
        .ex-card.c-easy:hover { border-color:#27AE60; }
        .ex-card.c-medium { border-top:4px solid #F39C12; background:linear-gradient(180deg, #ffffff 0%, #fdf8f0 100%); }
        .ex-card.c-medium:hover { border-color:#F39C12; }
        .ex-card.c-hard   { border-top:4px solid #E74C3C; background:linear-gradient(180deg, #ffffff 0%, #fdf4f4 100%); }
        .ex-card.c-hard:hover { border-color:#E74C3C; }
        
        .badge-diff { font-size: 0.7rem; font-weight: 700; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; }
        .badge-easy   { background:#E9F7EF; color:#27AE60; }
        .badge-medium { background:#FEF9E7; color:#F39C12; }
        .badge-hard   { background:#FDEDEC; color:#E74C3C; }
        .badge-type   { background:#EAF2FB; color:#2980B9; font-size: 0.7rem; font-weight: 700; padding: 3px 10px; border-radius: 20px; }
        
        .ex-title { font-size: 1rem; font-weight: 700; color: #1a202c; margin: 0; line-height: 1.3; }
        .ex-obj-link { font-size: 0.82rem; color: #3A7D6B; font-weight:600; text-decoration:none; }
        .ex-obj-link:hover { text-decoration:underline; }
        .ex-meta { font-size: 0.75rem; color: #a0aec0; }
        
        .card-actions { display:flex; gap:8px; align-items:center; margin-top:12px; padding-top:12px; border-top:1px solid #f0f4f8; }
        .btn-action { width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; border:none; cursor:pointer; transition:all 0.2s; text-decoration:none; font-size:0.9rem; }
        .btn-edit    { background:#EAF2FB; color:#2980b9; }
        .btn-edit:hover { background:#2980b9; color:#fff; }
        .btn-del     { background:#FDEDEC; color:#e74c3c; }
        .btn-del:hover { background:#e74c3c; color:#fff; }
        .btn-yt      { background:rgba(255,0,0,0.1); color:#cc0000; width:auto; padding:0 12px; height:36px; border-radius:10px; font-weight:700; font-size:0.75rem; display:flex; gap:6px; }
        .btn-yt:hover{ background:#cc0000; color:#fff; }
        .btn-yt.loading { opacity:0.6; pointer-events:none; }
        
        .status-dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
        .status-pub { background:#27AE60; box-shadow:0 0 5px #27AE60; }
        .status-draft { background:#E67E22; }
        
        .empty-state { text-align:center; padding:80px 20px; color:#a0aec0; }
        .empty-state i { font-size: 3rem; margin-bottom: 16px; display:block; opacity:0.4; }
    </style>
{% endblock %}

{% block body %}
<div style="display:flex;min-height:100vh;">
    {% include 'admin_nav_bar/index.html.twig' %}

    <div class="admin-main-content">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="fw-bold"><i class="fa-solid fa-person-running text-success me-3"></i>Exercises</h1>
                <p class="text-muted">Manage the specific tasks for each objective</p>
            </div>
            
            <div class="d-flex gap-3 align-items-center flex-wrap">
                <form method="GET" class="d-flex gap-2 align-items-center">
                    <div class="search-bar">
                        <i class="fa-solid fa-magnifying-glass" style="color:#a0aec0"></i>
                        <input type="text" name="q" value="{{ q }}" placeholder="Rechercher un exercice…" id="searchInput" oninput="debounceSubmit()">
                    </div>
                    <select name="sort" class="sort-select" onchange="this.form.submit()">
                        <option value="title_az"  {{ sort == 'title_az'  ? 'selected' }}>Titre A → Z</option>
                        <option value="title_za"  {{ sort == 'title_za'  ? 'selected' }}>Titre Z → A</option>
                        <option value="duration"  {{ sort == 'duration'  ? 'selected' }}>Durée ↑</option>
                        <option value="difficulty"{{ sort == 'difficulty'? 'selected' }}>Difficulté</option>
                    </select>
                </form>

                <a href="{{ path('app_admin_exercise_new') }}" class="btn btn-success rounded-pill shadow-sm px-4 py-2 fw-bold">
                    <i class="fa-solid fa-plus me-2"></i>New Exercise
                </a>
            </div>
        </div>

        {% if exercises is empty %}
            <div class="empty-state">
                <i class="fa-solid fa-dumbbell"></i>
                <p>No exercises found. Create one to get started.</p>
            </div>
        {% else %}
            <div class="ex-grid">
                {% for exercise in exercises %}
                    <div class="ex-card c-{{ exercise.difficulty|lower|default('medium') }}">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                <span class="badge-diff badge-{{ exercise.difficulty|lower|default('medium') }}">{{ exercise.difficulty }}</span>
                                <span class="badge-type">⚡ {{ exercise.type|capitalize|default('Général') }}</span>
                            </div>
                            <span class="status-dot {{ exercise.isPublished ? 'status-pub' : 'status-draft' }}" title="{{ exercise.isPublished ? 'Published' : 'Draft' }}"></span>
                        </div>
                        
                        <p class="ex-title">{{ exercise.title }}</p>
                        
                        <div class="d-flex flex-column gap-1">
                            {% if exercise.objective %}
                                <div class="text-truncate">
                                    <i class="fa-solid fa-bullseye opacity-50 me-1" style="font-size:0.8rem"></i>
                                    <a href="{{ path('app_admin_objective_edit', {'id': exercise.objective.id}) }}" class="ex-obj-link">{{ exercise.objective.title }}</a>
                                </div>
                            {% else %}
                                <div class="small text-muted"><i class="fa-solid fa-bullseye opacity-25 me-1"></i>No Objective</div>
                            {% endif %}
                            
                            <div class="ex-meta">
                                <i class="fa-regular fa-clock me-1"></i>{{ exercise.durationMinutes }} min
                                &nbsp;·&nbsp;
                                <i class="fa-solid fa-calendar-day me-1"></i>{{ exercise.createdAt|date('d/m/Y') }}
                            </div>
                        </div>

                        <div class="card-actions mt-auto">
                            <a href="{{ path('app_admin_exercise_edit', {'id': exercise.id}) }}" class="btn-action btn-edit" title="Modifier">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            {% if exercise.mediaUrl is empty %}
                                <button class="btn-action btn-yt" id="yt-btn-{{ exercise.id }}" 
                                    data-url="{{ path('app_admin_exercise_fetch_video', {id: exercise.id}) }}"
                                    onclick="fetchYoutube({{ exercise.id }})">
                                    <i class="fa-brands fa-youtube"></i> Chercher vidéo
                                </button>
                            {% endif %}
                            <div class="ms-auto">
                                <form style="display:inline" method="post" action="{{ path('app_admin_exercise_delete', {'id': exercise.id}) }}" onsubmit="return confirm('Are you sure you want to delete this exercise?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_ex_' ~ exercise.id) }}">
                                    <button type="submit" class="btn-action btn-del" title="Supprimer">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
let timer;
function debounceSubmit() {
    clearTimeout(timer);
    timer = setTimeout(() => document.getElementById('searchInput').form.submit(), 400);
}

function fetchYoutube(id) {
    const btn = document.getElementById('yt-btn-'+id);
    if (!btn) return;
    const url = btn.getAttribute('data-url');
    btn.classList.add('loading');
    btn.innerHTML = '<i class="fa-solid fa-rotate fa-spin"></i> Recherche…';

    fetch(url, {method:'POST'})
        .then(r => r.json()).then(data => {
            if (data.url) {
                btn.innerHTML = '✅ Vidéo trouvée !';
                btn.style.background = '#27AE60';
                setTimeout(() => location.reload(), 1200);
            } else {
                btn.innerHTML = '❌ ' + (data.error || 'Erreur');
                btn.classList.remove('loading');
                btn.style.background = '#718096';
            }
        }).catch(() => {
            btn.innerHTML = '❌ Erreur réseau';
            btn.classList.remove('loading');
        });
}
</script>
{% endblock %}
