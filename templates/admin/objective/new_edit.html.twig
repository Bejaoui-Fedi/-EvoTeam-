{% extends 'base.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Modifier' : 'Nouvel' }} Objectif — Admin Evolia{% endblock %}
{% block body_class %}admin-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    <style>
        body.admin-theme { background: #f0f4f8; color: #1a202c; }
        .admin-main { margin-left: 260px; padding: 36px; flex: 1; }
        .form-card {
            background: #fff; border-radius: 20px; padding: 40px;
            border: 1px solid #e2e8f0; max-width: 700px; margin: 0 auto;
            box-shadow: 0 4px 24px rgba(0,0,0,0.05);
        }
        .form-label { font-weight: 600; color: #4a5568; font-size: 0.875rem; margin-bottom: 6px; }
        .form-control, .form-select {
            border: 1.5px solid #e2e8f0; border-radius: 12px;
            padding: 12px 16px; font-size: 0.9rem; transition: border-color 0.2s;
        }
        .form-control:focus, .form-select:focus { border-color: #3A7D6B; box-shadow: 0 0 0 3px rgba(58,125,107,0.12); }
        .level-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
        .level-option { display: none; }
        .level-label {
            display: flex; flex-direction: column; align-items: center; gap: 6px;
            padding: 14px 8px; border-radius: 12px; border: 2px solid #e2e8f0;
            cursor: pointer; transition: all 0.2s; font-size: 0.8rem; font-weight: 600;
        }
        .level-label i { font-size: 1.3rem; }
        .level-option:checked + .level-label { border-color: currentColor; background: rgba(0,0,0,0.03); }
        .level-debutant + .level-label  { color: #27AE60; }
        .level-moyen + .level-label     { color: #F39C12; }
        .level-avance + .level-label    { color: #E74C3C; }
        .level-global + .level-label    { color: #2980B9; }
        .level-debutant:checked + .level-label { background: #E9F7EF; border-color: #27AE60; }
        .level-moyen:checked + .level-label    { background: #FEF9E7; border-color: #F39C12; }
        .level-avance:checked + .level-label   { background: #FDEDEC; border-color: #E74C3C; }
        .level-global:checked + .level-label   { background: #EAF2FB; border-color: #2980B9; }
        .publish-toggle { display: flex; align-items: center; gap: 14px; padding: 16px 20px; background: #f8fafc; border-radius: 14px; border: 1.5px solid #e2e8f0; }
        .form-switch .form-check-input { width: 44px; height: 24px; cursor: pointer; }
        .form-switch .form-check-input:checked { background-color: #3A7D6B; border-color: #3A7D6B; }
        .btn-submit { background: linear-gradient(135deg, #3A7D6B, #27AE60); border: none; border-radius: 12px; color: #fff; padding: 13px 32px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; }
        .btn-submit:hover { filter: brightness(1.1); transform: translateY(-1px); }
        .flash-error { background:#FDEDEC; color:#E74C3C; border:1px solid #F5B7B1; padding:12px 20px; border-radius:12px; margin-bottom:16px; font-size:0.875rem; }
    </style>
{% endblock %}

{% block body %}
<div style="display:flex;min-height:100vh;">
    {% include 'admin_nav_bar/index.html.twig' %}
    <main class="admin-main">
        <div class="mb-4">
            <a href="{{ path('app_admin_objective_index') }}" class="text-decoration-none text-muted">
                <i class="fa-solid fa-arrow-left me-2"></i>Retour aux objectifs
            </a>
        </div>

        <div class="form-card">
            <div class="d-flex align-items-center gap-3 mb-5">
                <div style="width:48px;height:48px;background:linear-gradient(135deg,#3A7D6B,#27AE60);border-radius:14px;display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-bullseye text-white fs-5"></i>
                </div>
                <div>
                    <h1 class="h4 mb-0 fw-bold">{{ mode == 'edit' ? 'Modifier l\'objectif' : 'Nouvel Objectif' }}</h1>
                    <p class="text-muted small mb-0">{{ mode == 'edit' ? objective.title : 'Créer un objectif pour vos utilisateurs' }}</p>
                </div>
            </div>

            {% for msg in app.flashes('error') %}
                <div class="flash-error"><i class="fa-solid fa-triangle-exclamation me-2"></i>{{ msg }}</div>
            {% endfor %}

            <form method="POST" action="{{ mode == 'edit' ? path('app_admin_objective_edit', {id: objective.id}) : path('app_admin_objective_new') }}" novalidate>

                {# Title #}
                <div class="mb-4">
                    <label class="form-label"><i class="fa-solid fa-heading me-1 text-muted"></i>Titre *</label>
                    <input type="text" name="title" class="form-control" required
                           value="{{ objective.title ?? '' }}" placeholder="Ex: Gérer son stress au quotidien" id="titleInput">
                </div>

                {# Description #}
                <div class="mb-4">
                    <label class="form-label"><i class="fa-solid fa-align-left me-1 text-muted"></i>Description</label>
                    <textarea name="description" class="form-control" rows="4"
                              placeholder="Décrivez cet objectif en quelques phrases…">{{ objective.description ?? '' }}</textarea>
                </div>

                {# Level #}
                <div class="mb-4">
                    <label class="form-label"><i class="fa-solid fa-signal me-1 text-muted"></i>Niveau</label>
                    <div class="level-grid">
                        {% set levels = {
                            debutant: { icon: 'fa-seedling', label: 'Débutant' },
                            moyen:    { icon: 'fa-leaf',     label: 'Moyen' },
                            avance:   { icon: 'fa-fire',     label: 'Avancé' },
                            global:   { icon: 'fa-globe',    label: 'Global' }
                        } %}
                        {% for val, meta in levels %}
                            <div>
                                <input type="radio" name="level" value="{{ val }}" id="level_{{ val }}"
                                       class="level-option level-{{ val }}"
                                       {{ (objective.level ?? 'debutant') == val ? 'checked' }}>
                                <label for="level_{{ val }}" class="level-label">
                                    <i class="fa-solid {{ meta.icon }}"></i>{{ meta.label }}
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Published #}
                <div class="mb-5">
                    <label class="form-label"><i class="fa-solid fa-toggle-on me-1 text-muted"></i>Visibilité</label>
                    <div class="publish-toggle">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="isPublished" id="publishToggle" value="1"
                                   {{ objective.isPublished ?? false ? 'checked' }}>
                        </div>
                        <div>
                            <div class="fw-600 small" id="publishLabel">{{ (objective.isPublished ?? false) ? 'Publié — visible aux utilisateurs' : 'Brouillon — non visible' }}</div>
                            <div class="text-muted" style="font-size:0.75rem">Les objectifs publiés apparaissent dans l'espace utilisateur.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn-submit">
                        <i class="fa-solid {{ mode == 'edit' ? 'fa-floppy-disk' : 'fa-plus' }} me-2"></i>
                        {{ mode == 'edit' ? 'Enregistrer' : 'Créer l\'objectif' }}
                    </button>
                    <a href="{{ path('app_admin_objective_index') }}" class="btn btn-light rounded-3 px-4">Annuler</a>
                </div>
            </form>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.getElementById('publishToggle').addEventListener('change', function() {
    document.getElementById('publishLabel').textContent = this.checked
        ? 'Publié — visible aux utilisateurs'
        : 'Brouillon — non visible';
});
</script>
{% endblock %}
