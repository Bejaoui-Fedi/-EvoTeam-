{% extends 'base.html.twig' %}

{% block title %}Evolia — Mon Espace{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    <style>
        /* NUCLEAR FULL WIDTH FIX */
        body.user-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
        }
    </style>
{% endblock %}

{% block body %}

<div class="user-scope">
{% include 'user_nav_bar/index.html.twig' %}

<div class="user-main-content">
    <div class="dashboard-welcome">
        <div class="d-flex align-items-center gap-4 mb-5">
            <div class="welcome-icon">
                <i class="fa-solid fa-sun fs-2 text-warning"></i>
            </div>
            <div>
                <h1 class="mb-1">Bonjour, {{ app.user.nom|default('Utilisateur') }} !</h1>
                <p class="text-muted m-0">Voici un aperçu de votre journée bien-être.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="card-icon"><i class="fa-solid fa-dumbbell"></i></div>
                    <h3>Exercices</h3>
                    <p class="stat">12 terminés</p>
                    <a href="#" class="view-link">Tout voir <i class="fa-solid fa-chevron-right"></i></a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="card-icon"><i class="fa-solid fa-calendar-check"></i></div>
                    <h3>Prochain RDV</h3>
                    <p class="stat">Demain à 14h</p>
                    {% if is_granted('ROLE_COACH') or is_granted('ROLE_PSYCHOLOGUE') %}
                        <a href="{{ path('app_pro_workspace') }}" class="view-link">Planning Pro <i class="fa-solid fa-chevron-right"></i></a>
                    {% else %}
                        <a href="{{ path('app_patient_workspace') }}" class="view-link">Planning <i class="fa-solid fa-chevron-right"></i></a>
                    {% endif %}
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="card-icon"><i class="fa-solid fa-feather"></i></div>
                    <h3>Journal</h3>
                    <p class="stat">3 notes cette semaine</p>
                    <a href="#" class="view-link">Écrire <i class="fa-solid fa-chevron-right"></i></a>
                </div>
            </div>
        </div>

        <div class="recent-activity mt-5">
            <h2 class="section-title mb-4">Activité Récente</h2>
            <div class="activity-list p-4 rounded-5 bg-white shadow-sm">
                <div class="activity-item d-flex align-items-center gap-3 py-3 border-bottom">
                    <div class="activity-icon bg-light p-2 rounded-circle"><i class="fa-solid fa-check text-success"></i></div>
                    <div>
                        <p class="m-0 fw-bold">Exercice de respiration terminé</p>
                        <small class="text-muted">Il y a 2 heures</small>
                    </div>
                </div>
                <div class="activity-item d-flex align-items-center gap-3 py-3">
                    <div class="activity-icon bg-light p-2 rounded-circle"><i class="fa-solid fa-calendar text-primary"></i></div>
                    <div>
                        <p class="m-0 fw-bold">Nouveau rendez-vous confirmé</p>
                        <small class="text-muted">Hier à 18:30</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
