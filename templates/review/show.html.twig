{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    {% if is_granted('ROLE_ADMIN') %}
        <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    {% else %}
        <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
        <style>
            body { display: block !important; padding: 0 !important; margin: 0 !important; width: 100vw !important; height: 100vh !important; overflow: hidden !important; background: #f1f5f9 !important; }
            .user-scope { display: flex !important; width: 100vw !important; height: 100vh !important; max-width: none !important; margin: 0 !important; padding: 0 !important; }
            .user-main-content { flex-grow: 1 !important; width: calc(100vw - 280px) !important; max-width: none !important; overflow-y: auto !important; padding: 20px; }
        </style>
    {% endif %}
{% endblock %}

{% block body %}
    {% if is_granted('ROLE_ADMIN') %}
    <div class="admin-scope">
        {% include 'admin_nav_bar/index.html.twig' %}
        <div class="admin-main-content p-4">
    {% else %}
    <div class="user-scope">
        {% include 'user_nav_bar/index.html.twig' %}
        <div class="user-main-content p-4">
    {% endif %}
    <h1>Détails de l'avis</h1>

    <table>
        <tbody>
            <tr>
                <th>Id:</th>
                <td>{{ review.id }}</td>
            </tr>
            <tr>
                <th>Titre:</th>
                <td>{{ review.title }}</td>
            </tr>
            <tr>
                <th>Note:</th>
                <td>{{ review.rating }}/5</td>
            </tr>
            <tr>
                <th>Commentaire:</th>
                <td>{{ review.comment }}</td>
            </tr>
            <tr>
                <th>Date de l'avis:</th>
                <td>{{ review.reviewDate ? review.reviewDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Evénement:</th>
                <td>{{ review.event.name }}</td>
            </tr>
            {% if is_granted('ROLE_ADMIN') %}
                <tr>
                    <th>Auteur:</th>
                    <td>{{ review.author ? review.author.nom : 'N/A' }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <br>
    <br>
    <a href="{{ is_granted('ROLE_ADMIN') ? path('app_review_index') : path('app_evenement_index') }}" class="btn btn-secondary">← Retour à la liste</a>
    <a href="{{ path('app_review_edit', {'id': review.id}) }}" class="btn btn-primary">Modifier</a>
    <form method="post" action="{{ path('app_review_delete', {id: review.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer cet avis ?')">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
        <button type="submit" class="btn btn-danger">Supprimer</button>
    </form>

    </div>
</div>
{% endblock %}