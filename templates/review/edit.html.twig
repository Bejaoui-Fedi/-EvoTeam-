{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    {% if is_granted('ROLE_ADMIN') %}
        <link rel="stylesheet" href="{{ asset('admin_dashboard.css') }}">
    {% else %}
        <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
        <style>
            body { display: block !important; padding: 0 !important; margin: 0 !important; width: 100vw !important; height: 100vh !important; overflow: hidden !important; background: #f1f5f9 !important; }
            .user-scope { display: flex !important; width: 100vw !important; height: 100vh !important; max-width: none !important; margin: 0 !important; padding: 0 !important; }
            .user-main-content { flex-grow: 1 !important; width: calc(100vw - 280px) !important; max-width: none !important; overflow-y: auto !important; padding: 20px; }
        </style>
    {% endif %}
{% endblock %}

{% block body %}
    {% if is_granted('ROLE_ADMIN') %}
    <div class="admin-scope">
        {% include 'admin_nav_bar/index.html.twig' %}
        <div class="admin-main-content p-4">
    {% else %}
    <div class="user-scope">
        {% include 'user_nav_bar/index.html.twig' %}
        <div class="user-main-content p-4">
    {% endif %}
    <h1>Modifier l'avis</h1>
    
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_errors(form) }}
        
        <div>
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {{ form_errors(form.title) }}
        </div>
        <div>
            {{ form_label(form.rating) }}
            {{ form_widget(form.rating) }}
            {{ form_errors(form.rating) }}
        </div>
        <div>
            {{ form_label(form.comment) }}
            {{ form_widget(form.comment) }}
            {{ form_errors(form.comment) }}
        </div>
        {% if form.event is defined %}
            <div>
                {{ form_label(form.event) }}
                {{ form_widget(form.event) }}
                {{ form_errors(form.event) }}
            </div>
        {% endif %}
        <div>
            {{ form_widget(form.save, { 'label': 'Enregistrer' }) }}
        </div>
    {{ form_end(form) }}
    
    <br>
    <br>
    <a href="{{ is_granted('ROLE_ADMIN') ? path('app_review_index') : path('app_evenement_index') }}" class="btn btn-secondary">← Retour</a>

    </div>
</div>
{% endblock %}