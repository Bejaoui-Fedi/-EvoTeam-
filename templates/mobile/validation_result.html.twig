<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Evolia - {{ (exercise is defined and exercise) ? exercise.title : 'Validation' }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #3A7D6B;
            --secondary: #1e4d6b;
            --success: #27AE60;
            --danger: #E74C3C;
            --bg: #F4FBF8;
            --card-bg: #FFFFFF;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg);
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            color: #2C3E50;
            padding: 20px 0;
        }
        /* Rest of the styles remained high quality but made more robust */
        .container { width: 92%; max-width: 500px; }
        .card { background: var(--card-bg); border-radius: 30px; padding: 25px; box-shadow: 0 15px 35px rgba(58, 125, 107, 0.12); border: 1px solid rgba(58, 125, 107, 0.05); }
        .tag { display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 15px; }
        .tag-diff { background: #E9F7EF; color: var(--success); }
        .tag-type { background: #EAF2FB; color: #2980B9; margin-left: 5px; }
        h1 { font-size: 24px; margin: 0 0 15px; font-weight: 800; color: var(--secondary); }
        .video-container { width: 100%; border-radius: 20px; overflow: hidden; background: #000; margin-bottom: 20px; aspect-ratio: 16/9; }
        .instructions { background: #F8FAFC; padding: 15px; border-radius: 20px; margin-bottom: 25px; border-left: 4px solid var(--primary); }
        .instructions h3 { font-size: 13px; text-transform: uppercase; color: #94A3B8; margin: 0 0 8px; }
        .instructions p { font-size: 14px; line-height: 1.5; margin: 0; color: #475569; }
        .btn-validate { width: 100%; background: linear-gradient(135deg, var(--primary), var(--secondary)); color: white; border: none; padding: 18px; border-radius: 20px; font-size: 18px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none; }
        .icon-circle { width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 40px; }
        .success .icon-circle { color: var(--success); background: #E8F8F0; }
        .error .icon-circle { color: var(--danger); background: #FDEDEC; }
        .stats { display: flex; justify-content: space-around; margin-top: 25px; padding-top: 20px; border-top: 1px dashed #E2E8F0; }
        .stat-item { text-align: center; }
        .stat-value { display: block; font-size: 20px; font-weight: 800; color: var(--primary); }
        .stat-label { font-size: 9px; color: #94A3B8; text-transform: uppercase; }
        .footer { margin-top: 25px; font-size: 11px; color: #94A3B8; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        
        {% if phase == 'preview' and exercise is defined and exercise %}
            <div class="card">
                <div>
                    <span class="tag tag-diff">{{ exercise.difficulty|default('Inconnu') }}</span>
                    <span class="tag tag-type">⚡ {{ exercise.type|default('Entraînement') }}</span>
                </div>
                <h1>{{ exercise.title }}</h1>
                
                <div class="video-container">
                    {% if exercise.mediaUrl %}
                        {% set videoId = exercise.mediaUrl|split('v=')|last|split('&')|first %}
                        <iframe width="100%" height="100%" src="https://www.youtube.com/embed/{{ videoId }}" frameborder="0" allowfullscreen></iframe>
                    {% else %}
                        <div style="height:100%; display:flex; align-items:center; justify-content:center; color:#fff; flex-direction:column; gap:10px; padding:20px; text-align:center;">
                            <i class="fa-solid fa-video-slash fs-1 opacity-50"></i>
                            <span class="small opacity-50">Aucun tutoriel vidéo</span>
                        </div>
                    {% endif %}
                </div>

                <div class="instructions">
                    <h3><i class="fa-solid fa-list-check me-2"></i>Instructions</h3>
                    <p>{{ exercise.description|default('Suivez les mouvements indiqués.') }}</p>
                </div>

                <form action="{{ path('app_mobile_confirm', {id: exercise.id}) }}" method="POST">
                    <input type="hidden" name="uid" value="{{ userId }}">
                    <input type="hidden" name="token" value="{{ token }}">
                    <button type="submit" class="btn-validate">
                        <i class="fa-solid fa-check-circle"></i> Valider ma séance
                    </button>
                </form>
            </div>

        {% elseif phase == 'success' %}
            <div class="card success text-center">
                <div class="icon-circle">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h1 style="color:var(--success)">Séance Terminée !</h1>
                <p>Votre progression a été enregistrée.</p>
                
                <div class="stats">
                    <div class="stat-item">
                        <span class="stat-value">+{{ xpGained|default(0) }}</span>
                        <span class="stat-label">EXP GAGNÉS</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">{{ newLevel|default('DEBUTANT') }}</span>
                        <span class="stat-label">NIVEAU</span>
                    </div>
                </div>
            </div>

        {% else %}
            <div class="card error text-center">
                <div class="icon-circle">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <h1 style="color:var(--danger)">Oups !</h1>
                <p>{{ message|default('Erreur de validation.') }}</p>
                <a href="javascript:location.reload()" class="btn-validate" style="background:var(--danger)">
                    RÉESSAYER
                </a>
            </div>
        {% endif %}

        <div class="footer">
            Evolia • Bien-être & Sérénité
        </div>
    </div>
</body>
</html>
