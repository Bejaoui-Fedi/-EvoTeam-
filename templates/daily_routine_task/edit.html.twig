{% extends 'base.html.twig' %}

{% set isAdminLayout = is_granted('ROLE_ADMIN') %}


{% block title %}Evolia — Modifier la tâche{% endblock %}

{% block body_class %}{{ isAdminLayout ? 'admin-theme' : 'user-theme' }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset(isAdminLayout ? 'admin_dashboard.css' : 'user_dashboard.css') }}">
    <style>
        body.user-theme, body.admin-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
            padding: 2rem !important;
        }
        
        .form-container {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            max-width: 700px;
            margin: 0 auto;
        }
        
        .form-label {
            font-weight: 600;
            color: #1e4d6b;
            margin-bottom: 0.5rem;
            display: block;
        }
        
        .form-control, .form-select {
            border-radius: 12px;
            padding: 0.75rem 1rem;
            border: 1px solid #dee2e6;
            width: 100%;
            transition: all 0.2s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #1e4d6b;
            box-shadow: 0 0 0 0.2rem rgba(30, 77, 107, 0.25);
            outline: none;
        }
        
        .btn-update {
            background: linear-gradient(135deg, #1e4d6b 0%, #2980b9 100%);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            transition: transform 0.2s;
        }
        
        .btn-update:hover {
            transform: translateY(-2px);
            color: white;
        }
        
        .btn-cancel {
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            transition: transform 0.2s;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }
        
        .btn-cancel:hover {
            transform: translateY(-2px);
            color: white;
        }
        
        .checkbox-wrapper {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }
        
        .checkbox-wrapper input {
            width: 20px;
            height: 20px;
        }
    </style>
{% endblock %}

{% block body %}

<div class="{{ isAdminLayout ? 'admin-scope' : 'user-scope' }}">
        {% if isAdminLayout %}
        {% include 'admin_nav_bar/index.html.twig' %}
    {% else %}
        {% include 'user_nav_bar/index.html.twig' %}
    {% endif %}

    <div class="{{ isAdminLayout ? 'admin-main-content' : 'user-main-content' }}">
        <div class="dashboard-welcome">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center gap-4">
                    <div class="welcome-icon">
                        <i class="fa-solid fa-pen-to-square fs-2 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="mb-1">Modifier la tâche</h1>
                        <p class="text-muted m-0">Mettez à jour votre routine quotidienne</p>
                    </div>
                </div>
                <a href="{{ path('app_daily_routine_task_index') }}" class="btn-cancel">
                    <i class="fa-solid fa-arrow-left"></i> Retour
                </a>
            </div>

            <div class="form-container">
                {{ form_start(form) }}
                
                {# Loop through all form fields automatically #}
                {% for child in form %}
                    {% if 'hidden' not in child.vars.block_prefixes %}
                        <div class="mb-4">
                            {{ form_label(child, null, {'label_attr': {'class': 'form-label'}}) }}
                            
                            {# Special styling for checkbox #}
                            {% if 'checkbox' in child.vars.block_prefixes %}
                                <div class="checkbox-wrapper">
                                    {{ form_widget(child, {'attr': {'style': 'width: 20px; height: 20px;'}}) }}
                                    <span style="margin-left: 0.5rem;">{{ form_label(child) }}</span>
                                </div>
                            {% else %}
                                {{ form_widget(child, {'attr': {'class': 'form-control' ~ (child.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {% endif %}
                            
                            {{ form_errors(child) }}
                            
                            {% if child.vars.name == 'completedAt' %}
                                <small class="text-muted">Laissez vide si la tâche n'est pas encore complétée</small>
                            {% endif %}
                        </div>
                    {% else %}
                        {{ form_widget(child) }}
                    {% endif %}
                {% endfor %}
                
                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                    <a href="{{ path('app_daily_routine_task_index') }}" class="btn-cancel">
                        <i class="fa-solid fa-times"></i> Annuler
                    </a>
                    <button type="submit" class="btn-update">
                        <i class="fa-solid fa-save"></i> Mettre à jour
                    </button>
                </div>
                
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const titleInput = document.querySelector('input[name$="[title]"]');
                if (titleInput) {
                    const title = titleInput.value.trim();
                    if (title.length < 3) {
                        e.preventDefault();
                        alert('Erreur de saisie: Le titre de la tâche doit contenir au moins 3 caractères.');
                        titleInput.focus();
                        titleInput.style.border = '2px solid #dc3545';
                        return false;
                    }
                }
                function runValidation() {} // marker
            });
        }
    });
</script>
{% endblock %}