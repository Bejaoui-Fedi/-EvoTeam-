{% extends 'base.html.twig' %}

{% block title %}Evolia — Mon Journal Bien-être{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <style>
        /* Copy all the same styles from index.html.twig */
        body.user-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
            padding: 2rem !important;
        }
        /* Add all other styles from index.html.twig here */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
        .stat-card { background: white; border-radius: 20px; padding: 1.5rem; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.05); transition: transform 0.2s; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
        .stat-card .stat-number { font-size: 2.5rem; font-weight: 700; color: #1e4d6b; }
        .journal-entries { display: flex; flex-direction: column; gap: 1.5rem; }
        .journal-card { background: white; border-radius: 20px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .journal-date { font-size: 1.1rem; font-weight: 600; color: #1e4d6b; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #e9ecef; }
        .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
        .metric { background: #f8f9fa; padding: 0.75rem; border-radius: 12px; text-align: center; }
        .metric-value { font-size: 1.25rem; font-weight: 600; color: #1e4d6b; }
        .progress { height: 4px; margin-top: 0.5rem; border-radius: 2px; }
        .journal-note { background: #fef9ec; padding: 1rem; border-radius: 12px; margin: 1rem 0; border-left: 4px solid #f59e0b; }
        .btn-create { background: linear-gradient(135deg, #1e4d6b 0%, #2980b9 100%); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 50px; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; }
        .btn-create:hover { transform: translateY(-2px); color: white; }
        .empty-state { text-align: center; padding: 3rem; background: white; border-radius: 20px; color: #6c757d; }
        .search-input-group { display: flex; gap: 0.5rem; max-width: 500px; margin: 0 auto; margin-bottom: 2rem; }
        .search-input { flex: 1; border-radius: 50px; border: 1px solid #dee2e6; padding: 0.75rem 1.5rem; }
        .search-btn { background: linear-gradient(135deg, #1e4d6b 0%, #2980b9 100%); color: white; border: none; border-radius: 50px; padding: 0.75rem 1.5rem; cursor: pointer; }
        .clear-btn { background: #6c757d; color: white; border: none; border-radius: 50px; padding: 0.75rem 1.5rem; text-decoration: none; }
    </style>
{% endblock %}

{% block body %}

<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}

    <div class="user-main-content">
        <div class="dashboard-welcome">
            <div class="d-flex align-items-center justify-content-between mb-5 flex-wrap gap-3">
                <div>
                    <h1 class="mb-1">Mon Journal Bien-être</h1>
                    <p class="text-muted m-0">Suivez votre humeur, stress, énergie et sommeil</p>
                </div>
                <a href="{{ path('app_wellbeing_tracker_new') }}" class="btn-create">
                    <i class="fa-solid fa-plus"></i> Nouvelle entrée
                </a>
            </div>

            <!-- Search -->
            <div class="search-section">
                <form method="get" action="{{ path('app_wellbeing_tracker_patient') }}" class="search-input-group">
                    <input type="text" name="search" class="search-input" placeholder="🔍 Rechercher par exercice..." value="{{ searchTerm|default('') }}">
                    <button type="submit" class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
                    {% if searchTerm is defined and searchTerm %}
                        <a href="{{ path('app_wellbeing_tracker_patient') }}" class="clear-btn"><i class="fa-solid fa-times"></i> Effacer</a>
                    {% endif %}
                </form>
            </div>

            <!-- Statistics -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">{{ wellbeing_trackers|length }}</div>
                    <div class="stat-label">Mes entrées</div>
                </div>
                {% if wellbeing_trackers|length > 0 %}
                    {% set avgMood = 0 %}{% set avgStress = 0 %}{% set avgSleep = 0 %}
                    {% for entry in wellbeing_trackers %}
                        {% set avgMood = avgMood + entry.mood %}
                        {% set avgStress = avgStress + entry.stress %}
                        {% set avgSleep = avgSleep + entry.sleepHours %}
                    {% endfor %}
                    {% set total = wellbeing_trackers|length %}
                    <div class="stat-card"><div class="stat-number">{{ (avgMood / total)|number_format(1) }}/5</div><div class="stat-label">Humeur moyenne</div></div>
                    <div class="stat-card"><div class="stat-number">{{ (avgStress / total)|number_format(1) }}/5</div><div class="stat-label">Stress moyen</div></div>
                    <div class="stat-card"><div class="stat-number">{{ (avgSleep / total)|number_format(1) }}h</div><div class="stat-label">Sommeil moyen</div></div>
                {% endif %}
            </div>

            <!-- Entries -->
            <div class="journal-entries">
                {% for entry in wellbeing_trackers %}
                    <div class="journal-card">
                        <div class="journal-date">{{ entry.date ? entry.date|date('l d F Y') : '' }}</div>
                        <div class="metrics-grid">
                            <div class="metric"><span class="metric-label">😊 Humeur</span><div class="metric-value">{{ entry.mood }}/5</div><div class="progress"><div class="progress-bar bg-success" style="width: {{ (entry.mood / 5) * 100 }}%"></div></div></div>
                            <div class="metric"><span class="metric-label">😰 Stress</span><div class="metric-value">{{ entry.stress }}/5</div><div class="progress"><div class="progress-bar bg-warning" style="width: {{ (entry.stress / 5) * 100 }}%"></div></div></div>
                            <div class="metric"><span class="metric-label">⚡ Énergie</span><div class="metric-value">{{ entry.energy }}/5</div><div class="progress"><div class="progress-bar bg-info" style="width: {{ (entry.energy / 5) * 100 }}%"></div></div></div>
                            <div class="metric"><span class="metric-label">😴 Sommeil</span><div class="metric-value">{{ entry.sleepHours }}h</div></div>
                        </div>
                        {% if entry.note %}<div class="journal-note"><p class="mb-0">{{ entry.note }}</p></div>{% endif %}
                        <div class="mt-2"><a href="{{ path('app_wellbeing_tracker_show', {'id': entry.id}) }}" class="btn btn-sm btn-outline-primary">Voir détails</a></div>
                    </div>
                {% else %}
                    <div class="empty-state"><i class="fa-solid fa-book-open"></i><h4>Aucune entrée</h4><a href="{{ path('app_wellbeing_tracker_new') }}" class="btn-create mt-3">Créer ma première entrée</a></div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}