{% extends 'base.html.twig' %}

{% set isAdminLayout = is_granted('ROLE_ADMIN') %}


{% block title %}Evolia — Nouvelle entrée{% endblock %}

{% block body_class %}{{ isAdminLayout ? 'admin-theme' : 'user-theme' }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset(isAdminLayout ? 'admin_dashboard.css' : 'user_dashboard.css') }}">
    <style>
        body.user-theme, body.admin-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
            padding: 2rem !important;
        }
        
        .form-container {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            max-width: 800px;
            margin: 0 auto;
        }
        
        .form-label {
            font-weight: 600;
            color: #1e4d6b;
            margin-bottom: 0.5rem;
            display: block;
        }
        
        .form-control, .form-select {
            border-radius: 12px;
            padding: 0.75rem 1rem;
            border: 1px solid #dee2e6;
            width: 100%;
            transition: all 0.2s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #1e4d6b;
            box-shadow: 0 0 0 0.2rem rgba(30, 77, 107, 0.25);
            outline: none;
        }
        
        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }
        
        .btn-submit {
            background: linear-gradient(135deg, #1e4d6b 0%, #2980b9 100%);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 500;
            transition: transform 0.2s;
        }
        
        .btn-submit:hover {
            transform: translateY(-2px);
            color: white;
        }
        
        .btn-cancel {
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 500;
            transition: transform 0.2s;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-cancel:hover {
            transform: translateY(-2px);
            color: white;
        }
        
        .metric-preview {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
        }
        
        .metric-preview .metric-value {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1e4d6b;
        }
        
        .progress {
            height: 6px;
            border-radius: 3px;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .stat-card .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #1e4d6b;
        }
        
        .stat-card .stat-label {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6c757d;
        }
        
        @media (max-width: 768px) {
            .user-main-content {
                padding: 1rem !important;
            }
        }

        /* ── Server-side Symfony form_errors() → red ── */
        /* Symfony renders: <ul><li>message</li></ul> with no classes */
        .form-group ul,
        .form-group > ul,
        div > ul {
            list-style: none;
            padding: 0;
            margin: 0.4rem 0 0 0;
        }
        .form-group ul li,
        .form-group > ul > li,
        div > ul > li {
            color: #dc3545 !important;
            font-size: 0.875rem;
            font-weight: 500;
            display: flex;
            align-items: flex-start;
            gap: 0.3rem;
        }
        .form-group ul li::before,
        div > ul > li::before {
            content: '\26A0\FE0F';
            flex-shrink: 0;
        }

        /* ── Choices.js custom styling ── */
        .choices__inner {
            border-radius: 12px !important;
            border: 1px solid #dee2e6 !important;
            padding: 0.5rem 1rem !important;
            font-size: 0.95rem;
            background: white !important;
            min-height: 48px;
            display: flex;
            align-items: center;
        }
        .choices__list--dropdown {
            border-radius: 12px !important;
            border: 1px solid #dee2e6 !important;
            box-shadow: 0 4px 16px rgba(0,0,0,0.12) !important;
            z-index: 9999;
        }
        .choices__list--dropdown .choices__item--selectable.is-highlighted {
            background-color: #1e4d6b !important;
        }
        .choices__input {
            background: transparent !important;
            font-size: 0.95rem;
        }
        .is-open .choices__inner {
            border-color: #1e4d6b !important;
            box-shadow: 0 0 0 0.2rem rgba(30,77,107,0.2) !important;
        }
        .choices[data-type*="select-one"] .choices__button {
            opacity: 0.6;
        }
        .choices__placeholder {
            color: #adb5bd !important;
            opacity: 1 !important;
        }
    </style>
{% endblock %}

{% block body %}

<div class="{{ isAdminLayout ? 'admin-scope' : 'user-scope' }}">
        {% if isAdminLayout %}
        {% include 'admin_nav_bar/index.html.twig' %}
    {% else %}
        {% include 'user_nav_bar/index.html.twig' %}
    {% endif %}

    <div class="{{ isAdminLayout ? 'admin-main-content' : 'user-main-content' }}">
        <div class="dashboard-welcome">
            <div class="d-flex align-items-center justify-content-between mb-5 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-4">
                    <div class="welcome-icon">
                        <i class="fa-solid fa-plus-circle fs-2 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="mb-1">Nouvelle entrée</h1>
                        <p class="text-muted m-0">Enregistrez votre état du jour</p>
                    </div>
                </div>
                <div class="header-buttons">
                    <a href="{{ path('app_wellbeing_tracker_index') }}" class="btn-cancel">
                        <i class="fa-solid fa-arrow-left"></i> Retour au journal
                    </a>
                </div>
            </div>

            <!-- Quick Stats Preview -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">
                        <i class="fa-regular fa-calendar text-primary"></i>
                    </div>
                    <div class="stat-label">Aujourd'hui</div>
                    <div class="stat-sub">{{ 'now'|date('l d F Y') }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">
                        <i class="fa-solid fa-heart text-danger"></i>
                    </div>
                    <div class="stat-label">Bien-être</div>
                    <div class="stat-sub">Suivez votre évolution</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">
                        <i class="fa-solid fa-chart-line text-success"></i>
                    </div>
                    <div class="stat-label">Objectif</div>
                    <div class="stat-sub">Une entrée par jour</div>
                </div>
            </div>

            <!-- Form -->
            <div class="form-container">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'wellbeing-form'}}) }}
                
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="fa-regular fa-calendar me-2"></i> Date
                        </label>
                        {{ form_widget(form.date, {'attr': {'class': 'form-control', 'id': 'date_input'}}) }}
                        {{ form_errors(form.date) }}
                        <div class="invalid-feedback" id="date_error" style="display:none;"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="fa-solid fa-bed me-2"></i> Heures de sommeil
                        </label>
                        {{ form_widget(form.sleepHours, {'attr': {'class': 'form-control', 'step': '0.5', 'min': '0', 'max': '24', 'id': 'sleep_input'}}) }}
                        {{ form_errors(form.sleepHours) }}
                        <div class="invalid-feedback" id="sleep_error" style="display:none;"></div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="fa-regular fa-face-smile me-2"></i> Humeur (1-5)
                        </label>
                        {{ form_widget(form.mood, {'attr': {'class': 'form-select', 'id': 'mood_select'}}) }}
                        {{ form_errors(form.mood) }}
                        <div class="invalid-feedback" id="mood_error" style="display:none;"></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="fa-solid fa-waveform me-2"></i> Stress (1-5)
                        </label>
                        {{ form_widget(form.stress, {'attr': {'class': 'form-select', 'id': 'stress_select'}}) }}
                        {{ form_errors(form.stress) }}
                        <div class="invalid-feedback" id="stress_error" style="display:none;"></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="fa-solid fa-bolt me-2"></i> Énergie (1-5)
                        </label>
                        {{ form_widget(form.energy, {'attr': {'class': 'form-select', 'id': 'energy_select'}}) }}
                        {{ form_errors(form.energy) }}
                        <div class="invalid-feedback" id="energy_error" style="display:none;"></div>
                    </div>
                </div>

                <!-- Live Preview -->
                <div class="metric-preview">
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <small class="text-muted">Aperçu Humeur</small>
                            <div class="metric-value" id="mood_preview">3/5</div>
                            <div class="progress">
                                <div class="progress-bar bg-success" id="mood_bar" style="width: 60%"></div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <small class="text-muted">Aperçu Stress</small>
                            <div class="metric-value" id="stress_preview">3/5</div>
                            <div class="progress">
                                <div class="progress-bar bg-warning" id="stress_bar" style="width: 60%"></div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <small class="text-muted">Aperçu Énergie</small>
                            <div class="metric-value" id="energy_preview">3/5</div>
                            <div class="progress">
                                <div class="progress-bar bg-info" id="energy_bar" style="width: 60%"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">
                        <i class="fa-solid fa-pen me-2"></i> Notes personnelles
                    </label>
                    {{ form_widget(form.note, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Comment vous êtes-vous senti aujourd\'hui ? Partagez vos pensées, ressentis ou observations de la journée.'}}) }}
                    {{ form_errors(form.note) }}
                    <small class="text-muted">
                        <i class="fa-regular fa-lightbulb me-1"></i> 
                        Une note personnelle vous aidera à mieux comprendre votre évolution.
                    </small>
                </div>

                {# User + Routine Task — searchable selects, placed above buttons #}
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="fa-solid fa-user me-2"></i> Utilisateur
                        </label>
                        {{ form_widget(form.user, {'attr': {'class': 'form-select select2-user', 'id': 'user_select'}}) }}
                        {{ form_errors(form.user) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="fa-solid fa-dumbbell me-2"></i> Tâche de routine liée
                        </label>
                        {{ form_widget(form.routineTask, {'attr': {'class': 'form-select select2-routine', 'id': 'routine_select'}}) }}
                        {{ form_errors(form.routineTask) }}
                    </div>
                </div>

                {# Hidden fields #}
                {% for child in form %}
                    {% if 'hidden' in child.vars.block_prefixes %}
                        {{ form_widget(child) }}
                    {% endif %}
                {% endfor %}

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                    <a href="{{ path('app_wellbeing_tracker_index') }}" class="btn-cancel">
                        <i class="fa-solid fa-times"></i> Annuler
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fa-solid fa-save"></i> Enregistrer mon entrée
                    </button>
                </div>
                
                {{ form_end(form, {'render_rest': false}) }}
            </div>
        </div>
    </div>
</div>

<script>
    function updatePreview() {
        const mood = document.getElementById('mood_select')?.value || 3;
        const stress = document.getElementById('stress_select')?.value || 3;
        const energy = document.getElementById('energy_select')?.value || 3;
        
        document.getElementById('mood_preview').innerText = mood + '/5';
        document.getElementById('stress_preview').innerText = stress + '/5';
        document.getElementById('energy_preview').innerText = energy + '/5';
        
        document.getElementById('mood_bar').style.width = (mood / 5) * 100 + '%';
        document.getElementById('stress_bar').style.width = (stress / 5) * 100 + '%';
        document.getElementById('energy_bar').style.width = (energy / 5) * 100 + '%';
    }
    
    const moodSelect = document.getElementById('mood_select');
    const stressSelect = document.getElementById('stress_select');
    const energySelect = document.getElementById('energy_select');
    
    if (moodSelect) moodSelect.addEventListener('change', updatePreview);
    if (stressSelect) stressSelect.addEventListener('change', updatePreview);
    if (energySelect) energySelect.addEventListener('change', updatePreview);
    
    updatePreview();
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const userEl = document.getElementById('user_select');
    if (userEl) {
        new Choices(userEl, {
            searchEnabled: true,
            searchPlaceholderValue: 'Tapez pour rechercher...',
            itemSelectText: '',
            noResultsText: 'Aucun résultat trouvé',
            noChoicesText: 'Aucun utilisateur disponible',
            placeholder: true,
            placeholderValue: 'Sélectionner un utilisateur...',
            shouldSort: true,
            searchFields: ['label']
        });
    }
    const routineEl = document.getElementById('routine_select');
    if (routineEl) {
        new Choices(routineEl, {
            searchEnabled: true,
            searchPlaceholderValue: 'Tapez pour rechercher...',
            itemSelectText: '',
            noResultsText: 'Aucun résultat trouvé',
            noChoicesText: 'Aucune tâche disponible',
            placeholder: true,
            placeholderValue: 'Aucune tâche liée (optionnel)',
            shouldSort: true,
            searchFields: ['label']
        });
    }
});
</script>
<style>
    .form-control.is-invalid,
    .form-select.is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
    .invalid-feedback {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.35rem;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }
    .invalid-feedback::before {
        content: '⚠';
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('wellbeing-form');
        if (!form) return;

        function setError(inputEl, errorEl, message) {
            if (!inputEl || !errorEl) return;
            inputEl.classList.add('is-invalid');
            inputEl.classList.remove('is-valid');
            errorEl.textContent = message;
            errorEl.style.display = 'flex';
        }

        function clearError(inputEl, errorEl) {
            if (!inputEl || !errorEl) return;
            inputEl.classList.remove('is-invalid');
            inputEl.classList.add('is-valid');
            errorEl.style.display = 'none';
        }

        function validateAll() {
            let isValid = true;

            const dateInput = document.getElementById('date_input');
            const dateError = document.getElementById('date_error');
            if (dateInput && !dateInput.value) {
                setError(dateInput, dateError, 'La date est obligatoire.');
                isValid = false;
            } else if (dateInput) {
                clearError(dateInput, dateError);
            }

            const sleepInput = document.getElementById('sleep_input');
            const sleepError = document.getElementById('sleep_error');
            if (sleepInput) {
                const sleep = parseFloat(sleepInput.value);
                if (sleepInput.value === '' || isNaN(sleep)) {
                    setError(sleepInput, sleepError, 'Le nombre d\'heures de sommeil est obligatoire.');
                    isValid = false;
                } else if (sleep < 0 || sleep > 24) {
                    setError(sleepInput, sleepError, 'Les heures de sommeil doivent être entre 0 et 24.');
                    isValid = false;
                } else {
                    clearError(sleepInput, sleepError);
                }
            }

            const moodInput = document.getElementById('mood_select');
            const moodError = document.getElementById('mood_error');
            if (moodInput) {
                const mood = parseInt(moodInput.value);
                if (!moodInput.value || isNaN(mood)) {
                    setError(moodInput, moodError, 'Veuillez sélectionner un niveau d\'humeur.');
                    isValid = false;
                } else {
                    clearError(moodInput, moodError);
                }
            }

            const stressInput = document.getElementById('stress_select');
            const stressError = document.getElementById('stress_error');
            if (stressInput) {
                const stress = parseInt(stressInput.value);
                if (!stressInput.value || isNaN(stress)) {
                    setError(stressInput, stressError, 'Veuillez sélectionner un niveau de stress.');
                    isValid = false;
                } else {
                    clearError(stressInput, stressError);
                }
            }

            const energyInput = document.getElementById('energy_select');
            const energyError = document.getElementById('energy_error');
            if (energyInput) {
                const energy = parseInt(energyInput.value);
                if (!energyInput.value || isNaN(energy)) {
                    setError(energyInput, energyError, 'Veuillez sélectionner un niveau d\'énergie.');
                    isValid = false;
                } else {
                    clearError(energyInput, energyError);
                }
            }

            return isValid;
        }

        form.addEventListener('submit', function(e) {
            if (!validateAll()) {
                e.preventDefault();
                // Scroll to first error
                const firstError = form.querySelector('.is-invalid');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstError.focus();
                }
            }
        });

        // Live clear on change
        form.querySelectorAll('input, select, textarea').forEach(function(el) {
            el.addEventListener('input', validateAll);
            el.addEventListener('change', validateAll);
        });
    });
</script>
{% endblock %}