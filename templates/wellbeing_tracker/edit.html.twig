{% extends 'base.html.twig' %}

{% set isAdminLayout = is_granted('ROLE_ADMIN') %}


{% block title %}Evolia — Modifier l'entrée{% endblock %}

{% block body_class %}{{ isAdminLayout ? 'admin-theme' : 'user-theme' }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset(isAdminLayout ? 'admin_dashboard.css' : 'user_dashboard.css') }}">
    <style>
        body.user-theme, body.admin-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
            padding: 2rem !important;
        }
        
        .edit-form-container {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            max-width: 800px;
            margin: 0 auto;
        }
        
        .form-label {
            font-weight: 600;
            color: #1e4d6b;
            margin-bottom: 0.5rem;
            display: block;
        }
        
        .form-control, .form-select {
            border-radius: 12px;
            padding: 0.75rem 1rem;
            border: 1px solid #dee2e6;
            width: 100%;
            transition: all 0.2s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #1e4d6b;
            box-shadow: 0 0 0 0.2rem rgba(30, 77, 107, 0.25);
            outline: none;
        }
        
        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }
        
        .btn-update {
            background: linear-gradient(135deg, #1e4d6b 0%, #2980b9 100%);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 500;
            transition: transform 0.2s;
        }
        
        .btn-update:hover {
            transform: translateY(-2px);
            color: white;
        }
        
        .btn-cancel {
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 500;
            transition: transform 0.2s;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-cancel:hover {
            transform: translateY(-2px);
            color: white;
        }
        
        .btn-danger {
            background: #dc3545;
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 500;
            transition: transform 0.2s;
        }
        
        .btn-danger:hover {
            transform: translateY(-2px);
            background: #c82333;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .stat-card .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #1e4d6b;
        }
        
        .stat-card .stat-label {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6c757d;
        }
        
        .metric-preview {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 1rem;
        }
        
        .metric-preview .metric-value {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1e4d6b;
        }
        
        .progress {
            height: 6px;
            border-radius: 3px;
        }
        
        .associated-task {
            background: #e8f4f8;
            padding: 1rem;
            border-radius: 12px;
            margin-top: 1rem;
            margin-bottom: 1rem;
            border-left: 4px solid #1e4d6b;
        }
    </style>
{% endblock %}

{% block body %}

<div class="{{ isAdminLayout ? 'admin-scope' : 'user-scope' }}">
        {% if isAdminLayout %}
        {% include 'admin_nav_bar/index.html.twig' %}
    {% else %}
        {% include 'user_nav_bar/index.html.twig' %}
    {% endif %}

    <div class="{{ isAdminLayout ? 'admin-main-content' : 'user-main-content' }}">
        <div class="dashboard-welcome">
            <div class="d-flex align-items-center justify-content-between mb-5">
                <div class="d-flex align-items-center gap-4">
                    <div class="welcome-icon">
                        <i class="fa-solid fa-pen-to-square fs-2 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="mb-1">Modifier l'entrée</h1>
                        <p class="text-muted m-0">Mettez à jour votre suivi bien-être</p>
                    </div>
                </div>
                <a href="{{ path('app_wellbeing_tracker_index') }}" class="btn-cancel">
                    <i class="fa-solid fa-arrow-left"></i> Retour
                </a>
            </div>

            <!-- Current values summary -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">{{ wellbeing_tracker.date ? wellbeing_tracker.date|date('d/m/Y') : '' }}</div>
                    <div class="stat-label">Date</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ wellbeing_tracker.mood }}/5</div>
                    <div class="stat-label">Humeur</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ wellbeing_tracker.stress }}/5</div>
                    <div class="stat-label">Stress</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ wellbeing_tracker.energy }}/5</div>
                    <div class="stat-label">Énergie</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ wellbeing_tracker.sleepHours }}h</div>
                    <div class="stat-label">Sommeil</div>
                </div>
            </div>

            <div class="edit-form-container">
                {{ form_start(form) }}
                
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="fa-regular fa-calendar me-2"></i> Date
                        </label>
                        {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.date) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="fa-solid fa-bed me-2"></i> Heures de sommeil
                        </label>
                        {{ form_widget(form.sleepHours, {'attr': {'class': 'form-control', 'step': '0.5', 'min': '0', 'max': '24'}}) }}
                        {{ form_errors(form.sleepHours) }}
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="fa-regular fa-face-smile me-2"></i> Humeur (1-5)
                        </label>
                        {{ form_widget(form.mood, {'attr': {'class': 'form-select', 'id': 'edit_mood'}}) }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="fa-solid fa-waveform me-2"></i> Stress (1-5)
                        </label>
                        {{ form_widget(form.stress, {'attr': {'class': 'form-select', 'id': 'edit_stress'}}) }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="fa-solid fa-bolt me-2"></i> Énergie (1-5)
                        </label>
                        {{ form_widget(form.energy, {'attr': {'class': 'form-select', 'id': 'edit_energy'}}) }}
                    </div>
                </div>

                <div class="metric-preview">
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <small class="text-muted">Humeur</small>
                            <div class="metric-value" id="preview_mood">{{ wellbeing_tracker.mood }}/5</div>
                            <div class="progress"><div class="progress-bar bg-success" id="bar_mood" style="width: {{ (wellbeing_tracker.mood / 5) * 100 }}%"></div></div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <small class="text-muted">Stress</small>
                            <div class="metric-value" id="preview_stress">{{ wellbeing_tracker.stress }}/5</div>
                            <div class="progress"><div class="progress-bar bg-warning" id="bar_stress" style="width: {{ (wellbeing_tracker.stress / 5) * 100 }}%"></div></div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <small class="text-muted">Énergie</small>
                            <div class="metric-value" id="preview_energy">{{ wellbeing_tracker.energy }}/5</div>
                            <div class="progress"><div class="progress-bar bg-info" id="bar_energy" style="width: {{ (wellbeing_tracker.energy / 5) * 100 }}%"></div></div>
                        </div>
                    </div>
                </div>

                {% if wellbeing_tracker.routineTask %}
                    <div class="associated-task">
                        <small class="text-muted d-block mb-1">
                            <i class="fa-solid fa-dumbbell me-1"></i> Exercice associé
                        </small>
                        <p class="mb-0 fw-bold text-dark">{{ wellbeing_tracker.routineTask.title }}</p>
                    </div>
                {% endif %}

                <div class="mb-4">
                    <label class="form-label">
                        <i class="fa-solid fa-pen me-2"></i> Notes personnelles
                    </label>
                    {{ form_widget(form.note, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Comment vous êtes-vous senti aujourd\'hui ?'}}) }}
                </div>

                {% for child in form %}
                    {% if 'hidden' in child.vars.block_prefixes %}
                        {{ form_widget(child) }}
                    {% endif %}
                {% endfor %}

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                    <a href="{{ path('app_wellbeing_tracker_index') }}" class="btn-cancel">
                        <i class="fa-solid fa-times"></i> Annuler
                    </a>
                    <form method="post" action="{{ path('app_wellbeing_tracker_delete', {'id': wellbeing_tracker.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette entrée ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ wellbeing_tracker.id) }}">
                        <button type="submit" class="btn-danger">
                            <i class="fa-solid fa-trash"></i> Supprimer
                        </button>
                    </form>
                    <button type="submit" class="btn-update">
                        <i class="fa-solid fa-save"></i> Mettre à jour
                    </button>
                </div>
                
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<script>
    const moodEl = document.getElementById('edit_mood');
    const stressEl = document.getElementById('edit_stress');
    const energyEl = document.getElementById('edit_energy');
    
    function updateEditPreview() {
        const mood = moodEl?.value || 3;
        const stress = stressEl?.value || 3;
        const energy = energyEl?.value || 3;
        
        document.getElementById('preview_mood').innerText = mood + '/5';
        document.getElementById('preview_stress').innerText = stress + '/5';
        document.getElementById('preview_energy').innerText = energy + '/5';
        
        document.getElementById('bar_mood').style.width = (mood / 5) * 100 + '%';
        document.getElementById('bar_stress').style.width = (stress / 5) * 100 + '%';
        document.getElementById('bar_energy').style.width = (energy / 5) * 100 + '%';
    }
    
    if (moodEl) moodEl.addEventListener('change', updateEditPreview);
    if (stressEl) stressEl.addEventListener('change', updateEditPreview);
    if (energyEl) energyEl.addEventListener('change', updateEditPreview);
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const moodInput = document.querySelector('select[name$="[mood]"]') || document.querySelector('input[name$="[mood]"]');
                const stressInput = document.querySelector('select[name$="[stress]"]') || document.querySelector('input[name$="[stress]"]');
                const energyInput = document.querySelector('select[name$="[energy]"]') || document.querySelector('input[name$="[energy]"]');
                const sleepInput = document.querySelector('input[name$="[sleepHours]"]');

                if (moodInput) {
                    const mood = parseInt(moodInput.value);
                    if (isNaN(mood) || mood < 1 || mood > 5) {
                        e.preventDefault();
                        alert('Erreur de saisie: L\'humeur doit être un nombre entre 1 et 5.');
                        return false;
                    }
                }
                if (stressInput) {
                    const stress = parseInt(stressInput.value);
                    if (isNaN(stress) || stress < 1 || stress > 5) {
                        e.preventDefault();
                        alert('Erreur de saisie: Le niveau de stress doit être un nombre entre 1 et 5.');
                        return false;
                    }
                }
                if (energyInput) {
                    const energy = parseInt(energyInput.value);
                    if (isNaN(energy) || energy < 1 || energy > 5) {
                        e.preventDefault();
                        alert('Erreur de saisie: Le niveau d\'énergie doit être un nombre entre 1 et 5.');
                        return false;
                    }
                }
                if (sleepInput) {
                    const sleep = parseFloat(sleepInput.value);
                    if (isNaN(sleep) || sleep < 0 || sleep > 24) {
                        e.preventDefault();
                        alert('Erreur de saisie: Les heures de sommeil doivent être comprises entre 0 et 24.');
                        return false;
                    }
                }
                function runValidation() {} // marker
            });
        }
    });
</script>
{% endblock %}