{% extends 'admin_base.html.twig' %}

{% block title %}Gestion du Bien-être{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-header">
        <h1>Journal de Bien-être</h1>
        <a href="{{ path('app_wellbeing_tracker_new') }}" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Nouvelle entrée
        </a>
    </div>

    <div class="admin-filters mb-4">
        <form method="get" class="search-form">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Rechercher par utilisateur ou exercice..." value="{{ searchTerm }}">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="fa-solid fa-search"></i> Rechercher
                </button>
                {% if searchTerm %}
                    <a href="{{ path('app_wellbeing_tracker_index') }}" class="btn btn-outline-danger">Effacer</a>
                {% endif %}
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Utilisateur</th>
                    <th>Date</th>
                    <th>Exercice</th>
                    <th>Niveau d'énergie</th>
                    <th>Humeur</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for tracker in wellbeing_trackers %}
                    <tr>
                        <td>{{ tracker.user.nom }} {{ tracker.user.prenom }}</td>
                        <td>{{ tracker.date|date('d/m/Y') }}</td>
                        <td>{{ tracker.routineTask.title|default('N/A') }}</td>
                        <td>
                            <div class="energy-level">
                                <span class="energy-value">{{ tracker.energyLevel }}/10</span>
                                <div class="progress">
                                    <div class="progress-bar" style="width: {{ tracker.energyLevel * 10 }}%"></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="mood-badge mood-{{ tracker.mood|lower }}">
                                {{ tracker.mood }}
                            </span>
                        </td>
                        <td class="actions">
                            <a href="{{ path('app_wellbeing_tracker_show', {'id': tracker.id}) }}" class="btn btn-sm btn-info">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a href="{{ path('app_wellbeing_tracker_edit', {'id': tracker.id}) }}" class="btn btn-sm btn-warning">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_wellbeing_tracker_delete', {'id': tracker.id}) }}" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tracker.id) }}">
                                <button class="btn btn-sm btn-danger" onclick="return confirm('Supprimer cette entrée ?')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucune entrée trouvée</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}