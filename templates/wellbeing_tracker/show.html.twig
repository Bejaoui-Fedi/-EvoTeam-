{% extends 'base.html.twig' %}

{% block title %}Wellbeing Details{% endblock %}

{% block body %}
    <h1 class="title">Wellbeing <span>Details</span></h1>
    <div class="hero-divider"></div>
    <p class="subtitle" style="text-align: center; margin-bottom: 30px;">Entry recorded on {{ wellbeing_tracker.date ? wellbeing_tracker.date|date('Y-m-d') : '' }}</p>

    <div class="card user" style="width: 100%; max-width: 600px; margin: 0 auto 2rem; padding: 30px;">
        <table class="table">
            <tbody>
                <tr>
                    <th style="width: 30%;">Id</th>
                    <td>{{ wellbeing_tracker.id }}</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>{{ wellbeing_tracker.date ? wellbeing_tracker.date|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>User</th>
                    <td>{{ wellbeing_tracker.user ? wellbeing_tracker.user.nom : 'Unknown' }}</td>
                </tr>
                <tr>
                    <th>Routine Task</th>
                    <td>{{ wellbeing_tracker.routineTask ? wellbeing_tracker.routineTask.title : 'None' }}</td>
                </tr>
                <tr>
                    <th>Mood</th>
                    <td>{{ wellbeing_tracker.mood }}/5</td>
                </tr>
                <tr>
                    <th>Stress</th>
                    <td>{{ wellbeing_tracker.stress }}/5</td>
                </tr>
                <tr>
                    <th>Energy</th>
                    <td>{{ wellbeing_tracker.energy }}/5</td>
                </tr>
                <tr>
                    <th>Sleep Hours</th>
                    <td>{{ wellbeing_tracker.sleepHours }} h</td>
                </tr>
                <tr>
                    <th>Note</th>
                    <td>{{ wellbeing_tracker.note }}</td>
                </tr>
                <tr>
                    <th>Created At</th>
                    <td>{{ wellbeing_tracker.createdAt ? wellbeing_tracker.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <div style="display: flex; gap: 15px; margin-top: 25px; width: 100%;">
            <a href="{{ path('app_wellbeing_tracker_edit', {'id': wellbeing_tracker.id}) }}" class="btn btn-personal" style="flex: 1;"><i class="fa fa-edit"></i> Edit</a>
            <a href="{{ path('app_wellbeing_tracker_index') }}" class="btn btn-admin" style="flex: 1;"><i class="fa fa-arrow-left"></i> Back to list</a>
        </div>

        <div style="margin-top: 20px; text-align: center;">
            <form method="post" action="{{ path('app_wellbeing_tracker_delete', {'id': wellbeing_tracker.id}) }}" onsubmit="return confirm('Are you sure you want to delete this specific log?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ wellbeing_tracker.id) }}">
                <button class="btn" style="background: rgba(255,100,100,0.2); color: #ff8888; border: 1px solid rgba(255,100,100,0.5);"><i class="fa fa-trash"></i> Delete Log</button>
            </form>
        </div>
    </div>
{% endblock %}
