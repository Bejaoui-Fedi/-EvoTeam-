{% extends 'base.html.twig' %}

{% block title %}Mon Planning Santé — Evolia Elite{% endblock %}

{% block body_class %}user-theme{% endblock %}
{% block main_class %}user-main-content{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('elite_theme.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <style>
        /* SCROLL FIX */
        body.user-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
            padding: 40px !important;
            background: #f1f5f9 !important;
        }
        .patient-workspace-card {
            background: white;
            border-radius: 36px;
            padding: 40px;
            box-shadow: 0 40px 100px rgba(0,0,0,0.04);
            border: 1px solid var(--elite-border);
            min-height: 70vh;
        }
        
        .rdv-elite-item {
            background: #ffffff;
            border: 1px solid var(--elite-border);
            border-radius: 28px;
            padding: 28px;
            margin-bottom: 24px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .rdv-elite-item:hover {
            transform: scale(1.02) translateY(-5px);
            box-shadow: 0 25px 50px rgba(0,0,0,0.1);
            border-color: var(--elite-accent);
        }
        
        .date-box-elite {
            min-width: 95px;
            padding: 18px;
            background: linear-gradient(135deg, white 0%, #f8fafc 100%);
            border-radius: 22px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.03);
            text-align: center;
            border: 1px solid var(--elite-border);
        }
        .date-box-elite .month {
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            color: var(--elite-accent);
            letter-spacing: 0.1em;
        }
        .date-box-elite .day {
            font-size: 2rem;
            font-weight: 900;
            color: var(--elite-navy);
            line-height: 1;
            margin: 8px 0;
        }
        
        .status-pill-elite {
            padding: 10px 22px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .status-confirme { background: #dcfce7; color: #166534; }
        .status-attente { background: #fee2e2; color: #991b1b; }
        .status-annule { background: #f1f5f9; color: #475569; }
        
        .rdv-info-group h5 {
            font-weight: 900;
            color: var(--elite-navy);
            margin-bottom: 8px;
            font-size: 1.25rem;
            letter-spacing: -0.5px;
        }
        .rdv-info-group p {
            color: var(--elite-text);
            font-weight: 500;
            margin-bottom: 0;
            opacity: 0.7;
        }
        
        .action-circle-btn {
            width: 50px;
            height: 50px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            text-decoration: none;
            border: none;
            font-size: 1.1rem;
        }
        .btn-edit { background: #f0f9ff; color: #0369a1; }
        .btn-edit:hover { background: #0369a1; color: white; transform: rotate(15deg); }
        .btn-delete { background: #fff1f2; color: #be123c; }
        .btn-delete:hover { background: #be123c; color: white; transform: rotate(-15deg); }
    </style>
{% endblock %}

{% block body %}
<div class="user-scope">
{% include 'user_nav_bar/index.html.twig' %}
<div class="user-main-content">
    <div class="header-title mb-5 d-flex justify-content-between align-items-end">
        <div>
            <p class="text-uppercase letter-spacing-2 fw-bold opacity-50" style="font-size: 0.8rem; color: var(--elite-accent);">Plateforme Bien-être • Client</p>
            <h1 class="fw-bold" style="color: var(--elite-navy); font-size: 3.2rem; letter-spacing: -1.5px;">Mon Planning Santé</h1>
            <div class="hero-divider" style="margin: 15px 0; width: 70px; height: 6px; background: linear-gradient(90deg, var(--elite-accent), var(--elite-secondary)); border-radius: 10px;"></div>
        </div>
        <a href="{{ path('app_patient_workspace_rdv_new') }}" class="btn-elite-primary shadow-lg" style="padding: 1.1rem 2.2rem; border-radius: 20px;">
            <i class="fa-solid fa-calendar-plus me-2"></i> RÉSERVER UNE SÉANCE
        </a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : 'info')) }} border-0 shadow-sm mb-5 elite-glass-card" style="padding: 1.5rem; border-radius: 24px;">
                <i class="fa-solid fa-circle-check me-2" style="color: var(--elite-accent);"></i> {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="patient-workspace-card">
        {% for appointment in appointments %}
            <div class="rdv-elite-item">
                <div class="d-flex align-items-center gap-4">
                    <div class="date-box-elite">
                        <div class="month">{{ appointment.dateRdv|date('M') }}</div>
                        <div class="day">{{ appointment.dateRdv|date('d') }}</div>
                    </div>
                    <div class="rdv-info-group">
                        <h5>{{ appointment.motif }}</h5>
                        <p>
                            <i class="fa-regular fa-clock me-2"></i> {{ appointment.heureRdv|date('H:i') }} • 
                            <span class="fw-bold" style="color: var(--elite-accent);">{{ appointment.typeRdv }}</span> • 
                            {% if appointment.professionalName %}
                                <span class="fw-bold" style="color: var(--elite-navy);"><i class="fa-solid fa-user-md ms-2 me-1"></i> {{ appointment.professionalName }}</span> •
                            {% endif %}
                            <span class="opacity-50">Ref: #{{ appointment.id }}</span>
                        </p>
                    </div>
                </div>
                
                <div class="d-flex align-items-center gap-5">
                    <span class="status-pill-elite status-{{ appointment.statut|lower|replace({' ': '-'}) }}">
                        {{ appointment.statut }}
                    </span>
                    
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_patient_workspace_rdv_edit', {id: appointment.id}) }}" class="action-circle-btn btn-edit" title="Ajuster">
                            <i class="fa-solid fa-sliders"></i>
                        </a>
                        
                        <form method="post" action="{{ path('app_patient_workspace_rdv_delete', {id: appointment.id}) }}" onsubmit="return confirm('Souhaitez-vous annuler définitivement cette séance ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
                            <button type="submit" class="action-circle-btn btn-delete" title="Supprimer">
                                <i class="fa-solid fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center py-5 my-5 elite-glass-card" style="border-radius: 40px; padding: 60px;">
                <div class="mb-4" style="position: relative; display: inline-block;">
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 140px; height: 140px; background: var(--elite-accent); opacity: 0.1; filter: blur(40px); border-radius: 50%;"></div>
                    <i class="fa-solid fa-calendar-days" style="font-size: 6rem; background: linear-gradient(135deg, var(--elite-navy), var(--elite-accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; position: relative;"></i>
                </div>
                <h2 class="fw-bold mt-4" style="color: var(--elite-navy); letter-spacing: -1px;">Votre agenda est libre</h2>
                <p class="text-muted mb-5 mx-auto" style="max-width: 500px; font-size: 1.1rem; line-height: 1.6;">Nous sommes là pour vous accompagner. Prenez un moment pour planifier votre prochaine séance de bien-être avec nos experts.</p>
                <a href="{{ path('app_patient_workspace_rdv_new') }}" class="btn-elite-primary shadow-lg" style="padding: 1.2rem 2.8rem; font-size: 1.1rem; border-radius: 20px;">
                    <i class="fa-solid fa-plus-circle me-2"></i> RÉSERVER MA PREMIÈRE SÉANCE
                </a>
            </div>
        {% endfor %}
    </div>
</div>
</div>
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
