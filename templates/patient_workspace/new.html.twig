{% extends 'base.html.twig' %}

{% block title %}Prendre Rendez-vous — Evolia Elite{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles.css') }}">
    <link rel="stylesheet" href="{{ asset('elite_theme.css') }}">
    <link rel="stylesheet" href="{{ asset('user_dashboard.css') }}">
    <style>
        /* SCROLL FIX */
        body.user-theme {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            overflow: hidden !important;
            background: #f1f5f9 !important;
        }
        .user-scope {
            display: flex !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .user-main-content {
            flex-grow: 1 !important;
            width: calc(100vw - 280px) !important;
            max-width: none !important;
            overflow-y: auto !important;
            padding: 0 !important;
            background: #f1f5f9 !important;
        }
        .form-centered-container {
            min-height: 85vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background: radial-gradient(circle at top right, rgba(56, 189, 248, 0.05), transparent),
                        radial-gradient(circle at bottom left, rgba(129, 140, 248, 0.05), transparent);
        }
        
        .elite-form-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            border-radius: 40px;
            padding: 4rem;
            width: 100%;
            max-width: 850px;
            box-shadow: 0 50px 100px rgba(15, 23, 42, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.5);
            animation: cardFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        @keyframes cardFadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .form-header {
            margin-bottom: 4rem;
            text-align: center;
        }
        .form-header h1 {
            color: var(--elite-navy);
            font-weight: 900;
            font-size: 3rem;
            letter-spacing: -2px;
            margin-bottom: 1rem;
        }
        .form-header p {
            color: var(--elite-accent);
            text-transform: uppercase;
            letter-spacing: 0.2em;
            font-weight: 800;
            font-size: 0.8rem;
            opacity: 0.8;
        }
    </style>
{% endblock %}

{% block body %}
<div class="user-scope">
{% include 'user_nav_bar/index.html.twig' %}
<div class="user-main-content">
    <div class="form-centered-container">
        <div class="elite-form-card">
            <div class="form-header">
                <p>Étape de réservation • Session de Bien-être</p>
                <h1>Nouveau Rendez-vous</h1>
                <div class="mx-auto" style="width: 60px; height: 6px; background: linear-gradient(90deg, var(--elite-accent), var(--elite-secondary)); border-radius: 10px; margin-top: 1.5rem;"></div>
            </div>

            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row g-5">
                    <div class="col-md-7 elite-form-group">
                        <label class="elite-label"><i class="fa-solid fa-calendar-day me-2"></i>Date souhaitée</label>
                        {{ form_widget(form.dateRdv, {'attr': {'class': 'elite-input'}}) }}
                        <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.dateRdv) }}</div>
                    </div>
                    <div class="col-md-5 elite-form-group">
                        <label class="elite-label"><i class="fa-solid fa-clock me-2"></i>Heure</label>
                        {{ form_widget(form.heureRdv, {'attr': {'class': 'elite-input'}}) }}
                        <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.heureRdv) }}</div>
                    </div>
                    <div class="col-12 elite-form-group">
                        <label class="elite-label"><i class="fa-solid fa-user-md me-2"></i>Choisir votre Spécialiste (Psychologue/Coach)</label>
                        {{ form_widget(form.professionalId, {'attr': {'class': 'elite-select'}}) }}
                        <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.professionalId) }}</div>
                    </div>
                    <div class="col-12 elite-form-group">
                        <label class="elite-label"><i class="fa-solid fa-laptop-medical me-2"></i>Type de consultation</label>
                        {{ form_widget(form.typeRdv, {'attr': {'class': 'elite-select'}}) }}
                        <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.typeRdv) }}</div>
                    </div>
                    <div class="col-12 elite-form-group">
                        <label class="elite-label"><i class="fa-solid fa-comment-dots me-2"></i>Motif de la visite</label>
                        {{ form_widget(form.motif, {'attr': {'class': 'elite-textarea', 'rows': 4, 'placeholder': 'Décrivez brièvement l\'objet de votre consultation...'}}) }}
                        <div class="text-danger small mt-1 fw-bold">{{ form_errors(form.motif) }}</div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-md-row gap-4 mt-5">
                    <button type="submit" class="btn-elite-primary flex-grow-1" style="font-size: 1rem; border-radius: 20px;">
                        <i class="fa-solid fa-calendar-check me-2"></i> CONFIRMER LA RÉSERVATION
                    </button>
                    <a href="{{ path('app_patient_workspace') }}" class="btn-elite-primary flex-grow-1 text-center" style="background: rgba(15, 23, 42, 0.05); color: var(--elite-navy); box-shadow: none; border-radius: 20px;">
                        RETOUR
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
</div>
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
