{% extends 'base.html.twig' %}

{% block title %}{{ objectif.titre }} — Evolia{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/user_dashboard.css">
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<style>
    :root {
        --primary: #1a3a2e;
        --primary-dark: #2d6a4f;
        --success: #22c55e;
        --warning: #f59e0b;
        --danger: #ef4444;
        --bg: #f1f5f9;
        --bg-card: #ffffff;
        --border: #e2e8f0;
        --text: #1a3a2e;
        --text-muted: #64748b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; min-height: 100vh; overflow-x: hidden; }
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    .user-scope { display: flex; min-height: 100vh; }

    .page-header { background: linear-gradient(135deg, #1a3a2e 0%, #2d6a4f 100%); padding: 2.5rem 3rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; color: #fff; }
    .page-header-left { display: flex; align-items: center; gap: 1.2rem; }
    .page-header h1 { font-size: 1.7rem; font-weight: 700; color: #fff; }
    .back-link { color: rgba(255, 255, 255, 0.7); text-decoration: none; font-size: 0.9rem; font-weight: 500; }
    .back-link:hover { color: #fff; }
    .back-link:hover { color:var(--primary); }

    .badge { padding: 0.4rem 0.9rem; border-radius: 30px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-en_cours   { background: #edf7f2; color: #2d6a4f; }
    .badge-termine    { background: #e8f5ed; color: #22c55e; }
    .badge-abandonne  { background: #fff0f0; color: #d63031; }

    .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.4rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; cursor: pointer; border: none; text-decoration: none; transition: all 0.3s; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(26, 58, 46, 0.2); }
    .btn-white { background: #fff; color: var(--primary); }
    .btn-white:hover { background: #f8f9fa; transform: translateY(-2px); }
    .btn-danger { background: #fff0f0; color: var(--danger); border: 1px solid #ffcccc; }
    .btn-danger:hover { background: var(--danger); color: #fff; }
    .btn-outline { background: #fff; color: var(--text-muted); border: 1px solid var(--border); }
    .btn-outline:hover { border-color: var(--primary); color: var(--primary); }
    .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.8rem; }

    .container { max-width:900px; margin:2.5rem auto; padding:0 1.5rem; }

    .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:2rem; }
    .info-card { background:var(--bg-card); border:1px solid var(--border); border-radius:14px; padding:1.5rem; }
    .info-card h3 { font-size:0.8rem; font-weight:500; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; margin-bottom:1rem; }
    .info-row { display:flex; justify-content:space-between; align-items:center; padding:0.6rem 0; border-bottom:1px solid var(--border); }
    .info-row:last-child { border-bottom:none; }
    .info-label { font-size:0.85rem; color:var(--text-muted); }
    .info-value { font-size:0.9rem; font-weight:500; color:var(--text); }

    .desc-card { background:var(--bg-card); border:1px solid var(--border); border-radius:14px; padding:1.5rem; margin-bottom:2rem; }
    .desc-card h3 { font-size:0.8rem; font-weight:500; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; margin-bottom:0.8rem; }
    .desc-card p { color:var(--text-muted); font-size:0.9rem; line-height:1.7; }

    .progress-section { background:var(--bg-card); border:1px solid var(--border); border-radius:14px; padding:1.5rem; margin-bottom:2rem; }
    .progress-section h3 { font-size:0.8rem; font-weight:500; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; margin-bottom:1rem; }
    .progress-label { display:flex; justify-content:space-between; font-size:0.85rem; color:var(--text-muted); margin-bottom:0.5rem; }
    .progress-bar-bg { height:10px; background:var(--border); border-radius:99px; overflow:hidden; }
    .progress-bar-fill { height:100%; border-radius:99px; background:linear-gradient(90deg,#6c63ff,#a78bfa); transition:width 0.8s ease; }

    /* Exercices list */
    .section-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem; }
    .section-header h2 { font-size:1.1rem; font-weight:600; }
    .exercice-list { display:grid; gap:1rem; }
    .exercice-item {
        background:var(--bg-card); border:1px solid var(--border); border-radius:12px;
        padding:1.2rem 1.5rem; display:flex; align-items:center; justify-content:space-between;
        transition:all 0.2s; gap:1rem;
    }
    .exercice-item:hover { border-color:var(--primary); transform:translateX(4px); }
    .exercice-info h4 { font-size:0.95rem; font-weight:600; margin-bottom:0.3rem; }
    .exercice-meta { display:flex; gap:0.8rem; font-size:0.78rem; color:var(--text-muted); flex-wrap:wrap; }
    .exercice-actions { display:flex; gap:0.5rem; flex-shrink:0; }

    .diff-badge { padding:0.2rem 0.5rem; border-radius:6px; font-size:0.72rem; font-weight:500; }
    .diff-facile   { background:rgba(34,197,94,.2);  color:#4ade80; }
    .diff-moyen    { background:rgba(245,158,11,.2); color:#fbbf24; }
    .diff-difficile { background:rgba(239,68,68,.2); color:#f87171; }

    .empty-state { text-align:center; padding:3rem; color:var(--text-muted); background:var(--bg-card); border:1px dashed var(--border); border-radius:14px; }
    .alert { padding:0.9rem 1.2rem; border-radius:10px; margin-bottom:1.5rem; display:flex; align-items:center; gap:0.6rem; font-size:0.9rem; }
    .alert-success { background:rgba(34,197,94,.12); border:1px solid rgba(34,197,94,.3); color:#4ade80; }
</style>
{% endblock %}

{% block body %}
<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}

    <div class="user-main-content">
        <div class="page-header">
            <div class="page-header-left">
                <a href="{{ path('app_user_objectif_index') }}" class="back-link">
                    <i class="fa-solid fa-arrow-left"></i> Retour aux objectifs
                </a>
                <h1>{{ objectif.titre }}</h1>
                <span class="badge badge-{{ objectif.statut }}">
                    {% if objectif.statut == 'en_cours' %}🔵 En cours
                    {% elseif objectif.statut == 'termine' %}✅ Terminé
                    {% else %}❌ Abandonné{% endif %}
                </span>
            </div>
            <div style="display:flex;gap:1rem;">
                <a href="{{ path('app_user_objectif_edit', {id: objectif.id}) }}" class="btn btn-white">✏️ Modifier</a>
                <form method="post" action="{{ path('app_user_objectif_delete', {id: objectif.id}) }}" onsubmit="return confirm('Supprimer cet objectif et tous ses exercices ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ objectif.id) }}">
                    <button type="submit" class="btn btn-danger">🗑 Supprimer</button>
                </form>
            </div>
        </div>

<div class="container">
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success">✅ {{ msg }}</div>
    {% endfor %}

    {# Infos #}
    <div class="detail-grid">
        <div class="info-card">
            <h3>📋 Informations</h3>
            <div class="info-row">
                <span class="info-label">Date de début</span>
                <span class="info-value">{{ objectif.dateDebut|date('d/m/Y') }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Date de fin</span>
                <span class="info-value">{{ objectif.dateFin ? objectif.dateFin|date('d/m/Y') : 'Non définie' }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Statut</span>
                <span class="badge badge-{{ objectif.statut }}">{{ objectif.statut|replace({'_': ' '})|capitalize }}</span>
            </div>
        </div>
        <div class="info-card">
            <h3>📊 Statistiques</h3>
            <div class="info-row">
                <span class="info-label">Nb exercices</span>
                <span class="info-value" style="color:#a78bfa;">{{ objectif.exercices|length }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Durée totale</span>
                <span class="info-value">
                    {{ objectif.exercices|reduce((carry, e) => carry + e.duree, 0) }} min
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Calories totales</span>
                <span class="info-value" style="color:#fb923c;">
                    {{ objectif.exercices|reduce((carry, e) => carry + (e.calories ?? 0), 0) }} kcal
                </span>
            </div>
        </div>
    </div>

    {% if objectif.description %}
    <div class="desc-card">
        <h3>📝 Description</h3>
        <p>{{ objectif.description }}</p>
    </div>
    {% endif %}

    {% if objectif.dateFin %}
    {% set progres = objectif.dateFin and objectif.dateDebut
        ? max(0, min(100, (date()|date('U') - objectif.dateDebut|date('U')) * 100 // ((objectif.dateFin|date('U') - objectif.dateDebut|date('U')) ?: 1)))
        : 0 %}
    <div class="progress-section">
        <h3>⏳ Progression temporelle</h3>
        <div class="progress-label"><span>Début</span><span>{{ progres }}%</span><span>Fin</span></div>
        <div class="progress-bar-bg"><div class="progress-bar-fill" style="width:{{ progres }}%"></div></div>
    </div>
    {% endif %}

    {# Exercices #}
    <div class="section-header">
        <h2>🏋️ Exercices ({{ objectif.exercices|length }})</h2>
        <a href="{{ path('app_user_exercice_new', {objectif_id: objectif.id}) }}" class="btn btn-success btn-sm">＋ Ajouter un exercice</a>
    </div>

    {% if objectif.exercices is empty %}
        <div class="empty-state">
            <p>Aucun exercice pour cet objectif.</p><br>
            <a href="{{ path('app_user_exercice_new', {objectif_id: objectif.id}) }}" class="btn btn-primary">＋ Ajouter le premier exercice</a>
        </div>
    {% else %}
        <div class="exercice-list">
            {% for exercice in objectif.exercices %}
                <div class="exercice-item">
                    <div class="exercice-info">
                        <h4>{{ exercice.titre }}</h4>
                        <div class="exercice-meta">
                            <span>📅 {{ exercice.date|date('d/m/Y') }}</span>
                            <span>⏱ {{ exercice.duree }} min</span>
                            <span>🔥 {{ exercice.calories ?? 0 }} kcal</span>
                            <span class="diff-badge diff-{{ exercice.difficulte }}">{{ exercice.difficulte|capitalize }}</span>
                            <span style="text-transform:capitalize;">{{ exercice.type|replace({'_': ' '}) }}</span>
                        </div>
                    </div>
                    <div class="exercice-actions">
                        <a href="{{ path('app_user_exercice_show', {id: exercice.id}) }}" class="btn btn-outline btn-sm">👁</a>
                        <a href="{{ path('app_user_exercice_edit', {id: exercice.id}) }}" class="btn btn-primary btn-sm">✏️</a>
                        <form method="post" action="{{ path('app_user_exercice_delete', {id: exercice.id}) }}" onsubmit="return confirm('Supprimer cet exercice ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exercice.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">🗑</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
    </div>
</div>
{% endblock %}
