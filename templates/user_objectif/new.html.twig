{% extends 'base.html.twig' %}

{% block title %}Nouvel Objectif — Evolia{% endblock %}

{% block body_class %}user-theme{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/user_dashboard.css">
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<style>
    :root {
        --primary: #1a3a2e;
        --primary-dark: #2d6a4f;
        --bg: #f1f5f9;
        --bg-card: #ffffff;
        --border: #e2e8f0;
        --text: #1a3a2e;
        --text-muted: #64748b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; min-height: 100vh; overflow-x: hidden; }
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    .user-scope { display: flex; min-height: 100vh; }

    .page-header { background: linear-gradient(135deg, #1a3a2e 0%, #2d6a4f 100%); padding: 2.5rem 3rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 1rem; color: #fff; }
    .page-header h1 { font-size: 1.6rem; font-weight: 700; color: #fff; }
    .back-link { color: rgba(255, 255, 255, 0.7); text-decoration: none; font-size: 0.9rem; display: flex; align-items: center; gap: 0.4rem; transition: color 0.2s; }
    .back-link:hover { color: #fff; }

    .container { max-width:640px; margin:3rem auto; padding:0 1.5rem; }
    .form-card { background:var(--bg-card); border:1px solid var(--border); border-radius:20px; padding:2.5rem; }
    .form-card h2 { font-size:1.2rem; font-weight:600; margin-bottom:2rem; color:var(--text); }

    .form-group { margin-bottom:1.4rem; }
    .form-group label { display:block; font-size:0.85rem; font-weight:500; color:var(--text-muted); margin-bottom:0.5rem; }
    .form-control, .form-select {
        width: 100%; background: #fff; border: 1px solid var(--border); border-radius: 12px;
        padding: 0.8rem 1.2rem; color: var(--text); font-size: 0.95rem; outline: none;
        font-family: 'Inter', sans-serif; transition: all 0.3s;
    }
    .form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(26, 58, 46, 0.05); }
    textarea.form-control { resize:vertical; }
    .form-select option { background:#1a1929; }

    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1.2rem; }

    .btn { display:inline-flex; align-items:center; gap:0.4rem; padding:0.7rem 1.6rem; border-radius:10px; font-size:0.9rem; font-weight:500; cursor:pointer; border:none; text-decoration:none; transition:all 0.2s; }
    .btn-primary { background:var(--primary); color:#fff; width:100%; justify-content:center; }
    .btn-primary:hover { background:var(--primary-dark); box-shadow:0 4px 12px rgba(108,99,255,.4); }
    .btn-outline { background:transparent; color:var(--text-muted); border:1px solid var(--border); }
    .btn-outline:hover { border-color:var(--primary); color:var(--primary); }

    .form-actions { display:flex; gap:1rem; margin-top:2rem; }
    .form-actions .btn-primary { flex:1; }

    .invalid-feedback { color:#f87171; font-size:0.78rem; margin-top:0.3rem; display:block; }
    .is-invalid { border-color:#ef4444 !important; }
</style>
{% endblock %}

{% block body %}
<div class="user-scope">
    {% include 'user_nav_bar/index.html.twig' %}

    <div class="user-main-content">
        <div class="page-header">
            <a href="{{ path('app_user_objectif_index') }}" class="back-link">
                <i class="fa-solid fa-arrow-left"></i> Retour
            </a>
            <h1>🎯 Nouvel Objectif</h1>
        </div>

<div class="container">
    <div class="form-card">
        <h2>Créer un nouvel objectif</h2>
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

            <div class="form-group">
                {{ form_label(form.titre) }}
                {{ form_widget(form.titre) }}
                {{ form_errors(form.titre) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.dateDebut) }}
                    {{ form_widget(form.dateDebut) }}
                    {{ form_errors(form.dateDebut) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.dateFin) }}
                    {{ form_widget(form.dateFin) }}
                    {{ form_errors(form.dateFin) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.statut) }}
                {{ form_widget(form.statut) }}
                {{ form_errors(form.statut) }}
            </div>

            <div class="form-actions">
                <a href="{{ path('app_user_objectif_index') }}" class="btn btn-outline">Annuler</a>
                <button type="submit" class="btn btn-primary">✅ Créer l'objectif</button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
    </div>
</div>
{% endblock %}
